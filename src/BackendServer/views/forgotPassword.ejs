<div class="row justify-content-center mt-5">
  <div class="col-md-6">
    <div class="glass-card p-5">
      <h2 class="text-center mb-4">Forgot Password</h2>
      <p class="text-center text-dim mb-4">Enter your email address and we'll send you a link to reset your password.</p>
      
      <form action="/forgot-password" method="POST">
        <div class="form-group mb-4">
          <label for="email" class="text-dim">Email Address</label>
          <div class="input-group">
            <div class="input-group-prepend">
              <span class="input-group-text bg-transparent border-right-0" style="border-color: var(--glass-border); color: var(--primary);">
                <i class="fas fa-envelope"></i>
              </span>
            </div>
            <input type="email" class="form-control border-left-0" id="email" name="email" required 
                   style="background: rgba(255,255,255,0.05); border-color: var(--glass-border); color: var(--text-main);"
                   placeholder="Enter your registered email">
          </div>
        </div>

        <button type="submit" class="btn-snoop btn-block py-3">Send Reset Link</button>
      </form>
      
      <div class="text-center mt-4">
        <a href="/student/login" class="text-dim small">Back to Login</a>
      </div>
    </div>
  </div>
</div>
