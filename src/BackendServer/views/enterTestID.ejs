<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Document</title>
</head>

<body>

  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="glass-card">
        <div class="text-center mb-4">
          <i class="fas fa-plus-circle fa-3x mb-3" style="color: var(--primary);"></i>
          <h2 class="font-weight-bold">Initialize New Test</h2>
          <p class="text-dim">Configure the core details of your examination.</p>
        </div>

        <form action="/teacher/takeTestID" method="POST">
          <div class="form-group">
            <label><i class="fas fa-fingerprint mr-2"></i>Unique Test ID</label>
            <input name="testID" type="text" class="form-control" placeholder="E.g., MIDTERM_CS101" required>
          </div>

          <div class="row">
            <div class="col-md-6 form-group">
              <label><i class="fas fa-clock mr-2"></i>Start Time (Hour)</label>
              <input name="startTime" type="number" class="form-control" placeholder="E.g., 10" required min="0"
                max="23">
            </div>
            <div class="col-md-6 form-group">
              <label><i class="fas fa-hourglass-half mr-2"></i>Duration (Mins)</label>
              <input name="testDuration" type="number" class="form-control" placeholder="E.g., 60" required>
            </div>
          </div>

          <div class="form-group mb-4">
            <label><i class="fas fa-exclamation-triangle mr-2"></i>Warning Threshold</label>
            <input name="warningThreshold" type="number" class="form-control" placeholder="Warnings before lockout"
              required>
          </div>

          <button type="submit" class="btn-snoop w-100 justify-content-center">
            Proceed to Questions <i class="fas fa-arrow-right"></i>
          </button>
        </form>
      </div>
    </div>
  </div>

