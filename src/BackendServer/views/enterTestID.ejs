<div class="row justify-content-center" style="margin-top: 5px;">
  <div class="col-md-6">
    <div class="glass-card">
      <div class="text-center mb-4">
        <i class="fas fa-plus-circle fa-3x mb-3" style="color: var(--primary);"></i>
        <h2 class="font-weight-bold">Initialize New Test</h2>
        <p class="text-dim">Configure the core details of your examination.</p>
      </div>

      <form action="/teacher/takeTestID" method="POST">
        <div class="form-group">
          <label><i class="fas fa-fingerprint mr-2"></i>Unique Test ID</label>
          <input name="testID" type="text" class="form-control" placeholder="E.g., MIDTERM_CS101" required>
        </div>

        <div class="form-group">
          <label><i class="fas fa-key mr-2"></i>Access Code (Password)</label>
          <input name="accessCode" type="password" class="form-control" placeholder="E.g., SECRET123" required>
        </div>

        <div class="row">
          <div class="col-md-6 form-group">
            <label><i class="fas fa-clock mr-2"></i>Start Date & Time</label>
            <input name="startTime" type="datetime-local" class="form-control" required>
          </div>
          <div class="col-md-6 form-group">
            <label><i class="fas fa-history mr-2"></i>End Date & Time</label>
            <input name="endTime" type="datetime-local" class="form-control" required>
          </div>
        </div>

        <div class="form-group">
          <label><i class="fas fa-hourglass-half mr-2"></i>Test Duration (Mins)</label>
          <input name="testDuration" type="number" class="form-control" placeholder="Time allowed once started (e.g., 60)" required>
        </div>

        <div class="form-group mb-4">
          <label><i class="fas fa-exclamation-triangle mr-2"></i>Warning Threshold</label>
          <input name="warningThreshold" type="number" class="form-control" placeholder="Warnings before lockout"
            required>
        </div>

        <div class="form-group mb-4">
          <label><i class="fas fa-check-double mr-2"></i>Passing Marks</label>
          <input name="passingMarks" type="number" class="form-control" placeholder="Minimum marks to pass (e.g., 40)" min="0" required>
          <small class="text-dim">Students scoring at or above this will be marked as PASS.</small>
        </div>

        <button type="submit" class="btn-snoop w-100 justify-content-center">
          Proceed to Questions <i class="fas fa-arrow-right ml-2"></i>
        </button>
      </form>
    </div>
  </div>
</div>