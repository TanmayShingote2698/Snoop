  <div class="text-center mb-5">
    <h2 class="font-weight-bold">Test ID: <span style="color: var(--primary);">
        <%= testIDfromNode %>
      </span></h2>
    <p class="text-dim">Add questions to your assessment session.</p>
  </div>

  <div class="glass-card mb-5">
    <div id="selector" class="text-center p-4">
      <h4 class="mb-4">Select Question Type</h4>
      <div class="d-flex justify-content-center gap-3 flex-wrap">
        <button class="btn-snoop mr-3" id="mcq">
          <i class="fas fa-list-check mr-2"></i> MCQ
        </button>
        <button class="btn-snoop mr-3" id="subjective">
          <i class="fas fa-align-left mr-2"></i> Subjective
        </button>
        <button class="btn-snoop mr-3" id="bulk">
          <i class="fas fa-file-upload mr-2"></i> Bulk Upload
        </button>
        <button class="btn-snoop" id="aiGen" style="background: linear-gradient(135deg, #ff00ff 0%, #8b008b 100%);">
          <i class="fas fa-wand-magic-sparkles mr-2"></i> AI Generate
        </button>
      </div>

      <!-- Bulk Upload Form -->
      <div id="bulkform" style="display: none" class="mt-4 text-left">
        <div class="alert alert-info" style="background: rgba(0, 123, 255, 0.1); border-color: rgba(0, 123, 255, 0.2); color: #9ec5fe;">
          <h5 class="alert-heading"><i class="fas fa-info-circle mr-2"></i>Instructions for Bulk Upload</h5>
          <p class="mb-2">Upload an Excel (.xlsx) or CSV file with the following columns (headers are required):</p>
          <ul class="small mb-3">
            <li><strong>type</strong>: 'mcq' or 'subjective' (required)</li>
            <li><strong>question</strong>: The question text (required)</li>
            <li><strong>op1, op2, op3, op4</strong>: Options for MCQ (required for type 'mcq')</li>
            <li><strong>answer</strong>: Correct option number (1-4) for MCQ (required for type 'mcq')</li>
          </ul>
          <p class="mb-0 small"><em>Note: Subjective questions only need 'type' and 'question' columns.</em></p>
          <div class="mt-3">
            <a href="/sample_questions.csv" download class="btn-snoop btn-sm" style="background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.2);">
              <i class="fas fa-download mr-2"></i> Download Sample CSV
            </a>
          </div>
        </div>

        <form action="/teacher/uploadQuestions" method="POST" enctype="multipart/form-data">
          <input type="hidden" name="testID" value="<%= testIDfromNode %>">
          <div class="form-group">
             <label>Select File (CSV or Excel)</label>
             <div class="custom-file">
               <input type="file" class="custom-file-input" name="file" id="customFile" required accept=".csv, .xlsx, .xls">
               <label class="custom-file-label" for="customFile" style="background: rgba(10, 10, 10, 0.8); color: var(--text-dim); border-color: var(--glass-border);">Choose file</label>
             </div>
          </div>
          <button type="submit" class="btn-snoop mt-3">
            Upload Questions <i class="fas fa-cloud-upload-alt ml-2"></i>
          </button>
        </form>
      </div>

      <!-- MCQ Form -->
      <form id="mcqform" style="display: none" action="/teacher/submitQues" method="POST" class="mt-4 text-left">
        <input type="hidden" name="testID" value="<%= testIDfromNode %>">
        <div class="form-group">
          <label>Question Statement</label>
          <input required type="text" class="form-control" name="question" placeholder="Enter MCQ question">
        </div>
        <div class="row">
          <div class="col-md-6 form-group"><label>Option 1</label><input required type="text" class="form-control"
              name="op1" placeholder="Option 1"></div>
          <div class="col-md-6 form-group"><label>Option 2</label><input required type="text" class="form-control"
              name="op2" placeholder="Option 2"></div>
          <div class="col-md-6 form-group"><label>Option 3</label><input required type="text" class="form-control"
              name="op3" placeholder="Option 3"></div>
          <div class="col-md-6 form-group"><label>Option 4</label><input required type="text" class="form-control"
              name="op4" placeholder="Option 4"></div>
        </div>
        <div class="form-group w-50">
          <label>Correct Option Number (1-4)</label>
          <input required type="number" class="form-control" name="answer" min="1" max="4">
        </div>
        <button type="submit" class="btn-snoop mt-3">
          Submit MCQ Question <i class="fas fa-plus ml-2"></i>
        </button>
      </form>

      <!-- Subjective Form -->
      <form id="subform" style="display: none" action="/teacher/submitQues" method="POST" class="mt-4 text-left">
        <input type="hidden" name="testID" value="<%= testIDfromNode %>">
        <div class="form-group">
          <label>Subjective Question Statement</label>
          <textarea class="form-control" name="question" rows="3" placeholder="Enter subjective question"></textarea>
        </div>
        <button type="submit" class="btn-snoop mt-3">
          Submit Subjective Question <i class="fas fa-plus ml-2"></i>
        </button>
      </form>

      <!-- AI Generation Form -->
      <form id="aiform" style="display: none" class="mt-4 text-left">
        <div class="form-group">
          <label><i class="fas fa-book mr-2"></i>Subject</label>
          <input type="text" class="form-control" id="aiSubject" placeholder="E.g., Mathematics, Physics" required>
        </div>

        <div class="form-group">
          <label><i class="fas fa-list-ul mr-2"></i>Topic</label>
          <input type="text" class="form-control" id="aiTopic" placeholder="E.g., Algebra, Dynamics" required>
        </div>

        <div class="row">
          <div class="col-md-6 form-group">
            <label><i class="fas fa-plus-circle mr-2"></i>Number of Questions</label>
            <input type="number" class="form-control form-control-lg" id="aiNumberOfQuestions" placeholder="E.g., 5, 10, 20" required min="1" max="50">
          </div>
          <div class="col-md-6 form-group">
            <label><i class="fas fa-signal mr-2"></i>Difficulty</label>
            <select class="form-control form-control-lg" id="aiDifficulty" required>
              <option value="">-- Select Difficulty --</option>
              <option value="Easy">Easy</option>
              <option value="Medium" selected>Medium</option>
              <option value="Hard">Hard</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label><i class="fas fa-question-circle mr-2"></i>Question Types</label>
          <div class="custom-control custom-checkbox">
            <input type="checkbox" class="custom-control-input" id="aiMCQ" 
                   name="questionTypes" value="mcq" checked>
            <label class="custom-control-label" for="aiMCQ">Multiple Choice (MCQ)</label>
          </div>
          <div class="custom-control custom-checkbox">
            <input type="checkbox" class="custom-control-input" id="aiSubjective" 
                   name="questionTypes" value="subjective">
            <label class="custom-control-label" for="aiSubjective">Subjective Questions</label>
          </div>
        </div>

        <div class="form-group">
          <label><i class="fas fa-edit mr-2"></i>Additional Instructions (Optional)</label>
          <textarea class="form-control" id="aiInstructions" rows="2" 
                    placeholder="E.g., Focus on recent topics, Include real-world examples"></textarea>
        </div>

        <button type="button" class="btn-snoop mt-3" onclick="generateAIQuestions()">
          <i class="fas fa-magic mr-2"></i> Generate Questions
        </button>
      </form>
    </div>
  </div>



  <div id="arrayToNode"></div>

  <!-- Always Present Questions Container -->
  <div id="added-questions-section" class="glass-card mb-5 p-4" style="display: <%= (locals.questions && questions.length > 0) ? 'block' : 'none' %>;">
    <h4 class="mb-4 border-bottom pb-2"><i class="fas fa-list mr-2"></i> Added Questions (<span class="question-count"><%= (locals.questions && questions.length > 0) ? questions.length : '0' %></span>)</h4>
    <div class="added-questions-list">
      <% if (locals.questions && questions.length > 0) { %>
        <% questions.forEach((q, index)=> { %>
          <div class="p-3 mb-3 rounded question-item"
            style="background: rgba(255,255,255,0.05); border-left: 4px solid var(--primary);">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <div style="flex: 1;">
                <span class="font-weight-bold">Q<%= index + 1 %>: <%= q.question %></span>
              </div>
              <div class="ml-3">
                <span class="badge badge-success mr-2"><%= q.op1 ? 'MCQ' : 'Subjective' %></span>
                <button type="button" class="btn btn-sm btn-danger delete-question-btn" onclick="deleteQuestion(event)" title="Delete this question">
                  <i class="fas fa-trash-alt"></i> Delete
                </button>
              </div>
            </div>
            <% if (q.op1) { %>
              <div class="ml-3 small">
                <p class="mb-1"><strong>A)</strong> <%= q.op1 %></p>
                <p class="mb-1"><strong>B)</strong> <%= q.op2 %></p>
                <p class="mb-1"><strong>C)</strong> <%= q.op3 %></p>
                <p class="mb-1"><strong>D)</strong> <%= q.op4 %></p>
                <p class="mb-0 text-info"><strong>Answer:</strong> <%= q.answer %></p>
              </div>
            <% } %>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>

  <div id="displayques"></div>

  <div class="text-center d-flex justify-content-center gap-3 mt-5 mb-5">
    <button onclick="window.history.back()" class="btn-snoop btn-glass mr-3">
      <i class="fas fa-arrow-left mr-2"></i> Back
    </button>
    <form action="/teacher/showTestAfterCreation" method="POST" class="d-inline">
      <input type="hidden" name="testID" value="<%= testIDfromNode %>">
      <button class="btn-snoop btn-lg px-5 py-3" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%);">
        Finalize Test Management <i class="fas fa-check-double ml-2"></i>
      </button>
    </form>
  </div>
      <script>
        //   document
        //     .getElementById("subform")
        //     .addEventListener("submit", function (e) {
        //       e.preventDefault();
        //     });

        //   document
        //     .getElementById("mcqform")
        //     .addEventListener("submit", function (e) {
        //       e.preventDefault();
        //     });
        document.getElementById("mcq").addEventListener("click", function () {
          //   document.getElementById("enterquestion").innerHTML = `
          //   `;
          document.getElementById("mcqform").style.display = "block";
          document.getElementById("subform").style.display = "none";
          document.getElementById("bulkform").style.display = "none";
          document.getElementById("displayques").style.display = "none";
        });

        document
          .getElementById("subjective")
          .addEventListener("click", function () {
            //   document.getElementById("enterquestion").innerHTML = `
            //   `;
            document.getElementById("subform").style.display = "block";
            document.getElementById("mcqform").style.display = "none";
            document.getElementById("bulkform").style.display = "none";
            document.getElementById("displayques").style.display = "none";
          });

        document.getElementById("bulk").addEventListener("click", function () {
            document.getElementById("bulkform").style.display = "block";
            document.getElementById("mcqform").style.display = "none";
            document.getElementById("subform").style.display = "none";
            document.getElementById("aiform").style.display = "none";
            document.getElementById("displayques").style.display = "none";
        });

        document.getElementById("aiGen").addEventListener("click", function () {
            document.getElementById("aiform").style.display = "block";
            document.getElementById("mcqform").style.display = "none";
            document.getElementById("subform").style.display = "none";
            document.getElementById("bulkform").style.display = "none";
            document.getElementById("displayques").style.display = "none";
        });
        
        // Custom file input label update
        document.querySelector('.custom-file-input').addEventListener('change', function(e) {
            var fileName = document.getElementById("customFile").files[0].name;
            var nextSibling = e.target.nextElementSibling
            nextSibling.innerText = fileName
        });

        async function generateAIQuestions() {
          const subject = document.getElementById('aiSubject').value;
          const topic = document.getElementById('aiTopic').value;
          const numberOfQuestions = document.getElementById('aiNumberOfQuestions').value;
          const difficultyLevel = document.getElementById('aiDifficulty').value;
          const additionalInstructions = document.getElementById('aiInstructions').value;
          
          // Validate all required fields
          if (!subject || subject.trim() === '') {
            alert('Please fill in Subject');
            document.getElementById('aiSubject').focus();
            return;
          }

          if (!topic || topic.trim() === '') {
            alert('Please fill in Topic');
            document.getElementById('aiTopic').focus();
            return;
          }

          if (!numberOfQuestions || numberOfQuestions === '') {
            alert('Please select Number of Questions');
            document.getElementById('aiNumberOfQuestions').focus();
            return;
          }

          if (!difficultyLevel || difficultyLevel === '') {
            alert('Please select Difficulty Level');
            document.getElementById('aiDifficulty').focus();
            return;
          }
          
          const questionTypes = Array.from(document.querySelectorAll('input[name="questionTypes"]:checked'))
            .map(cb => cb.value);

          if (questionTypes.length === 0) {
            alert('Please select at least one question type');
            return;
          }

          // Show loading
          const btn = event.target;
          btn.disabled = true;
          btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Generating...';

          try {
            const response = await fetch('/teacher/generateQuestionsAI', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                testID: '<%= testIDfromNode %>',
                subject,
                topic,
                numberOfQuestions,
                difficultyLevel,
                questionTypes,
                duration: 60,
                additionalInstructions
              })
            });

            // Parse response
            let result;
            const contentType = response.headers.get('content-type');
            
            if (contentType && contentType.includes('application/json')) {
              result = await response.json();
            } else {
              throw new Error('Server returned non-JSON response. Please try again.');
            }

            // Handle authentication errors
            if (response.status === 401 || result.requiresLogin === true) {
              alert('Session expired. Please log in again.');
              window.location.href = '/teacher/login';
              return;
            }

            if (result.success && result.questions && result.questions.length > 0) {
              // Add all generated questions to the display
              console.log(`✅ Generated ${result.questions.length} questions - now saving to database...`);
              
              // DISPLAY ALL QUESTIONS IMMEDIATELY
              let displayDelay = 500;
              result.questions.forEach((q, index) => {
                setTimeout(() => {
                  questions.push(q);
                  displayQuestion(q, questions.length);
                }, displayDelay + (index * 200));
              });

              // Update the question counter
              const finalDelay = displayDelay + (result.questions.length * 200) + 500;
              setTimeout(() => {
                updateQuestionCounter();
              }, finalDelay);
              
              // Scroll to questions section
              setTimeout(() => {
                document.querySelector('.added-questions-list').scrollIntoView({ behavior: 'smooth' });
              }, displayDelay + 100);
              
              // Show success message
              alert(`✅ Successfully generated ${result.questions.length} questions!\n\nReview them below and click Finalize to save.`);
              
              // Reset form and hide after success
              document.getElementById('aiform').reset();
              document.getElementById('aiform').style.display = 'none';
              
              // Auto-save all generated questions to database
              setTimeout(() => {
                saveAllQuestionsToDatabase(result.questions);
              }, finalDelay + 1000);
            } else {
              alert('Error: ' + (result.error || 'Failed to generate questions'));
            }
          } catch (error) {
            alert('Error: ' + error.message);
          } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-magic mr-2"></i> Generate Questions';
          }
        }

        let questions = [];
        
        // ===== GLOBAL HELPER FUNCTIONS FOR AI QUESTION DISPLAY =====
        
        // Display a question in the UI
        function displayQuestion(q, qNum) {
          // Make sure the container section is visible
          const questionSection = document.getElementById('added-questions-section');
          if (questionSection) {
            questionSection.style.display = 'block';
          }
          
          const questionContainer = document.querySelector('.added-questions-list');
          if (!questionContainer) {
            // Fallback: create container if it doesn't exist  
            const newSection = document.createElement('div');
            newSection.id = 'added-questions-section';
            newSection.className = 'glass-card mb-5 p-4';
            newSection.innerHTML = `
              <h4 class="mb-4 border-bottom pb-2"><i class="fas fa-list mr-2"></i> Added Questions (<span class="question-count">0</span>)</h4>
              <div class="added-questions-list"></div>
            `;
            // Insert before displayques div
            const displayQues = document.getElementById('displayques');
            if (displayQues) {
              displayQues.parentNode.insertBefore(newSection, displayQues);
            }
          }
          
          const qDiv = document.createElement('div');
          qDiv.className = 'p-3 mb-3 rounded question-item';
          qDiv.style.cssText = 'background: rgba(255,255,255,0.05); border-left: 4px solid var(--primary);';
          qDiv.setAttribute('data-question-index', qNum - 1);
          
          let qContent = `
            <div class="d-flex justify-content-between align-items-start mb-2">
              <div style="flex: 1;">
                <span class="font-weight-bold">Q${qNum}: ${q.question}</span>
              </div>
              <div class="ml-3">
                <span class="badge badge-success mr-2">${q.type.toUpperCase()}</span>
                <button type="button" class="btn btn-sm btn-danger delete-question-btn" onclick="deleteQuestion(event)" title="Delete this question">
                  <i class="fas fa-trash-alt"></i> Delete
                </button>
              </div>
            </div>
          `;
          
          if (q.type.toLowerCase() === 'mcq') {
            qContent += `
              <div class="ml-3 small">
                <p class="mb-1"><strong>A)</strong> ${q.op1}</p>
                <p class="mb-1"><strong>B)</strong> ${q.op2}</p>
                <p class="mb-1"><strong>C)</strong> ${q.op3}</p>
                <p class="mb-1"><strong>D)</strong> ${q.op4}</p>
                <p class="mb-0 text-info"><strong>Answer:</strong> ${q.answer}</p>
              </div>
            `;
          } else {
            qContent += `
              <p class="ml-3 small text-info mb-0"><strong>Answer:</strong> ${q.answer}</p>
            `;
          }
          
          qDiv.innerHTML = qContent;
          document.querySelector('.added-questions-list').appendChild(qDiv);
        }
        
        // Delete a question
        function deleteQuestion(event) {
          event.preventDefault();
          event.stopPropagation();
          const btn = event.target.closest('.delete-question-btn');
          const questionDiv = btn.closest('.question-item');
          const questionIndex = parseInt(questionDiv.getAttribute('data-question-index'));
          const testID = '<%= testIDfromNode %>';
          
          if (confirm('Are you sure you want to delete this question?')) {
            // Remove from frontend array first
            if (questionIndex >= 0 && questionIndex < questions.length) {
              questions.splice(questionIndex, 1);
              console.log(`🗑️ Removed Q${questionIndex + 1} from frontend array`);
            }
            
            // Send delete request to backend
            fetch('/teacher/deleteQuestion', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
              },
              body: JSON.stringify({
                testID: testID,
                questionIndex: questionIndex
              })
            })
            .then(response => response.json())
            .then(data => {
              if (data.success) {
                console.log(`✅ Question deleted from backend (TestID: ${testID})`);
              } else {
                console.error(`❌ Backend delete failed: ${data.message}`);
              }
            })
            .catch(error => console.error(`❌ Error deleting question: ${error.message}`));
            
            // Remove from DOM with animation
            questionDiv.style.transition = 'all 0.3s ease';
            questionDiv.style.opacity = '0';
            setTimeout(() => {
              questionDiv.remove();
              // Re-number all questions
              renumberQuestions();
              // Update counter
              updateQuestionCounter();
            }, 300);
          }
        }
        
        // Re-number all questions
        function renumberQuestions() {
          const questionItems = document.querySelectorAll('.added-questions-list .question-item');
          questionItems.forEach((item, index) => {
            const qHeader = item.querySelector('.font-weight-bold');
            if (qHeader) {
              const questionText = qHeader.textContent.replace(/^Q\d+:\s/, '');
              qHeader.textContent = `Q${index + 1}: ${questionText}`;
              item.setAttribute('data-question-index', index);
            }
          });
        }
        
        // Update question counter
        function updateQuestionCounter() {
          const allQuestions = document.querySelectorAll('.added-questions-list .question-item');
          const count = allQuestions.length;
          const counterElement = document.querySelector('.question-count');
          if (counterElement) {
            counterElement.textContent = count;
          }
        }
        
        // Save all questions to database
        function saveAllQuestionsToDatabase(questionsToSave) {
          const testID = '<%= testIDfromNode %>';
          let savedCount = 0;
          let failedCount = 0;
          let savePromises = [];
          
          console.log(`💾 DATABASE SAVE IN PROGRESS - TestID: ${testID} | Total: ${questionsToSave.length}`);
          
          // Submit each question one by one with a delay using AJAX (NO page reload!)
          questionsToSave.forEach((q, index) => {
            const savePromise = new Promise((resolve) => {
              setTimeout(() => {
                // Prepare JSON data (NOT FormData - backend has express.json() middleware)
                const questionData = {
                  testID: testID,
                  question: q.question
                };
                
                if (q.type.toLowerCase() === 'mcq') {
                  questionData.op1 = q.op1;
                  questionData.op2 = q.op2;
                  questionData.op3 = q.op3;
                  questionData.op4 = q.op4;
                  questionData.answer = q.answer;
                } else {
                  questionData.answer = q.answer || '';
                }
                
                console.log(`📤 Sending Q${index + 1} to server (TestID: ${testID})`);
                
                // Use fetch API with JSON instead of form.submit() to prevent page reload
                fetch('/teacher/submitQues', {
                  method: 'POST',
                  headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'  // Mark as AJAX request
                  },
                  body: JSON.stringify(questionData)
                })
                  .then(response => {
                    if (response.ok) {
                      return response.json().then(data => {
                        savedCount++;
                        const progressPercent = Math.round((savedCount / questionsToSave.length) * 100);
                        console.log(`✅ Q${savedCount} saved | Progress: ${savedCount}/${questionsToSave.length}`);
                        resolve({ success: true });
                      });
                    } else {
                      failedCount++;
                      console.error(`❌ Q${index + 1} failed - Status: ${response.status}`);
                      resolve({ success: false });
                    }
                  })
                  .catch(error => {
                    failedCount++;
                    console.error(`❌ Error saving Q${index + 1}: ${error.message}`);
                    resolve({ success: false });
                  });
              }, index * 800); // 800ms delay between each submission
            });
            
            savePromises.push(savePromise);
          });
          
          // Log final message after all submissions complete
          Promise.all(savePromises).then(() => {
            console.log(`✅ DATABASE SAVE COMPLETE - Saved: ${savedCount}/${questionsToSave.length} | Failed: ${failedCount}`);
          });
        }
        
        // ===== END GLOBAL HELPERS =====
        
        function submitQuestion(type) {
          let question = {};
          question.type = type;
        }

        document
          .getElementById("submitmcq")
          .addEventListener("click", function () {
            let question = {};
            question.type = "mcq";
            question.question = document.getElementById("mcqquestion").value;
            question.op1 = document.getElementById("op1").value;
            question.op2 = document.getElementById("op2").value;
            question.op3 = document.getElementById("op3").value;
            question.op4 = document.getElementById("op4").value;
            question.ans = document.getElementById("answer").value;
            //   console.log(question.question);
            questions.push(question);
            document.getElementById("mcqform").style.display = "none";
          });

        document
          .getElementById("submitsub")
          .addEventListener("click", function () {
            let question = {};
            question.type = "subjective";
            question.question = document.getElementById("subquestion").value;
            //   console.log(question.question);
            questions.push(question);
            document.getElementById("subform").style.display = "none";
          });

        function displayQuestionsFunction(check) {
          console.log(questions);
          let questionsArr = ``;
          for (let i = 0; i < questions.length; i++) {
            if (questions[i].type === "mcq") {
              questionsArr += `Question ${i + 1}: <br>`;
              questionsArr += questions[i].question;
              questionsArr += `<br>`;
              questionsArr += `Options: <br>`;
              questionsArr += questions[i].op1;
              questionsArr += `<br>`;
              questionsArr += questions[i].op2;
              questionsArr += `<br>`;
              questionsArr += questions[i].op3;
              questionsArr += `<br>`;
              questionsArr += questions[i].op4;
              questionsArr += `<br>`;
              questionsArr += `Answer: <br>`;
              questionsArr += questions[i].ans;
              questionsArr += `<br>`;
            } else {
              questionsArr += `Question: ${i + 1} <br>`;
              questionsArr += questions[i].question;
              questionsArr += `<br>`;
            }
          }
          document.getElementById("displayques").style.display = "block";
          document.getElementById("displayques").innerHTML = questionsArr;
        }

        document
          .getElementById("displayquesbtn")
          .addEventListener("click", displayQuestionsFunction);

        document
          .getElementById("submittest")
          .addEventListener("click", function () {
            document.getElementById("arrayToNode").innerHTML =
              "<% questionsOnNode = " + questions + "%>";
            displayQuestionsFunction();
          });
      </script>
