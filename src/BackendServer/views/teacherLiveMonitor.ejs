<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="font-weight-bold" style="color: var(--text-base);">Live Monitor</h2>
            <p class="text-dim mb-0">Test ID: <strong style="color: var(--primary);"><%= testID %></strong></p>
        </div>
        <div>
            <span class="badge badge-pill badge-primary px-3 py-2 animate-pulse">
                <i class="fas fa-broadcast-tower mr-2"></i> Live Connection Active
            </span>
            <a href="/teacher/showAllTests?filter=ongoing" class="btn-snoop-outline ml-3">
                <i class="fas fa-arrow-left mr-2"></i> Back to Tests
            </a>
        </div>
    </div>

    <style>
        .animate-pulse {
            animation: pulse 2s infinite;
        }
        @keyframes pulse {
            0% { box-shadow: 0 0 0 0 rgba(59, 130, 246, 0.7); }
            70% { box-shadow: 0 0 0 10px rgba(59, 130, 246, 0); }
            100% { box-shadow: 0 0 0 0 rgba(59, 130, 246, 0); }
        }
        .feed-container {
            max-height: 600px;
            overflow-y: auto;
            padding-right: 5px;
        }
        .feed-container::-webkit-scrollbar {
            width: 4px;
        }
        .feed-container::-webkit-scrollbar-thumb {
            background-color: var(--primary);
            border-radius: 10px;
        }
        .feed-item {
            padding: 1rem;
            border-radius: 12px;
            margin-bottom: 0.75rem;
            border-left: 4px solid transparent;
            background: rgba(255, 255, 255, 0.035);
            transition: all 0.3s ease;
            animation: slideIn 0.3s ease-out;
        }
        .feed-item:hover {
            background: rgba(255, 255, 255, 0.07);
        }
        @keyframes slideIn {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .feed-item.join { border-left-color: #3b82f6; }
        .feed-item.submit { border-left-color: #10b981; }
        .feed-item.violation { border-left-color: #ef4444; background: rgba(239, 68, 68, 0.08); }
        .feed-item.ai-alert { border-left-color: #ec4899; background: rgba(236, 72, 153, 0.08); }
        
        /* Student Card Styles */
        .student-card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--glass-border);
            border-radius: 15px;
            padding: 1.25rem;
            margin-bottom: 1rem;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
            cursor: pointer;
        }
        .student-card:hover {
            background: rgba(255, 255, 255, 0.06);
            border-color: var(--primary);
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.2);
        }
        .student-card.active-focus {
            border: 2px solid var(--primary);
            background: rgba(59, 130, 246, 0.1);
            box-shadow: 0 0 15px rgba(59, 130, 246, 0.2);
        }
        .status-indicator {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            display: inline-block;
            margin-right: 8px;
        }
        .status-safe { background: #10b981; box-shadow: 0 0 8px #10b981; }
        .status-warning { background: #f59e0b; box-shadow: 0 0 8px #f59e0b; }
        .status-critical { background: #ef4444; box-shadow: 0 0 8px #ef4444; }
        
        .card-stat {
            font-size: 0.75rem;
            color: var(--text-dim);
            font-weight: 600;
        }
        .card-btn {
            font-size: 0.7rem;
            padding: 4px 10px;
            border-radius: 6px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: bold;
        }
    </style>

    <div class="row">
        <!-- Live Activity Feed -->
        <div class="col-lg-8 mb-4">
            <div class="glass-card d-flex flex-column h-100">
                <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3" style="border-color: var(--glass-border) !important;">
                    <h5 class="font-weight-bold mb-0">
                        <i class="fas fa-stream mr-2 text-primary"></i> <span id="feedTitle">Combined Activity Feed</span>
                    </h5>
                    <button class="btn btn-sm btn-snoop-outline py-1 px-3" id="resetFeedBtn" style="display: none;" onclick="focusStudent(null)">
                        <i class="fas fa-sync-alt mr-1"></i> Show Combined
                    </button>
                </div>
                
                <div class="feed-container flex-grow-1" id="activityFeed">
                    <div class="text-center text-dim my-5" id="emptyFeedState">
                        <i class="fas fa-satellite-dish fa-3x mb-3" style="opacity: 0.5;"></i>
                        <p>Waiting for live activities...</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Active Students Roster & Stats -->
        <div class="col-lg-4 mb-4">
            <div class="glass-card d-flex flex-column" style="max-height: 800px;">
                <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3" style="border-color: var(--glass-border) !important;">
                    <h6 class="font-weight-bold mb-0">
                        <i class="fas fa-users mr-2 text-primary"></i> Students Online
                    </h6>
                    <span class="badge badge-primary px-2" id="activeCountBadge">0</span>
                </div>
                
                <div class="feed-container flex-grow-1 px-1" id="studentRoster">
                    <div class="text-center text-dim my-4" id="emptyStudentsState">
                        <p class="small">No students connected yet.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Include Socket.IO client -->
<script src="/socket.io/socket.io.js"></script>
<script>
    const socket = io();
    const testID = "<%= testID %>";
    
    // Join the teacher monitoring room
    socket.emit('join_test_room', testID);

    // State
    const studentsData = new Map(); // email -> student_object
    let focusedEmail = null;
    let globalViolationsCount = 0;

    // DOM Elements
    const feed = document.getElementById('activityFeed');
    const emptyFeedState = document.getElementById('emptyFeedState');
    const roster = document.getElementById('studentRoster');
    const emptyStudentsState = document.getElementById('emptyStudentsState');
    const activeCountEl = document.getElementById('activeCountBadge');
    const feedTitle = document.getElementById('feedTitle');
    const resetFeedBtn = document.getElementById('resetFeedBtn');

    function createStudentCard(data) {
        const card = document.createElement('div');
        card.id = `card-${data.studentEmail.replace(/[@.]/g, '_')}`;
        card.className = `student-card ${focusedEmail === data.studentEmail ? 'active-focus' : ''}`;
        card.onclick = () => focusStudent(data.studentEmail);

        const statusClass = getStatusClass(data.riskLevel);
        const lastActivity = data.lastActivity || 'No incidents yet';

        card.innerHTML = `
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div class="d-flex align-items-center">
                    <span class="status-indicator status-safe animate-pulse"></span>
                    <strong style="color: var(--text-base); font-size: 0.9rem;" title="${data.studentEmail}">${data.studentEmail.split('@')[0]}</strong>
                </div>
                <span class="badge badge-pill badge-primary card-stat">Score: ${data.cheatScore || 0}</span>
            </div>
            
            <p class="mb-2 text-dim x-small" style="font-size: 0.7rem; line-height: 1.2;">
                <i class="fas fa-history mr-1"></i> ${lastActivity}
            </p>

            <div class="d-flex justify-content-between align-items-center mt-3">
                <span class="card-stat"><i class="fas fa-exclamation-triangle mr-1 text-warning"></i> ${data.violationCount} Violations</span>
                <button class="btn btn-sm btn-primary py-0 px-2 card-btn" style="font-size: 0.6rem;">Focus View</button>
            </div>
        `;
        return card;
    }

    function getStatusClass(level) {
        if (level === 'CRITICAL' || level === 'HIGH') return 'status-critical';
        if (level === 'MEDIUM' || level === 'MODERATE') return 'status-warning';
        return 'status-safe';
    }

    function focusStudent(email) {
        focusedEmail = email;
        
        // Update UI
        if (email) {
            feedTitle.innerText = `Focused Monitor: ${email}`;
            resetFeedBtn.style.display = 'block';
        } else {
            feedTitle.innerText = `Combined Activity Feed`;
            resetFeedBtn.style.display = 'none';
        }

        // Re-render feed and cards
        renderActivityFeed();
        renderRoster();
    }

    function renderRoster() {
        if (studentsData.size > 0) emptyStudentsState.style.display = 'none';
        roster.innerHTML = '';
        
        // Sort: Active/Higher Violations first
        const sorted = [...studentsData.values()].sort((a, b) => b.violationCount - a.violationCount);
        
        sorted.forEach(data => {
            roster.appendChild(createStudentCard(data));
        });
        
        activeCountEl.innerText = studentsData.size;
    }

    function renderActivityFeed() {
        const allItems = [...feed.querySelectorAll('.feed-item')];
        let visibleCount = 0;

        allItems.forEach(item => {
            if (!focusedEmail || item.dataset.email === focusedEmail) {
                item.style.display = 'block';
                visibleCount++;
            } else {
                item.style.display = 'none';
            }
        });

        emptyFeedState.style.display = visibleCount === 0 ? 'block' : 'none';
    }

    function appendFeedItem(data) {
        if(emptyFeedState) emptyFeedState.style.display = 'none';
        
        const item = document.createElement('div');
        const type = data.activityType === 'AI_DETECTION' ? 'ai-alert' : (['FULLSCREEN_EXIT', 'TAB_SWITCH', 'PROHIBITED_KEY'].includes(data.activityType) ? 'violation' : (data.activityType === 'student_joined' ? 'join' : 'submit'));
        
        item.className = `feed-item ${type}`;
        item.dataset.email = data.studentEmail;
        item.style.display = (!focusedEmail || data.studentEmail === focusedEmail) ? 'block' : 'none';
        
        // Define Icon based on type
        let icon = 'fa-info-circle text-primary';
        if(type === 'submit') icon = 'fa-check-circle text-success';
        if(type === 'violation') icon = 'fa-exclamation-triangle text-danger';
        if(type === 'ai-alert') icon = 'fa-eye text-pink';

        let title = data.activityType.replace(/_/g, ' ').title();
        let message = data.details?.message || 'Activity detected';

        // Custom mappings
        if (data.activityType === 'AI_DETECTION') {
            title = `AI ALERT: ${data.anomalyType.replace(/_/g, ' ')}`;
            message = `Confidence level: <b>${(data.confidence * 100).toFixed(0)}%</b>`;
        } else if (data.activityType === 'TAB_SWITCH') {
            title = "External Assistance Risk";
            message = `Student was away for ${data.details.durationSeconds.toFixed(1)}s.`;
        }

        item.innerHTML = `
            <div class="d-flex justify-content-between align-items-start">
                <div class="d-flex">
                    <i class="fas ${icon} mt-1 mr-3 fs-5"></i>
                    <div>
                        <h6 class="font-weight-bold mb-0" style="color: var(--text-base); font-size: 0.9rem;">${title}</h6>
                        <p class="mb-0 text-dim x-small">${data.studentEmail} — <span style="opacity: 0.8;">${message}</span></p>
                    </div>
                </div>
                <span class="badge badge-secondary" style="background: rgba(255,255,255,0.05); font-size: 0.6rem;">${new Date(data.timestamp || Date.now()).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}</span>
            </div>
        `;
        
        feed.insertBefore(item, feed.firstChild);
    }

    String.prototype.title = function() {
        return this.charAt(0).toUpperCase() + this.slice(1).toLowerCase();
    }

    // Socket Listeners
    socket.on('student_joined', (data) => {
        if (!studentsData.has(data.studentEmail)) {
            studentsData.set(data.studentEmail, {
                studentEmail: data.studentEmail,
                violationCount: 0,
                cheatScore: 0,
                riskLevel: 'LOW',
                lastActivity: 'Joined Exam'
            });
            renderRoster();
            appendFeedItem({ ...data, activityType: 'student_joined', timestamp: new Date().toISOString() });
        }
    });

    socket.on('live_activity_update', (data) => {
        // Ensure student exists
        if (!studentsData.has(data.studentEmail)) {
            studentsData.set(data.studentEmail, {
                studentEmail: data.studentEmail,
                violationCount: 0,
                cheatScore: 0,
                riskLevel: 'LOW',
                lastActivity: 'Monitoring Active'
            });
        }

        const student = studentsData.get(data.studentEmail);
        student.violationCount++;
        
        // Update sentiment/last activity
        let activityDesc = data.activityType === 'AI_DETECTION' ? `AI: ${data.anomalyType}` : data.activityType;
        student.lastActivity = activityDesc.replace(/_/g, ' ').title();

        // Simple Score Simulation (in absence of real-time score aggregator)
        if (data.activityType === 'AI_DETECTION') {
            student.cheatScore += 5;
        } else {
            student.cheatScore += 2;
        }
        
        if (student.cheatScore > 50) student.riskLevel = 'CRITICAL';
        else if (student.cheatScore > 25) student.riskLevel = 'MEDIUM';

        renderRoster();
        appendFeedItem(data);
    });

    socket.on('live_submission_update', (data) => {
        const student = studentsData.get(data.studentEmail);
        if (student) {
            student.lastActivity = 'Test Submitted';
            renderRoster();
        }
        appendFeedItem({ ...data, activityType: 'submit', timestamp: new Date().toISOString() });
    });

</script>
