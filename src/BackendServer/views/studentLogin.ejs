<div class="row justify-content-center">
  <div class="col-md-5">
    <div class="glass-card">
      <div class="text-center mb-4">
        <i class="fas fa-user-graduate fa-3x mb-3" style="color: var(--primary);"></i>
        <h2 class="font-weight-bold">Student Login</h2>
        <p class="text-dim">Welcome back! Please login to your account.</p>
      </div>

      <form action="/student/login" method="POST">
        <div class="form-group">
          <label><i class="fas fa-envelope mr-2"></i>Email Address</label>
          <input name="email" type="email" class="form-control" placeholder="name@example.com" required>
          <small class="form-text text-muted">We'll never share your email with anyone else.</small>
        </div>
        <div class="form-group mb-4">
          <label><i class="fas fa-lock mr-2"></i>Password</label>
          <div class="position-relative">
            <input name="password" type="password" class="form-control" placeholder="••••••••" required id="passwordStudentLogin">
            <i class="fas fa-eye position-absolute" 
               style="right: 15px; top: 50%; transform: translateY(-50%); cursor: pointer; color: var(--text-dim);"
               onclick="togglePassword(this, 'passwordStudentLogin')"></i>
          </div>
          <div class="text-right mt-2">
            <a href="/forgot-password" class="small text-dim" style="text-decoration: underline;">Forgot Password?</a>
          </div>
        </div>

        <button type="submit" class="btn-snoop w-100 justify-content-center">
          Sign In <i class="fas fa-arrow-right"></i>
        </button>
      </form>

      <div class="text-center mt-4">
        <p class="small text-dim">Don't have an account?
          <a href="/student/register" style="color: var(--primary); font-weight: 600;">Register Here</a>
        </p>
      </div>
    </div>
  </div>
</div>