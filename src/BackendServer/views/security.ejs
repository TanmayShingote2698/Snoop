<div class="row justify-content-center" style="margin-top: 5px;">
    <div class="col-md-8 col-lg-6">
        <h2 class="mb-4 font-weight-bold" style="color: var(--text-main);">Change Password</h2>
        
        <% if (locals.success) { %>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle mr-2"></i> <%= locals.success %>
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
        <% } %>

        <% if (locals.error) { %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-circle mr-2"></i> <%= locals.error %>
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
        <% } %>

        <div class="glass-card mb-4">
            <p class="text-dim mb-4 mb-md-5">Ensure your account is using a long, random password to stay secure.</p>
            
            <form action="/<%= locals.user.role %>/security" method="POST">
                
                <div class="form-group mb-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <label for="currentPassword" class="font-weight-bold ml-1 mb-2">Current Password <span class="text-danger">*</span></label>
                        <a href="/forgot-password" class="small font-weight-bold" style="color: var(--primary); text-decoration: none;">Forgot Password?</a>
                    </div>
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text bg-white border-right-0" style="border-radius: 0.75rem 0 0 0.75rem; border: 1px solid var(--glass-border); color: var(--text-dim);">
                                <i class="fas fa-lock-open border-0"></i>
                            </span>
                        </div>
                        <input type="password" class="form-control border-left-0 pl-1" id="currentPassword" name="currentPassword" required style="border-radius: 0 0.75rem 0.75rem 0;">
                    </div>
                </div>

                <div class="form-group mb-4">
                    <label for="newPassword" class="font-weight-bold ml-1">New Password <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text bg-white border-right-0" style="border-radius: 0.75rem 0 0 0.75rem; border: 1px solid var(--glass-border); color: var(--text-dim);">
                                <i class="fas fa-key border-0"></i>
                            </span>
                        </div>
                        <input type="password" class="form-control border-left-0 pl-1" id="newPassword" name="newPassword" required style="border-radius: 0 0.75rem 0.75rem 0;">
                    </div>
                </div>

                <div class="form-group mb-4">
                    <label for="confirmPassword" class="font-weight-bold ml-1">Confirm New Password <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text bg-white border-right-0" style="border-radius: 0.75rem 0 0 0.75rem; border: 1px solid var(--glass-border); color: var(--text-dim);">
                                <i class="fas fa-check-double border-0"></i>
                            </span>
                        </div>
                        <input type="password" class="form-control border-left-0 pl-1" id="confirmPassword" name="confirmPassword" required style="border-radius: 0 0.75rem 0.75rem 0;">
                    </div>
                </div>

                <div class="d-flex justify-content-end mt-4">
                    <button type="submit" class="btn-snoop rounded-pill px-5">
                        <i class="fas fa-shield-alt"></i> Update Password
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    // Auto-hide alerts after 5 seconds
    setTimeout(function() {
        var alerts = document.querySelectorAll('.alert');
        alerts.forEach(function(alert) {
            var bsAlert = new bootstrap.Alert(alert);
            bsAlert.close();
        });
    }, 5000);

    // Check URL params for success/error if sent via redirect
    const urlParams = new URLSearchParams(window.location.search);
    const success = urlParams.get('success');
    const errorMsg = urlParams.get('error');
    
    if(success) {
        Swal.fire({
            icon: 'success',
            title: 'Success!',
            text: decodeURIComponent(success),
            toast: true,
            position: 'top-end',
            showConfirmButton: false,
            timer: 3000
        });
        window.history.replaceState({}, document.title, window.location.pathname);
    }
    
    if(errorMsg) {
         Swal.fire({
            icon: 'error',
            title: 'Error',
            text: decodeURIComponent(errorMsg),
            toast: true,
            position: 'top-end',
            showConfirmButton: false,
            timer: 4000
        });
        window.history.replaceState({}, document.title, window.location.pathname);
    }
</script>
