<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Snoop - Smart Proctoring System</title>
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Poppins', sans-serif;
      background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
      color: #f8fafc;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0;
      overflow-x: hidden;
    }

    .hero-container {
      text-align: center;
      max-width: 900px;
      padding: 2rem;
      animation: fadeIn 1s ease-out;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(20px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .logo-text {
      font-size: 4rem;
      font-weight: 700;
      background: linear-gradient(to right, #38bdf8, #818cf8);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      margin-bottom: 0.5rem;
      letter-spacing: -1px;
    }

    .tagline {
      font-size: 1.25rem;
      color: #94a3b8;
      margin-bottom: 3rem;
      font-weight: 300;
    }

    .selection-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 2rem;
      margin-top: 2rem;
    }

    .role-card {
      background: rgba(30, 41, 59, 0.7);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 1.5rem;
      padding: 2.5rem;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      text-decoration: none;
      color: inherit;
      display: flex;
      flex-direction: column;
      align-items: center;
      cursor: pointer;
    }

    .role-card:hover {
      transform: translateY(-10px);
      background: rgba(30, 41, 59, 0.9);
      border-color: #38bdf8;
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2), 0 10px 10px -5px rgba(0, 0, 0, 0.1);
    }

    .icon-box {
      width: 64px;
      height: 64px;
      background: linear-gradient(135deg, rgba(56, 189, 248, 0.1), rgba(129, 140, 248, 0.1));
      border-radius: 1rem;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 1.5rem;
      color: #38bdf8;
      font-size: 2rem;
    }

    .role-title {
      font-size: 1.5rem;
      font-weight: 600;
      margin-bottom: 0.75rem;
      color: #f1f5f9;
    }

    .role-desc {
      font-size: 0.9rem;
      color: #94a3b8;
      line-height: 1.5;
    }

    .btn-glow {
      position: relative;
      overflow: hidden;
    }

    .btn-glow::after {
      content: '';
      position: absolute;
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      background: linear-gradient(45deg, transparent, rgba(56, 189, 248, 0.1), transparent);
      transform: rotate(45deg);
      transition: 0.5s;
    }

    .role-card:hover .btn-glow::after {
      left: 100%;
    }

    @media (max-width: 640px) {
      .logo-text {
        font-size: 3rem;
      }

      .tagline {
        font-size: 1rem;
      }
    }
  </style>
</head>

<body>
  <div class="hero-container">
    <h1 class="logo-text">SNOOP</h1>
    <p class="tagline">Next-Generation Proctoring & Examination Management</p>

    <div class="selection-grid">
      <a href="/teacher/login" class="role-card btn-glow">
        <div class="icon-box">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
            <circle cx="9" cy="7" r="4" />
            <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
            <path d="M16 3.13a4 4 0 0 1 0 7.75" />
          </svg>
        </div>
        <h2 class="role-title">Administrator</h2>
        <p class="role-desc">Create examinations, manage students, and monitor proctoring sessions in real-time.</p>
      </a>

      <a href="/student/login" class="role-card btn-glow">
        <div class="icon-box">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 10v6M2 10l10-5 10 5-10 5z" />
            <path d="M6 12v5c3 3 9 3 12 0v-5" />
          </svg>
        </div>
        <h2 class="role-title">Student</h2>
        <p class="role-desc">Access your scheduled tests, view results, and complete assessments securely.</p>
      </a>
    </div>
  </div>
</body>

</html>