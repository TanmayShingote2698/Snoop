<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Snoop - Smart Proctoring</title>
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/assets/favicon/favicon.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="64x64" href="/assets/favicon/favicon-64x64.png">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    :root {
      --primary: #D410AA;
      --secondary: #b0078a;
      --bg-dark: #F5F5F5;
      --bg-start: #F5F5F5;
      --bg-end: #E5E5E5;
      --bg-card: rgba(255, 255, 255, 0.9);
      --text-main: #1A1A1A;
      --text-dim: #242424;
      --text-grad-start: #1A1A1A;
      --text-grad-end: #D410AA;
    }

    /* ... code omitted ... */

    .hero h1 {
      font-size: 4.5rem;
      line-height: 1.1;
      margin-bottom: 1.5rem;
      background: linear-gradient(to bottom, var(--text-grad-start), var(--text-grad-end));
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      animation: fadeInDown 1s ease-out;
    }

    /* ... code omitted ... */


    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Poppins', sans-serif;
      background: linear-gradient(135deg, var(--bg-start) 0%, var(--bg-end) 100%);
      color: var(--text-main);
      overflow-x: hidden;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* Education Floating Icons */
    .floating-icon {
      position: fixed;
      z-index: -1;
      opacity: 0.12;
      color: var(--text-main);
      pointer-events: none;
      filter: drop-shadow(0 0 10px rgba(255,255,255,0.05));
      animation: iconFloat 25s infinite ease-in-out alternate;
    }

   /* Set 1 */
    .icon-1 { top: 15%; left: 8%; font-size: 4rem; animation-delay: 0s; transform: rotate(-15deg); }
    .icon-2 { bottom: 20%; left: 12%; font-size: 6rem; animation-delay: -3s; transform: rotate(10deg); }
    .icon-3 { top: 20%; right: 12%; font-size: 5rem; animation-delay: -7s; transform: rotate(5deg); }
    .icon-4 { bottom: 15%; right: 8%; font-size: 4.5rem; animation-delay: -11s; transform: rotate(-10deg); }
    
    /* Set 2 */
    .icon-5 { top: 10%; left: 50%; font-size: 5rem; animation-delay: -2s; transform: rotate(0deg); opacity: 0.08; }
    .icon-6 { top: 50%; right: 5%; font-size: 4rem; animation-delay: -5s; transform: rotate(-20deg); }
    .icon-7 { top: 60%; left: 5%; font-size: 4rem; animation-delay: -9s; transform: rotate(15deg); }
    .icon-8 { bottom: 10%; left: 45%; font-size: 5.5rem; animation-delay: -13s; transform: rotate(30deg); }

    /* Set 3 */
    .icon-9 { top: 80%; right: 30%; font-size: 4rem; animation-delay: -4s; transform: rotate(10deg); }
    .icon-10 { top: 40%; left: 25%; font-size: 5rem; animation-delay: -8s; transform: rotate(-5deg); }
    .icon-11 { top: 30%; left: 80%; font-size: 4.5rem; animation-delay: -1s; transform: rotate(20deg); }
    .icon-12 { bottom: 40%; left: 85%; font-size: 4rem; animation-delay: -6s; transform: rotate(-10deg); }

    /* Set 4 (New) */
    .icon-13 { top: 5%; left: 20%; font-size: 3rem; animation-delay: -5s; opacity: 0.07; }
    .icon-14 { top: 5%; right: 20%; font-size: 3.5rem; animation-delay: -2s; opacity: 0.07; }
    .icon-15 { bottom: 5%; left: 30%; font-size: 3rem; animation-delay: -8s; opacity: 0.07; }
    .icon-16 { bottom: 5%; right: 30%; font-size: 3.5rem; animation-delay: -4s; opacity: 0.07; }
    .icon-17 { top: 45%; left: 15%; font-size: 3rem; animation-delay: -9s; transform: rotate(45deg); }
    .icon-18 { top: 55%; right: 15%; font-size: 3rem; animation-delay: -1s; transform: rotate(-45deg); }
    
    /* Set 5 (Tiny Fillers) */
    .icon-19 { top: 25%; left: 40%; font-size: 2rem; opacity: 0.05; animation-delay: -3s; }
    .icon-20 { top: 75%; left: 60%; font-size: 2.5rem; opacity: 0.05; animation-delay: -6s; }
    .icon-21 { top: 35%; right: 40%; font-size: 2rem; opacity: 0.05; animation-delay: -2s; }
    .icon-22 { bottom: 35%; right: 25%; font-size: 2.5rem; opacity: 0.05; animation-delay: -7s; }
    .icon-23 { top: 15%; left: 5%; font-size: 2rem; opacity: 0.05; animation-delay: -4s; }
    .icon-24 { bottom: 15%; right: 5%; font-size: 2rem; opacity: 0.05; animation-delay: -5s; }

    /* Set 6 (More Variety) */
    .icon-25 { top: 90%; left: 10%; font-size: 4rem; animation-delay: -10s; }
    .icon-26 { top: 90%; right: 10%; font-size: 4rem; animation-delay: -11s; }
    .icon-27 { top: 50%; left: 50%; font-size: 8rem; opacity: 0.03; animation-delay: -15s; } /* Center Giant */
    .icon-28 { top: 10%; right: 45%; font-size: 3rem; animation-delay: -2s; }
    .icon-29 { bottom: 45%; left: 5%; font-size: 3rem; animation-delay: -8s; }
    .icon-30 { top: 30%; right: 5%; font-size: 3rem; animation-delay: -5s; }

    /* Set 7 (Final Polish) */
    .icon-31 { top: 65%; left: 20%; font-size: 2.5rem; opacity: 0.06; }
    .icon-32 { top: 25%; right: 25%; font-size: 2.5rem; opacity: 0.06; }
    .icon-33 { bottom: 25%; left: 35%; font-size: 2rem; opacity: 0.06; }
    .icon-34 { top: 85%; left: 40%; font-size: 3rem; opacity: 0.06; }
    .icon-35 { bottom: 80%; right: 35%; font-size: 3rem; opacity: 0.06; }

    @keyframes iconFloat {
      0% { transform: translateY(0) rotate(0deg); }
      100% { transform: translateY(-30px) rotate(10deg); }
    }

    /* Header */
    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.5rem 1.5rem;
      background: rgba(255, 255, 255, 0.7);
      backdrop-filter: blur(5px);
      position: sticky;
      top: 0;
      z-index: 1000;
      border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    }

    .logo {
      font-size: 2rem;
      font-weight: 700;
      background: linear-gradient(to right, var(--primary), var(--secondary));
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      letter-spacing: -1px;
    }

    .access-btn {
      background: linear-gradient(135deg, var(--primary), var(--secondary));
      color: white;
      padding: 0.75rem 1.5rem;
      border-radius: 2rem;
      text-decoration: none;
      font-weight: 600;
      transition: all 0.3s ease;
      box-shadow: 0 4px 15px rgba(56, 189, 248, 0.3);
    }

    .access-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(56, 189, 248, 0.5);
    }

    /* Hero Section */
    .hero {
      min-height: 80vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 4rem 2rem;
      position: relative;
    }

    .hero h1 {
      font-size: 4.5rem;
      line-height: 1.1;
      margin-bottom: 1.5rem;
      background: linear-gradient(to bottom, var(--text-grad-start), var(--text-grad-end));
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      animation: fadeInDown 1s ease-out;
    }

    .hero p {
      font-size: 1.25rem;
      color: var(--text-dim);
      max-width: 700px;
      margin-bottom: 3rem;
      animation: fadeInUp 1s ease-out 0.3s backwards;
    }

    /* Features Grid */
    .features {
      max-width: 1200px;
      margin: 0 auto 5rem;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 2rem;
      padding: 0 2rem;
      animation: fadeIn 1.5s ease-out 0.5s backwards;
    }

    .feature-card {
      background: var(--bg-card);
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: 1.5rem;
      padding: 2rem;
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
    }

    .feature-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(45deg, transparent, rgba(56, 189, 248, 0.03), transparent);
      transform: translateX(-100%);
      transition: 0.5s;
    }

    .feature-card:hover {
      transform: translateY(-5px);
      border-color: rgba(56, 189, 248, 0.3);
      box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
    }

    .feature-card:hover::before {
      transform: translateX(100%);
    }

    .icon-wrapper {
      width: 50px;
      height: 50px;
      background: rgba(56, 189, 248, 0.1);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 1.5rem;
      color: var(--primary);
      font-size: 1.5rem;
    }

    .feature-title {
      font-size: 1.25rem;
      margin-bottom: 0.75rem;
      color: var(--text-main);
      font-weight: 600;
    }

    .feature-desc {
      color: var(--text-dim);
      font-size: 0.95rem;
      line-height: 1.6;
    }

    @keyframes fadeInDown {
      from { opacity: 0; transform: translateY(-20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Footer Styles */
    .snoop-footer {
      text-align: center;
      padding: 1.5rem;
      margin-top: auto; /* Push to bottom using Flexbox */
      border-top: 1px solid rgba(0, 0, 0, 0.05); /* very light border */
      color: var(--text-dim);
      font-size: 0.9rem;
      background: transparent;
      position: relative;
      z-index: 10;
    }

    body.light-theme .snoop-footer {
      background: #f2f6f9;
      border-top: 1px solid rgba(0, 0, 0, 0.05);
    }
  </style>
</head>

