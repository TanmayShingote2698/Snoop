<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="glass-card">
      <div class="text-center mb-4">
        <i class="fas fa-edit fa-3x mb-3" style="color: var(--primary);"></i>
        <h2 class="font-weight-bold">Edit Test Details</h2>
        <p class="text-dim">Update configuration for Test ID <span class="text-white"><%= test.id %></span></p>
      </div>

      <form action="/teacher/takeTestID" method="POST">
        <!-- Hidden input to identify update vs create, though takeTestID handles upsert -->
        
        <div class="form-group">
          <label><i class="fas fa-fingerprint mr-2"></i>Unique Test ID (Read-only)</label>
          <input name="testID" type="text" class="form-control" value="<%= test.id %>" readonly style="opacity: 0.7; cursor: not-allowed;">
        </div>

        <div class="form-group">
          <label><i class="fas fa-key mr-2"></i>Access Code (Password)</label>
          <input name="accessCode" type="password" class="form-control" value="<%= test.accessCode %>" required>
        </div>

        <div class="row">
          <div class="col-md-6 form-group">
            <label><i class="fas fa-clock mr-2"></i>Start Date & Time</label>
            <input name="startTime" type="datetime-local" class="form-control" value="<%= test.startTime %>" required>
          </div>
          <div class="col-md-6 form-group">
            <label><i class="fas fa-history mr-2"></i>End Date & Time</label>
            <input name="endTime" type="datetime-local" class="form-control" value="<%= test.endTime %>" required>
          </div>
        </div>

        <div class="form-group">
          <label><i class="fas fa-hourglass-half mr-2"></i>Test Duration (Mins)</label>
          <input name="testDuration" type="number" class="form-control" value="<%= test.testDuration %>" required>
        </div>

        <div class="form-group mb-4">
          <label><i class="fas fa-exclamation-triangle mr-2"></i>Warning Threshold</label>
          <input name="warningThreshold" type="number" class="form-control" value="<%= test.warningThreshold %>" required>
        </div>

        <div class="form-group mb-4">
          <label><i class="fas fa-check-double mr-2"></i>Passing Marks</label>
          <input name="passingMarks" type="number" class="form-control" value="<%= test.passingMarks || 0 %>" min="0" required>
          <small class="text-dim">Students scoring at or above this will be marked as PASS.</small>
        </div>

        <div class="d-flex justify-content-between">
           <a href="/teacher/showAllTests" class="btn btn-outline-light rounded-pill px-4">Cancel</a>
           <button type="submit" class="btn-snoop px-5">
             Save & Continue <i class="fas fa-arrow-right ml-2"></i>
           </button>
        </div>
      </form>
    </div>
  </div>
</div>
