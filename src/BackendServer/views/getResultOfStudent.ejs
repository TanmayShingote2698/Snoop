
    <div class="row justify-content-center" style="margin-top: 5px;">
        <div class="col-md-5">
            <div class="glass-card text-center">
                <i class="fas fa-search-location fa-3x mb-4" style="color: var(--secondary);"></i>
                <h2 class="font-weight-bold mb-3">Check Your Results</h2>
                <p class="text-dim mb-4">Enter your registered email address to retrieve your examination performance.
                </p>

                <form action="/student/GetResultByEmail" method="POST">
                    <div class="form-group mb-4 text-left">
                        <label class="d-block"><i class="fas fa-envelope mr-2"></i>Registration Email</label>
                        <input type="email" class="form-control" placeholder="name@example.com" name="email" required>
                    </div>
                    <button type="submit" class="btn-snoop w-100 justify-content-center">
                        Retrieve Results <i class="fas fa-file-download ml-2"></i>
                    </button>
                </form>
                
                <div class="mt-3">
                    <button onclick="window.history.back()" class="btn btn-link text-dim" style="text-decoration: none;">
                        <i class="fas fa-arrow-left mr-2"></i> Back to Dashboard
                    </button>
                </div>
            </div>
        </div>
    </div>