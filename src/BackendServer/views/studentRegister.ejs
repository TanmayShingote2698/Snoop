<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Student Register</title>
</head>

<body>
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="glass-card">
        <div class="text-center mb-4">
          <i class="fas fa-user-plus fa-3x mb-3" style="color: var(--primary);"></i>
          <h2 class="font-weight-bold">Student Registration</h2>
          <p class="text-dim">Join Snoop and start your secure assessment journey.</p>
        </div>

        <form action="/student/register" method="POST" enctype="multipart/form-data">
          <div class="form-group">
            <label><i class="fas fa-user mr-2"></i>Full Name</label>
            <input name="name" type="text" class="form-control" placeholder="Enter Your Name" required>
          </div>
          <div class="form-group">
            <label><i class="fas fa-envelope mr-2"></i>Email Address</label>
            <input name="email" type="email" class="form-control" placeholder="name@example.com" required>
            <small class="form-text text-muted">A verification link may be sent here.</small>
          </div>
          <div class="form-group">
            <label><i class="fas fa-camera mr-2"></i>Profile Identification Photo</label>
            <input name="photo" type="file" class="form-control" required>
            <small class="form-text text-muted">Required for AI-proctoring identity verification.</small>
          </div>
          <div class="form-group mb-4">
            <label><i class="fas fa-lock mr-2"></i>Password</label>
            <div class="position-relative">
              <input name="password" type="password" class="form-control" placeholder="••••••••" required id="passwordStudentRegister">
              <i class="fas fa-eye position-absolute" 
                 style="right: 15px; top: 50%; transform: translateY(-50%); cursor: pointer; color: var(--text-dim);"
                 onclick="togglePassword(this, 'passwordStudentRegister')"></i>
            </div>
          </div>

          <button type="submit" class="btn-snoop w-100 justify-content-center">
            Register Now <i class="fas fa-user-check"></i>
          </button>
        </form>

        <div class="text-center mt-4">
          <p class="small text-dim">Already have an account?
            <a href="/student/login" style="color: var(--primary); font-weight: 600;">Sign In Here</a>
          </p>
        </div>
      </div>
    </div>
  </div>

</body>

</html>