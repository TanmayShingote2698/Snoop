  <div class="text-center mb-5">
    <h2 class="font-weight-bold">Test Review: <span style="color: var(--primary);"><%= test.id %></span>
    </h2>
    <p class="text-dim">Review and manage the questions in your assessment.</p>
  </div>

  <% if (!test || !test.questions || test.questions.length === 0) { %>
    <div class="glass-card mb-5 p-5">
      <div class="text-center">
        <i class="fas fa-inbox text-dim" style="font-size: 3rem; margin-bottom: 1rem;"></i>
        <h4>No Questions Added</h4>
        <p class="text-dim">This test doesn't have any questions yet. <a href="javascript:window.history.back()">Go back to add questions</a>.</p>
      </div>
    </div>
  <% } else { %>
    <!-- Invitation Section -->
    <div class="row justify-content-center mb-5">
      <div class="col-md-10">
        <div class="glass-card" style="border: 1px solid var(--primary); background: rgba(212, 16, 170, 0.05);">
            <div class="row align-items-center">
                <div class="col-md-7">
                    <h4 class="font-weight-bold mb-2"><i class="fas fa-paper-plane mr-2" style="color: var(--primary);"></i>Invite Students</h4>
                    <p class="text-dim small mb-3">Send professional invitations with the direct join link and access code.</p>
                    
                    <div class="d-flex align-items-center mb-3">
                        <div class="input-group" style="flex: 1;">
                            <div class="input-group-prepend">
                                <span class="input-group-text" style="background: var(--bg-input); border-color: var(--glass-border); color: var(--text-dim); border-radius: 8px 0 0 8px;"><i class="fas fa-link"></i></span>
                            </div>
                            <input type="text" id="directLinkInput" class="form-control" readonly value="http://localhost:5000/student/join/<%= test.id %>" style="background: var(--bg-input); border-color: var(--glass-border); color: var(--primary); font-family: monospace; border-radius: 0 8px 8px 0;">
                        </div>
                        <button class="btn btn-outline-primary ml-2" type="button" onclick="copyDirectLink()" title="Copy Link" style="border-radius: 8px; width: 45px; height: 38px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                            <i class="far fa-copy"></i>
                        </button>
                    </div>
                </div>
                <div class="col-md-5">
                    <form action="/teacher/sendInvites" method="POST" enctype="multipart/form-data">
                        <input type="hidden" name="testID" value="<%= test.id %>">
                        <input type="hidden" name="accessCode" value="<%= test.accessCode %>">
                        
                        <div class="form-group mb-2">
                            <label class="small text-dim font-weight-bold mb-1">MANUAL EMAILS (Comma separated)</label>
                            <textarea name="emails" class="form-control" rows="1" placeholder="student1@example.com..." style="background: rgba(255,255,255,0.05); font-size: 0.85rem; border-color: var(--glass-border);"></textarea>
                        </div>

                        <div class="text-center my-2">
                            <span class="badge badge-dark p-1" style="font-size: 0.7rem; background: rgba(0,0,0,0.2);">OR</span>
                        </div>

                        <div class="form-group mb-3">
                            <label class="small text-dim font-weight-bold mb-1">BULK UPLOAD (Excel)</label>
                            <div class="custom-file" style="font-size: 0.85rem;">
                                <input type="file" name="inviteFile" class="custom-file-input" id="inviteFile" accept=".xlsx, .xls">
                                <label class="custom-file-label" for="inviteFile" style="background: rgba(255,255,255,0.05); border-color: var(--glass-border); color: var(--text-dim);">Choose file...</label>
                            </div>
                            <small class="text-dim mt-1 d-block" style="font-size: 0.75rem;">Columns: <strong>Name</strong>, <strong>Email</strong></small>
                        </div>

                        <button type="submit" class="btn-snoop w-100 justify-content-center py-2">
                            Send Invitations <i class="fas fa-paper-plane ml-2"></i>
                        </button>
                    </form>
                    <script>
                        document.getElementById('inviteFile')?.addEventListener('change', function(e) {
                            var fileName = e.target.files[0]?.name || 'Choose file...';
                            e.target.nextElementSibling.innerText = fileName;
                        });
                    </script>
                </div>
            </div>
        </div>
      </div>
    </div>

    <script>
    async function copyDirectLink() {
        const copyText = document.getElementById("directLinkInput");
        const btn = event.currentTarget || event.target;
        
        try {
            await navigator.clipboard.writeText(copyText.value);
            
            // Show visual feedback
            const originalHTML = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-check"></i>';
            btn.style.background = 'linear-gradient(135deg, #10b981 0%, #059669 100%)';
            btn.style.color = 'white';
            btn.style.borderColor = '#10b981';
            btn.style.transform = 'scale(1.1)';
            
            setTimeout(() => {
                btn.innerHTML = originalHTML;
                btn.style.background = '';
                btn.style.color = '';
                btn.style.borderColor = '';
                btn.style.transform = '';
            }, 2000);
        } catch (err) {
            console.error('Failed to copy: ', err);
            // Fallback for older browsers
            copyText.select();
            document.execCommand("copy");
        }
    }
    </script>
    <div class="text-center mb-4">
      <span class="badge badge-info" style="font-size: 16px; padding: 10px 20px;">
        <i class="fas fa-list mr-2"></i> Total Questions: <%= test.questions.length %>
      </span>
    </div>

    <div class="row justify-content-center">
      <div class="col-md-10">
        <% test.questions.forEach(function(question, index){ %>
          <div class="glass-card mb-4">
            <div class="d-flex align-items-start mb-3">
              <span class="badge badge-primary mr-3 p-2">Question <%= index + 1 %></span>
              <h5 class="font-weight-bold mt-1">
                <%= question.question %>
              </h5>
            </div>

            <% if(question.op1 !==undefined && question.op1 !== null && question.op1 !== ''){ %>
              <div class="options-grid mt-3 ml-4">
                <div class="row">
                  <div class="col-md-6 mb-2">
                    <div class="p-3 rounded" style="background: rgba(255,255,255,0.03);">
                      <strong>A)</strong> <%= question.op1 %>
                    </div>
                  </div>
                  <div class="col-md-6 mb-2">
                    <div class="p-3 rounded" style="background: rgba(255,255,255,0.03);">
                      <strong>B)</strong> <%= question.op2 %>
                    </div>
                  </div>
                  <div class="col-md-6 mb-2">
                    <div class="p-3 rounded" style="background: rgba(255,255,255,0.03);">
                      <strong>C)</strong> <%= question.op3 %>
                    </div>
                  </div>
                  <div class="col-md-6 mb-2">
                    <div class="p-3 rounded" style="background: rgba(255,255,255,0.03);">
                      <strong>D)</strong> <%= question.op4 %>
                    </div>
                  </div>
                </div>
                <div class="mt-3">
                  <span class="badge badge-success p-2">✓ Correct Answer: <%= question.answer %></span>
                </div>
              </div>
            <% } else { %>
              <div class="mt-2 ml-4">
                <span class="badge badge-secondary p-2"><i class="fas fa-file-alt mr-2"></i>Subjective Question</span>
                <% if (question.answer) { %>
                  <div class="mt-3 p-3 rounded" style="background: rgba(255,255,255,0.05); border-left: 3px solid var(--primary);">
                    <strong>Expected Answer:</strong>
                    <p class="text-dim mt-2"><%= question.answer.substring(0, 200) %><%= question.answer.length > 200 ? '...' : '' %></p>
                  </div>
                <% } %>
              </div>
            <% } %>
          </div>
        <% }) %>
      </div>
    </div>
  <% } %>
  <div class="text-center d-flex justify-content-center flex-wrap gap-2 mt-5">
    <button onclick="window.history.back()" class="btn-snoop btn-glass mr-2">
      <i class="fas fa-arrow-left mr-2"></i> Back
    </button>
    <a href="/teacher/home" class="btn-snoop mr-2">
      <i class="fas fa-home mr-2"></i> Dashboard
    </a>

    <% var _now=new Date(); var _start=test.startTime ? new Date(test.startTime) : null; var _end=test.endTime ? new
      Date(test.endTime) : null; var _isEditable=!_start || !_end || _now < _start; %>
      <% if (_isEditable) { %>
        <form action="/teacher/editTest" method="POST" class="d-inline">
          <input type="hidden" name="testID" value="<%= test.id %>">
          <button type="submit" class="btn-snoop mr-2"
            style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);">
            Edit Test <i class="fas fa-edit ml-2"></i>
          </button>
        </form>
        <% } else { %>
          <button class="btn-snoop disabled mr-2" disabled style="background: #4b5563; cursor: not-allowed; opacity: 0.6;">
            <i class="fas fa-lock mr-2"></i> Editing Locked
          </button>
          <% } %>

            <form action="/teacher/deleteTest" method="POST" class="d-inline"
              onsubmit="return confirm('Are you sure you want to delete this test? This action cannot be undone.');">
              <input type="hidden" name="testID" value="<%= test.id %>">
              <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-4 align-self-center">
                <i class="fas fa-trash-alt mr-1"></i> Delete Test
              </button>
            </form>
  </div>