<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Document</title>
</head>

<body>
  <div class="text-center mb-5">
    <h2 class="font-weight-bold">Rest View: <%= test.id %>
    </h2>
    <p class="text-dim">Review the questions added to your dynamic assessment.</p>
  </div>

  <div class="row justify-content-center">
    <div class="col-md-10">
      <% test.questions.forEach(function(question, index){ %>
        <div class="glass-card mb-4">
          <div class="d-flex align-items-start mb-3">
            <span class="badge badge-primary mr-3 p-2">Question <%= index + 1 %></span>
            <h5 class="font-weight-bold mt-1">
              <%= question.question %>
            </h5>
          </div>

          <% if(question.op1 !==undefined){ %>
            <div class="options-grid mt-3 ml-4">
              <div class="row">
                <div class="col-md-6 mb-2">
                  <div class="p-3 rounded" style="background: rgba(255,255,255,0.03);">1. <%= question.op1 %>
                  </div>
                </div>
                <div class="col-md-6 mb-2">
                  <div class="p-3 rounded" style="background: rgba(255,255,255,0.03);">2. <%= question.op2 %>
                  </div>
                </div>
                <div class="col-md-6 mb-2">
                  <div class="p-3 rounded" style="background: rgba(255,255,255,0.03);">3. <%= question.op3 %>
                  </div>
                </div>
                <div class="col-md-6 mb-2">
                  <div class="p-3 rounded" style="background: rgba(255,255,255,0.03);">4. <%= question.op4 %>
                  </div>
                </div>
              </div>
              <div class="mt-3">
                <span class="badge badge-success p-2">Correct Answer: Option <%= question.answer %></span>
              </div>
            </div>
            <% } else { %>
              <div class="mt-2 ml-4">
                <span class="badge badge-secondary p-2">Subjective Question</span>
              </div>
              <% } %>
        </div>
        <% }) %>

          <div class="text-center mt-5">
            <a href="/teacher/home" class="btn-snoop">
              <i class="fas fa-home mr-2"></i> Back to Dashboard
            </a>
          </div>
    </div>
  </div>
</body>

</html>