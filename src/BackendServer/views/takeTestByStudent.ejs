  <script src="/socket.io/socket.io.js"></script>
  <input type="number" style="display: none;" value="<%= test.testDuration %>" name="testDuration" id="testDuration">
  
  <div class="exam-header d-flex justify-content-between align-items-center mb-5 p-4 glass-card"
    style="position: relative; z-index: 1000; border-bottom: 2px solid var(--primary);">
    <div class="d-flex align-items-center">
      <div class="mr-4 text-center" style="border-right: 2px solid var(--glass-border); padding-right: 20px;">
        <h2 class="navbar-brand-snoop mb-0" style="font-size: 2rem;">SNOOP</h2>
        <p class="text-dim mb-0 small font-weight-bold" style="letter-spacing: 1px;">PROCTORING SYSTEM</p>
      </div>
      <div>
        <h4 class="font-weight-bold mb-0 text-main">Examination: <span style="color: var(--primary);">
            <%= test.id %>
          </span></h4>
        <div class="d-flex align-items-center mt-1">
          <p class="text-dim mb-0 small">Student: <span class="text-main font-weight-bold"><%= email %></span>
          </p>
        </div>
      </div>
    </div>
    <style>
      .ai-pulse {
        background: #ef4444;
        animation: pulse-red 2s infinite;
        border: none;
        box-shadow: 0 0 10px rgba(239, 68, 68, 0.4);
      }

      @keyframes pulse-red {
        0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); }
        70% { transform: scale(1); box-shadow: 0 0 0 10px rgba(239, 68, 68, 0); }
        100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
      }

      .animate-pulse-pink {
        animation: pulse-pink 2s infinite;
      }

      @keyframes pulse-pink {
        0% { transform: scale(0.98); opacity: 0.8; }
        50% { transform: scale(1); opacity: 1; }
        100% { transform: scale(0.98); opacity: 0.8; }
      }

      /* AI Monitor Status Bar */
      .ai-monitor-status {
        position: fixed;
        top: 20px;
        left: 50%;
        transform: translateX(-50%);
        padding: 12px 24px;
        border-radius: 50px;
        font-weight: 700;
        font-size: 15px;
        z-index: 9999;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        display: flex;
        align-items: center;
        gap: 10px;
        color: white;
        pointer-events: none;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      }

      @keyframes blink-active {
        0% { opacity: 1; transform: translateX(-50%) scale(1); }
        50% { opacity: 0.5; transform: translateX(-50%) scale(0.98); }
        100% { opacity: 1; transform: translateX(-50%) scale(1); }
      }

      .status-active {
        background: linear-gradient(135deg, rgba(239, 68, 68, 0.9) 0%, rgba(185, 28, 28, 0.9) 100%);
        animation: blink-active 1s infinite;
        box-shadow: 0 0 15px rgba(239, 68, 68, 0.4);
      }

      .status-warning {
        background: linear-gradient(135deg, #eab308 0%, #ca8a04 100%);
      }

      .status-processing {
        background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
      }

      .status-complete {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
      }

      .status-error {
        background: linear-gradient(135deg, #f87171 0%, #ef4444 100%);
      }

      .status-info {
        background: linear-gradient(135deg, #64748b 0%, #1e293b 100%);
        color: white;
      }
    </style>
    <div class="timer-box text-right glass-card p-3 d-flex align-items-center" style="background: rgba(239, 68, 68, 0.05); border-color: rgba(239, 68, 68, 0.2);">
      <div class="mr-3">
        <p class="text-dim mb-0 small">Time Remaining</p>
        <h3 id="timer" class="font-weight-bold mb-0" style="color: #ef4444; font-variant-numeric: tabular-nums;"></h3>
      </div>
      <i class="fas fa-clock fa-2x text-danger animate-pulse"></i>
    </div>
  </div>

  <form action="/student/submitTest" method="POST" id="testFormID">
    <input type="hidden" name="email" value="<%= email %>">
    <input type="hidden" name="testID" value="<%= test.id %>">
    <input type="hidden" name="tabSwitchData" id="tabSwitchData" value="[]">
    <input type="hidden" name="fullscreenData" id="fullscreenData" value="[]">
    <input type="hidden" name="actionLogs" id="actionLogs" value="[]">
    <!-- AI Monitoring Data -->
    <input type="hidden" name="cheatScore" id="cheatScore" value="0">
    <input type="hidden" name="anomalyData" id="anomalyData" value="[]">
    <input type="hidden" name="monitoringStats" id="monitoringStats" value="{}">

    <style>
      .option-card {
        cursor: pointer;
        transition: all 0.25s ease;
        border: 1px solid var(--glass-border);
        background: rgba(255, 255, 255, 0.02);
      }

      .option-card:hover {
        background: rgba(255, 255, 255, 0.06) !important;
        border-color: var(--primary)88;
        transform: translateY(-2px);
      }

      .option-card.selected {
        background: linear-gradient(135deg, rgba(212, 16, 170, 0.15) 0%, rgba(59, 130, 246, 0.15) 100%) !important;
        border: 1.5px solid var(--primary);
        box-shadow: 0 0 15px rgba(212, 16, 170, 0.2);
        transform: scale(1.01);
      }

      .option-badge {
        width: 30px;
        height: 30px;
        background: var(--primary);
        color: #fff;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        margin-right: 15px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.2);
      }
    </style>

    <% for(var i=0 ; i < test.questions.length ; i++ ){ %>
      <div class="glass-card mb-4 p-4">
        <div class="d-flex align-items-start mb-3">
          <span class="badge badge-primary mr-3 p-2">Question <%= i + 1 %></span>
          <h5 class="font-weight-bold mt-1">
            <%= test.questions[i].question %>
          </h5>
        </div>



            <div class="options-grid mt-3 ml-4">
              <!-- Hidden Input to store the selected answer (1-4) -->
              <input type="hidden" name="<%= test.questions[i].ind %>" id="input_<%= i %>" required>

              <div class="row">
                <div class="col-md-6 mb-3">
                  <div class="p-3 rounded option-card h-100 d-flex align-items-center"
                    onclick="selectOption('<%= i %>', 1)" id="q<%= i %>_op1">
                    <div class="option-badge">A</div>
                    <span class="font-weight-bold">
                      <%= test.questions[i].op1 %>
                    </span>
                  </div>
                </div>

                <div class="col-md-6 mb-3">
                  <div class="p-3 rounded option-card h-100 d-flex align-items-center"
                    onclick="selectOption('<%= i %>', 2)" id="q<%= i %>_op2">
                    <div class="option-badge">B</div>
                    <span class="font-weight-bold">
                      <%= test.questions[i].op2 %>
                    </span>
                  </div>
                </div>

                <div class="col-md-6 mb-3">
                  <div class="p-3 rounded option-card h-100 d-flex align-items-center"
                    onclick="selectOption('<%= i %>', 3)" id="q<%= i %>_op3">
                    <div class="option-badge">C</div>
                    <span class="font-weight-bold">
                      <%= test.questions[i].op3 %>
                    </span>
                  </div>
                </div>

                <div class="col-md-6 mb-3">
                  <div class="p-3 rounded option-card h-100 d-flex align-items-center"
                    onclick="selectOption('<%= i %>', 4)" id="q<%= i %>_op4">
                    <div class="option-badge">D</div>
                    <span class="font-weight-bold">
                      <%= test.questions[i].op4 %>
                    </span>
                  </div>
                </div>
              </div>
            </div>
      </div>
      <% } %>

        <div class="text-center mt-5">
          <button type="submit" class="btn-snoop btn-lg px-5 py-3" id="endTestId"
            style="background: linear-gradient(135deg, #ef4444 0%, #b91c1c 100%);">
            Submit Examination <i class="fas fa-paper-plane ml-2"></i>
          </button>
        </div>
  </form>

  <script>
    var testDuration = document.getElementById('testDuration').value;
    console.log(typeof testDuration);
    testDuration = parseInt(testDuration);
    var countdown = testDuration * 60 * 1000;
    var timerId = setInterval(function () {
      countdown -= 1000;
      var min = Math.floor(countdown / (60 * 1000));
      //var sec = Math.floor(countdown - (min * 60 * 1000));  // wrong
      var sec = Math.floor((countdown - (min * 60 * 1000)) / 1000);  //correct

      if (countdown <= 0) {
        // document.getElementById('testFormID').submit();
        document.getElementById('endTestId').click();
        clearInterval(timerId);
        //doSomething();
      } else {
        document.getElementById('timer').innerHTML = `Time Remaining: ${min} : ${sec}`;
      }

    }, 1000); //1000ms. = 1sec.

    // MCQ Selection Logic
    function selectOption(qIndex, opNum) {
      // Get the text from the span inside the option card to avoid inline syntax errors
      const opText = document.querySelector(`#q${qIndex}_op${opNum} span.font-weight-bold`).innerText.trim();

      // Update Hidden Input (Source of Truth for Form)
      document.getElementById('input_' + qIndex).value = opText;

      // Visual Feedback
      // Remove 'selected' from all options of this question
      for (let i = 1; i <= 4; i++) {
        let el = document.getElementById(`q${qIndex}_op${i}`);
        if (el) el.classList.remove('selected');
      }

      // Add 'selected' to clicked option
      document.getElementById(`q${qIndex}_op${opNum}`).classList.add('selected');
    }

    // Remove warning on form submit
    document.getElementById('testFormID').onsubmit = function () {
      window.onbeforeunload = null;
    };

    // --- STRICT PROCTORING ENFORCEMENT & LOGGING ---

    let isSubmitting = false;
    let tabSwitchLogs = []; 
    let fullscreenLogs = []; 
    let actionLogs = []; // Master list of instant actions (keys, mouse leaves)
    let awayStartTime = null;
    let fullscreenExitStartTime = null;

    // --- AI MONITORING SETUP ---
    let snoopMonitor = null;
    let monitoringEnabled = false;
    let monitoringAnomalies = [];

    // Create AI Monitor Permission Overlay
    const monitoringOverlay = document.createElement('div');
    monitoringOverlay.id = 'monitoringOverlay';
    monitoringOverlay.style.cssText = 'position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(135deg, rgba(20,20,30,0.95), rgba(40,40,60,0.95)); z-index: 2001; display: flex; flex-direction: column; align-items: center; justify-content: center; color: white;';
    monitoringOverlay.innerHTML = `
        <div class="text-center glass-card p-5" style="max-width: 600px; border: 1px solid rgba(212, 16, 170, 0.3); background: rgba(255,255,255,0.05);">
            <div class="mb-4">
                <i class="fas fa-eye fa-4x mb-3 animate-pulse-pink" style="color: var(--primary);"></i>
                <h2 class="font-weight-bold mb-1">AI Proctoring System</h2>
                <p class="text-dim small text-uppercase font-weight-bold" style="letter-spacing: 2px;">Identity & Environment Verification</p>
            </div>
            <p class="text-dim mb-4">This exam utilizes advanced AI monitoring to maintain academic integrity. Please grant the necessary permissions to proceed.</p>
            
            <div class="row mb-4 text-left">
                <div class="col-6 mb-3">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-camera mr-2 text-primary"></i>
                        <span class="small font-weight-bold">Gaze Tracking</span>
                    </div>
                </div>
                <div class="col-6 mb-3">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-microphone mr-2 text-primary"></i>
                        <span class="small font-weight-bold">Audio Analysis</span>
                    </div>
                </div>
                <div class="col-6">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-user-shield mr-2 text-primary"></i>
                        <span class="small font-weight-bold">Face Detection</span>
                    </div>
                </div>
                <div class="col-6">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-mobile-alt mr-2 text-primary"></i>
                        <span class="small font-weight-bold">Object Detection</span>
                    </div>
                </div>
            </div>

            <button class="btn-snoop w-100 py-3 mb-3 justify-content-center" onclick="startAIMonitoring()">
                <i class="fas fa-shield-alt mr-2"></i> Confirm & Start Monitoring
            </button>
            <p class="text-dim small mb-0">Permissions will only be active during the exam period.</p>
        </div>
    `;
    document.body.appendChild(monitoringOverlay);

    // --- REAL-TIME MONITORING (Socket.IO) ---
    // Make sure socket.io is loaded before calling io()
    var socket = null;
    if (typeof io !== 'undefined') {
        socket = io(); // Connect to the WebSocket Server
    } else {
        console.error("Socket.IO client library not found. Real-time reporting disabled.");
    }
    const studentEmail = "<%= email %>";
    const currentTestID = "<%= test.id %>";

    // Join the specific test room immediately
    if (socket) {
        socket.emit('join_test_room', currentTestID);
        // Announce presence to the teacher instantly
        socket.emit('student_joined', { testID: currentTestID, studentEmail: studentEmail });
    }

    // Helper to log events (and emit them in real-time)
    function logEvent(type, startTime, endTime) {
        let duration = (endTime - startTime) / 1000;
        
        const eventData = {
            type: type, 
            startTime: startTime.toISOString(),
            endTime: endTime.toISOString(),
            durationSeconds: duration
        };
        
        if (type === 'TAB_SWITCH') {
            tabSwitchLogs.push(eventData);
        } else if (type === 'FULLSCREEN_EXIT') {
            fullscreenLogs.push(eventData);
        }
        
        updateHiddenInput();

        // Broadcast the violation to the teacher instantly
        if (socket) {
            socket.emit('student_activity', {
                testID: currentTestID,
                studentEmail: studentEmail,
                activityType: type,
                timestamp: new Date().toISOString(),
                details: eventData
            });
        }
    }

    // Helper for instant alerts (doesn't wait for duration like logEvent does)
    function emitInstantViolation(type, msg) {
        if (!isSubmitting) {
            // Log it locally for database
            actionLogs.push({
                type: type,
                message: msg,
                timestamp: new Date().toISOString()
            });
            updateHiddenInput();

            // Broadcast real-time
            if (socket) {
                socket.emit('student_activity', {
                    testID: currentTestID,
                    studentEmail: studentEmail,
                    activityType: type,
                    details: { message: msg },
                    timestamp: new Date().toISOString()
                });
            }
        }
    }

    function updateHiddenInput() {
        let tabInput = document.getElementById('tabSwitchData');
        let fullInput = document.getElementById('fullscreenData');
        let actionInput = document.getElementById('actionLogs');
        
        if(tabInput) {
            tabInput.value = JSON.stringify(tabSwitchLogs);
        }
        if(fullInput) {
            fullInput.value = JSON.stringify(fullscreenLogs);
        }
        if(actionInput) {
            actionInput.value = JSON.stringify(actionLogs);
        }
    }

    // Overlay for Fullscreen Enforcement
    const fullscreenOverlay = document.createElement('div');
    fullscreenOverlay.id = 'fullscreenOverlay';
    fullscreenOverlay.style.cssText = 'position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: #000; z-index: 2000; display: flex; flex-direction: column; align-items: center; justify-content: center; color: white;';
    fullscreenOverlay.innerHTML = `
        <div class="text-center glass-card p-5" style="max-width: 500px; border: 1px solid rgba(212, 16, 170, 0.3); background: rgba(0,0,0,0.8);">
            <i class="fas fa-expand-arrows-alt fa-4x mb-4 animate-pulse-pink" style="color: var(--primary);"></i>
            <h2 class="font-weight-bold mb-3">Environment Locked Required</h2>
            <p class="text-dim mb-4">To prevent unauthorized external assistance, this exam must be viewed in full-screen mode.</p>
            <button class="btn-snoop w-100 py-3" onclick="enterFullscreen()">
                <i class="fas fa-expand mr-2"></i> Initialize Secure View
            </button>
        </div>
    `;
    document.body.appendChild(fullscreenOverlay);

    function enterFullscreen() {
        const elem = document.documentElement;
        if (elem.requestFullscreen) {
            elem.requestFullscreen().then(() => {
                document.getElementById('fullscreenOverlay').style.display = 'none';
                
                // Show a brief success message
                Swal.fire({
                    icon: 'success',
                    title: 'Environment Locked',
                    text: 'Proctoring is active. Good luck!',
                    timer: 1500,
                    showConfirmButton: false,
                    toast: true,
                    position: 'top-end'
                });

                if (navigator.keyboard && navigator.keyboard.lock) {
                    navigator.keyboard.lock(['Escape']).catch(console.error);
                }
            }).catch(err => {
                console.error("Fullscreen Request Failed:", err);
            });
        }
    }

    // Check Fullscreen on Load
    if (!document.fullscreenElement && !document.webkitFullscreenElement && !document.mozFullScreenElement && !document.msFullscreenElement) {
        document.getElementById('fullscreenOverlay').style.display = 'flex';
    } else {
        document.getElementById('fullscreenOverlay').style.display = 'none';
    }

    // Monitor Fullscreen Changes (Handling all browser prefixes)
    const handleFullscreenChange = () => {
        const isFullscreen = document.fullscreenElement || document.webkitFullscreenElement || document.mozFullScreenElement || document.msFullscreenElement;
        
        if (!isFullscreen && !isSubmitting) {
            // EXITED Fullscreen
            fullscreenExitStartTime = new Date();
            emitInstantViolation('FULLSCREEN_EXIT_INSTANT', 'Exited fullscreen mode');
            
            document.getElementById('fullscreenOverlay').style.display = 'flex';
            Swal.fire({
                icon: 'warning',
                title: 'Fullscreen Exited!',
                text: 'You have left the examination environment. What would you like to do?',
                showDenyButton: true,
                confirmButtonText: 'Return to Test',
                denyButtonText: 'Submit & Finish',
                confirmButtonColor: 'var(--primary)',
                denyButtonColor: '#ef4444',
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then((result) => {
                let fullscreenExitEndTime = new Date();
                
                if (result.isConfirmed) {
                    // Log the exit event before re-entering
                    logEvent('FULLSCREEN_EXIT', fullscreenExitStartTime, fullscreenExitEndTime);
                    enterFullscreen();
                } else if (result.isDenied) {
                    // Log the exit event even if submitting
                    logEvent('FULLSCREEN_EXIT', fullscreenExitStartTime, fullscreenExitEndTime);
                    isSubmitting = true;
                    document.getElementById('testFormID').submit();
                }
            });
        } else {
            // ENTERED Fullscreen
            document.getElementById('fullscreenOverlay').style.display = 'none';
        }
    };

    document.addEventListener('fullscreenchange', handleFullscreenChange);
    document.addEventListener('webkitfullscreenchange', handleFullscreenChange); // Chrome, Safari, Opera
    document.addEventListener('mozfullscreenchange', handleFullscreenChange);    // Firefox
    document.addEventListener('MSFullscreenChange', handleFullscreenChange);     // IE/Edge

    // 1. Disable Right Click
    document.addEventListener('contextmenu', event => {
        event.preventDefault();
        Swal.fire({
            icon: 'error',
            title: 'Action Blocked!',
            text: 'Right-click is restricted during the exam.',
            confirmButtonColor: '#ef4444',
            timer: 2000,
            toast: true,
            position: 'top-end'
        });
    });

    // 2. Disable Copy/Cut/Paste
    document.oncut = document.oncopy = document.onpaste = function(event) {
        event.preventDefault();
        Swal.fire({
            icon: 'error',
            title: 'Action Blocked!',
            text: 'Clipboard operations are restricted.',
            confirmButtonColor: '#ef4444',
            timer: 2000,
            toast: true,
            position: 'top-end'
        });
        return false;
    };

    // 3. Detect Tab Switching (with Type & Duration Tracking)
    document.addEventListener('visibilitychange', function() {
        if (document.hidden && !isSubmitting) {
            // User left the tab
            awayStartTime = new Date();
            emitInstantViolation('TAB_SWITCH_INSTANT', 'Switched tabs or minimized');
            
            Swal.fire({
                icon: 'warning',
                title: 'Tab Switching Detected!',
                text: 'Moving away from the test window is prohibited. This incident has been recorded.',
                confirmButtonColor: '#ef4444',
                confirmButtonText: 'I Understand',
                allowOutsideClick: false,
                allowEscapeKey: false
            });
        } else if (!document.hidden && awayStartTime) {
            // User returned
            let awayEndTime = new Date();
            logEvent('TAB_SWITCH', awayStartTime, awayEndTime);
            awayStartTime = null; // Reset
        }
    });

    // Detect Window Focus Loss (Mini windows or Overlays)
    window.addEventListener('blur', function() {
        if (!isSubmitting) {
            emitInstantViolation('WINDOW_BLUR', 'Lost window focus');
            // We can treat this as a tab switch for DB logging as well
            if (!awayStartTime) {
                awayStartTime = new Date();
            }
        }
    });

    window.addEventListener('focus', function() {
        if (!isSubmitting && awayStartTime && !document.hidden) {
            let awayEndTime = new Date();
            logEvent('TAB_SWITCH', awayStartTime, awayEndTime);
            awayStartTime = null;
        }
    });

    // Detect Mouse Leaving the Window (Moving out of viewport)
    document.addEventListener('mouseleave', function(e) {
        if (!isSubmitting) {
            if (e.clientY <= 0 || e.clientX <= 0 || (e.clientX >= window.innerWidth || e.clientY >= window.innerHeight)) {
                emitInstantViolation('MOUSE_LEAVE', 'Cursor left the test window');
            }
        }
    });

    const originalSubmit = document.getElementById('testFormID').submit;

    async function executeFinalSubmission() {
        if (isSubmitting) return;
        isSubmitting = true;

        if (socket) {
            socket.emit('student_submitted', { testID: currentTestID, studentEmail: studentEmail });
        }

        if (snoopMonitor && monitoringEnabled) {
            Swal.fire({
                title: 'Submitting Test...',
                text: 'Processing secure AI submission packet. Please wait.',
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading() }
            });
            await collectMonitoringData();
            setTimeout(() => {
                originalSubmit.apply(document.getElementById('testFormID'));
            }, 500);
        } else {
            originalSubmit.apply(document.getElementById('testFormID'));
        }
    }

    // Handle Submit Button Click
    document.getElementById('endTestId').onclick = function(e) {
        e.preventDefault();
        executeFinalSubmission();
    };

    // Override programmatic submit
    document.getElementById('testFormID').submit = function() {
        executeFinalSubmission();
    };
    
    // Intercept native form submit event
    document.getElementById('testFormID').addEventListener('submit', function(e) {
        e.preventDefault();
        executeFinalSubmission();
    });

    // Navigation Lockdown (Back Button Intercept)
    window.onload = function () {
      // 1. Trap Back Button
      history.pushState(null, null, location.href);
      window.onpopstate = function () {
        history.pushState(null, null, location.href); // Immediately re-trap the state
        Swal.fire({
            title: 'Leave Exam?',
            text: "Do you want to submit your test and leave?",
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Yes, Submit & Leave',
            cancelButtonText: 'No, Stay',
            confirmButtonColor: '#ef4444', 
            cancelButtonColor: 'var(--primary)',
            reverseButtons: true
        }).then((result) => {
            if (result.isConfirmed) {
                isSubmitting = true;
                document.getElementById('testFormID').submit();
            }
        });
      };
      
      // 2. Auto-Submit on Reload/Close
      window.onbeforeunload = function () {
        if (!isSubmitting) {
            // User is trying to reload or close
            isSubmitting = true; // Prevent loop
            
            // Collect Form Data
            const form = document.getElementById('testFormID');
            const formData = new FormData(form);
            const searchParams = new URLSearchParams(formData);

            // Use fetch with keepalive to ensure request completes even after unload
            fetch('/student/submitTest', {
                method: 'POST',
                body: searchParams,
                keepalive: true
            }).catch(err => console.error("Auto-submit failed:", err));
            
            // Allow the reload/close to happen (which will hit GET /startExam -> redirect to Home)
            // Returning null suppresses the confirmation dialog
            return null; 
        }
      };
    };

    // Handle Timer Auto-Submit
    // (Note: The timer logic uses click() on endTestId, so it is covered)

    // Aggressive capture phase listeners to completely kill restricted keys before ANY element or popup gets them
    const blockKeys = function(e) {
        let keyChar = e.key ? e.key.toLowerCase() : '';
        
        // Block F11 and F12
        if (e.key === 'F11' || e.keyCode === 122 || e.key === 'F12' || e.keyCode === 123) {
            e.preventDefault();
            e.stopPropagation();
            if (e.type === 'keydown') {
                emitInstantViolation('PROHIBITED_KEY', e.key);
                Swal.fire({
                    icon: 'error',
                    title: 'Function Keys Disabled',
                    text: 'F11 and F12 shortcuts are strictly prohibited.',
                    confirmButtonColor: '#ef4444',
                    timer: 2000,
                    toast: true,
                    position: 'top-end'
                });
            }
            return false;
        }

        // Block Escape
        if (e.key === 'Escape' || e.keyCode === 27) {
            e.preventDefault();
            e.stopPropagation();
            if (e.type === 'keydown' && document.fullscreenElement) {
                emitInstantViolation('PROHIBITED_KEY', 'Escape');
                Swal.fire({
                    icon: 'warning',
                    title: 'Escape Key Restricted',
                    text: 'Please use the Submit button to exit the test.',
                    confirmButtonColor: 'var(--primary)',
                    timer: 3000,
                    toast: true,
                    position: 'top-end'
                });
            }
            return false;
        }

        // Block Alt and Windows(Meta) Keys
        if (e.altKey || e.metaKey || e.key === 'Meta' || e.key === 'OS') {
            e.preventDefault();
            e.stopPropagation();
            if (e.type === 'keydown') {
                let keyName = e.altKey ? 'Alt Key' : 'Windows/System Key';
                emitInstantViolation('PROHIBITED_KEY', keyName);
                Swal.fire({
                    icon: 'error',
                    title: 'Action Blocked!',
                    text: `${keyName} combinations are strictly prohibited.`,
                    confirmButtonColor: '#ef4444',
                    timer: 2000,
                    toast: true,
                    position: 'top-end'
                });
            }
            return false;
        }

        // Block ALL Ctrl combinations and DevTools (Ctrl+Shift+I/J/C)
        if (e.ctrlKey) { 
            e.preventDefault();
            e.stopPropagation();
            if (e.type === 'keydown') {
                emitInstantViolation('PROHIBITED_KEY', 'Ctrl Combination');
                Swal.fire({
                    icon: 'error',
                    title: 'Action Blocked!',
                    text: 'Control key shortcuts are strictly prohibited.',
                    confirmButtonColor: '#ef4444',
                    timer: 2000,
                    toast: true,
                    position: 'top-end'
                });
            }
            return false;
        }
    };

    window.addEventListener('keydown', blockKeys, true); // true = capture phase
    window.addEventListener('keyup', blockKeys, true);
    window.addEventListener('keypress', blockKeys, true);

    // --- AI MONITORING FUNCTIONS ---

    async function startAIMonitoring() {
        try {
            document.getElementById('monitoringOverlay').style.display = 'none';
            
            // Initialize SnoopMonitor
            snoopMonitor = new SnoopMonitor(
                currentTestID,
                studentEmail,
                {
                    frameInterval: 2000, // Capture every 2 seconds
                    onAnomalyDetected: onMonitoringAnomaly,
                    onStatusChange: updateMonitoringStatus,
                    onError: handleMonitoringError
                }
            );

            // Request permissions
            await snoopMonitor.requestPermissions();
            
            // Start session
            await snoopMonitor.startMonitoringSession();
            
            // Start continuous monitoring
            snoopMonitor.startMonitoring();
            monitoringEnabled = true;
            
            Swal.fire({
                icon: 'success',
                title: 'Monitoring Active',
                text: 'AI proctoring has been activated. You will be analyzed for exam integrity.',
                timer: 2000,
                showConfirmButton: false,
                toast: true,
                position: 'top-end'
            });
        } catch (error) {
            console.error("AI Monitoring error:", error);
            handleMonitoringError(error);
        }
    }

    function skipAIMonitoring() {
        document.getElementById('monitoringOverlay').style.display = 'none';
        monitoringEnabled = false;
        
        Swal.fire({
            icon: 'warning',
            title: 'Monitoring Skipped',
            text: 'You chose to proceed without AI monitoring. Your exam integrity score may be affected.',
            confirmButtonColor: '#ef4444',
            timer: 2500,
            showConfirmButton: false,
            toast: true,
            position: 'top-end'
    });
    }

    function onMonitoringAnomaly(anomaly) {
        monitoringAnomalies.push(anomaly);
        console.log("[ANOMALY DETECTED]", anomaly);
        
        // Alert for critical anomalies
        if (anomaly.type.includes('phone') || anomaly.type.includes('multiple_persons')) {
            Swal.fire({
                icon: 'warning',
                title: 'Anomaly Detected!',
                text: `${anomaly.type}: This has been recorded.`,
                toast: true,
                position: 'top-end',
                timer: 3000,
                showConfirmButton: false
            });
        }
    }

    function updateMonitoringStatus(message, state) {
        console.log(`[Monitoring Status] ${message} (${state})`);
        // Display status in UI
        let statusDiv = document.getElementById('ai-monitor-status');
        if (!statusDiv) {
            statusDiv = document.createElement('div');
            statusDiv.id = 'ai-monitor-status';
            document.body.appendChild(statusDiv);
        }
        statusDiv.textContent = message;
        statusDiv.className = `ai-monitor-status status-${state}`;
    }

    function handleMonitoringError(error) {
        console.error("[Monitoring Error]", error);
        Swal.fire({
            icon: 'error',
            title: 'Monitoring Error',
            text: 'There was an issue with AI monitoring: ' + error.message,
            confirmButtonColor: '#ef4444',
        });
    }

    async function collectMonitoringData() {
        if (!snoopMonitor || !monitoringEnabled) return;
        
        try {
            updateMonitoringStatus("Finalizing monitoring data...", "processing");
            
            // Stop monitoring
            const result = await snoopMonitor.stopMonitoring();
            
            // Collect statistics
            const stats = snoopMonitor.getStats();
            const cheatScore = snoopMonitor.getCheatScore();
            
            // Populate hidden form fields
            document.getElementById('cheatScore').value = cheatScore;
            document.getElementById('anomalyData').value = JSON.stringify(monitoringAnomalies);
            document.getElementById('monitoringStats').value = JSON.stringify(stats);
            
            console.log("[Monitoring Summary]", {
                cheatScore: cheatScore,
                anomalies: monitoringAnomalies.length,
                stats: stats
            });
            
            // Cleanup
            snoopMonitor.cleanupResources();
            
            return { cheatScore, stats };
        } catch (error) {
            console.error("Error collecting monitoring data:", error);
        }
    }

    // Fade out monitoring overlay after fullscreen is entered
    window.addEventListener('load', function() {
        // Show monitoring overlay if fullscreen is already active
        if (document.fullscreenElement || document.webkitFullscreenElement) {
            // User already in fullscreen, show monitoring request
            setTimeout(() => {
                if (document.getElementById('monitoringOverlay').style.display !== 'none') {
                    // Still showing, let user interact with it
                }
            }, 500);
        }
    });
  </script>
