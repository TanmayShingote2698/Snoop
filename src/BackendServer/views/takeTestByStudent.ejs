  <script src="/socket.io/socket.io.js"></script>
  <input type="number" style="display: none;" value="<%= test.testDuration %>" name="testDuration" id="testDuration">
  
  <div class="exam-header d-flex justify-content-between align-items-center mb-5 p-4 glass-card"
    style="position: relative; z-index: 100;">
    <div>
      <h4 class="font-weight-bold mb-0">Examination: <span style="color: var(--primary);">
          <%= test.id %>
        </span></h4>
      <div class="d-flex align-items-center mt-1">
        <p class="text-dim mb-0 small mr-3">Student: <%= email %>
        </p>
      </div>
    </div>
    <style>
      .ai-pulse {
        background: #ef4444;
        animation: pulse-red 2s infinite;
        border: none;
        box-shadow: 0 0 10px rgba(239, 68, 68, 0.4);
      }

      @keyframes pulse-red {
        0% {
          transform: scale(0.95);
          box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7);
        }

        70% {
          transform: scale(1);
          box-shadow: 0 0 0 10px rgba(239, 68, 68, 0);
        }

        100% {
          transform: scale(0.95);
          box-shadow: 0 0 0 0 rgba(239, 68, 68, 0);
        }
      }
    </style>
    <div class="timer-box text-right">
      <p class="text-dim mb-1 small">Time Remaining</p>
      <h3 id="timer" class="font-weight-bold mb-0" style="color: #ef4444;"></h3>
    </div>
  </div>

  <form action="/student/submitTest" method="POST" id="testFormID">
    <input type="hidden" name="email" value="<%= email %>">
    <input type="hidden" name="testID" value="<%= test.id %>">
    <input type="hidden" name="tabSwitchData" id="tabSwitchData" value="[]">
    <input type="hidden" name="fullscreenData" id="fullscreenData" value="[]">
    <input type="hidden" name="actionLogs" id="actionLogs" value="[]">

    <style>
      .option-card {
        cursor: pointer;
        transition: all 0.25s ease;
        border: 1px solid var(--glass-border);
        background: rgba(255, 255, 255, 0.02);
      }

      .option-card:hover {
        background: rgba(255, 255, 255, 0.06) !important;
        border-color: var(--primary)88;
        transform: translateY(-2px);
      }

      .option-card.selected {
        background: rgba(59, 130, 246, 0.1) !important;
        border: 1px solid var(--primary);
        box-shadow: 0 0 15px rgba(59, 130, 246, 0.2);
      }

      .option-badge {
        width: 30px;
        height: 30px;
        background: var(--primary);
        color: #fff;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        margin-right: 15px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.2);
      }
    </style>

    <% for(var i=0 ; i < test.questions.length ; i++ ){ %>
      <div class="glass-card mb-4 p-4">
        <div class="d-flex align-items-start mb-3">
          <span class="badge badge-primary mr-3 p-2">Question <%= i + 1 %></span>
          <h5 class="font-weight-bold mt-1">
            <%= test.questions[i].question %>
          </h5>
        </div>

        <% if(test.questions[i].op1===undefined){ %>
          <div class="form-group mt-3">
            <textarea class="form-control" placeholder="Type your answer here..." name="<%= test.questions[i].ind %>"
              rows="6"></textarea>
          </div>
          <% } else { %>


            <div class="options-grid mt-3 ml-4">
              <!-- Hidden Input to store the selected answer (1-4) -->
              <input type="hidden" name="<%= test.questions[i].ind %>" id="input_<%= i %>" required>

              <div class="row">
                <div class="col-md-6 mb-3">
                  <div class="p-3 rounded option-card h-100 d-flex align-items-center"
                    onclick="selectOption('<%= i %>', 1)" id="q<%= i %>_op1">
                    <div class="option-badge">A</div>
                    <span class="font-weight-bold">
                      <%= test.questions[i].op1 %>
                    </span>
                  </div>
                </div>

                <div class="col-md-6 mb-3">
                  <div class="p-3 rounded option-card h-100 d-flex align-items-center"
                    onclick="selectOption('<%= i %>', 2)" id="q<%= i %>_op2">
                    <div class="option-badge">B</div>
                    <span class="font-weight-bold">
                      <%= test.questions[i].op2 %>
                    </span>
                  </div>
                </div>

                <div class="col-md-6 mb-3">
                  <div class="p-3 rounded option-card h-100 d-flex align-items-center"
                    onclick="selectOption('<%= i %>', 3)" id="q<%= i %>_op3">
                    <div class="option-badge">C</div>
                    <span class="font-weight-bold">
                      <%= test.questions[i].op3 %>
                    </span>
                  </div>
                </div>

                <div class="col-md-6 mb-3">
                  <div class="p-3 rounded option-card h-100 d-flex align-items-center"
                    onclick="selectOption('<%= i %>', 4)" id="q<%= i %>_op4">
                    <div class="option-badge">D</div>
                    <span class="font-weight-bold">
                      <%= test.questions[i].op4 %>
                    </span>
                  </div>
                </div>
              </div>
            </div>
            <% } %>
      </div>
      <% } %>

        <div class="text-center mt-5">
          <button type="submit" class="btn-snoop btn-lg px-5 py-3" id="endTestId"
            style="background: linear-gradient(135deg, #ef4444 0%, #b91c1c 100%);">
            Submit Examination <i class="fas fa-paper-plane ml-2"></i>
          </button>
        </div>
  </form>

  <script>
    var testDuration = document.getElementById('testDuration').value;
    console.log(typeof testDuration);
    testDuration = parseInt(testDuration);
    var countdown = testDuration * 60 * 1000;
    var timerId = setInterval(function () {
      countdown -= 1000;
      var min = Math.floor(countdown / (60 * 1000));
      //var sec = Math.floor(countdown - (min * 60 * 1000));  // wrong
      var sec = Math.floor((countdown - (min * 60 * 1000)) / 1000);  //correct

      if (countdown <= 0) {
        // document.getElementById('testFormID').submit();
        document.getElementById('endTestId').click();
        clearInterval(timerId);
        //doSomething();
      } else {
        document.getElementById('timer').innerHTML = `Time Remaining: ${min} : ${sec}`;
      }

    }, 1000); //1000ms. = 1sec.

    // MCQ Selection Logic
    function selectOption(qIndex, opIndex) {
      // Update Hidden Input (Source of Truth for Form)
      document.getElementById('input_' + qIndex).value = opIndex;

      // Visual Feedback
      // Remove 'selected' from all options of this question
      for (let i = 1; i <= 4; i++) {
        let el = document.getElementById(`q${qIndex}_op${i}`);
        if (el) el.classList.remove('selected');
      }

      // Add 'selected' to clicked option
      document.getElementById(`q${qIndex}_op${opIndex}`).classList.add('selected');
    }

    // Remove warning on form submit
    document.getElementById('testFormID').onsubmit = function () {
      window.onbeforeunload = null;
    };

    // --- STRICT PROCTORING ENFORCEMENT & LOGGING ---

    let isSubmitting = false;
    let tabSwitchLogs = []; 
    let fullscreenLogs = []; 
    let actionLogs = []; // Master list of instant actions (keys, mouse leaves)
    let awayStartTime = null;
    let fullscreenExitStartTime = null;

    // --- REAL-TIME MONITORING (Socket.IO) ---
    // Make sure socket.io is loaded before calling io()
    var socket = null;
    if (typeof io !== 'undefined') {
        socket = io(); // Connect to the WebSocket Server
    } else {
        console.error("Socket.IO client library not found. Real-time reporting disabled.");
    }
    const studentEmail = "<%= email %>";
    const currentTestID = "<%= test.id %>";

    // Join the specific test room immediately
    if (socket) {
        socket.emit('join_test_room', currentTestID);
        // Announce presence to the teacher instantly
        socket.emit('student_joined', { testID: currentTestID, studentEmail: studentEmail });
    }

    // Helper to log events (and emit them in real-time)
    function logEvent(type, startTime, endTime) {
        let duration = (endTime - startTime) / 1000;
        
        const eventData = {
            type: type, 
            startTime: startTime.toISOString(),
            endTime: endTime.toISOString(),
            durationSeconds: duration
        };
        
        if (type === 'TAB_SWITCH') {
            tabSwitchLogs.push(eventData);
        } else if (type === 'FULLSCREEN_EXIT') {
            fullscreenLogs.push(eventData);
        }
        
        updateHiddenInput();

        // Broadcast the violation to the teacher instantly
        if (socket) {
            socket.emit('student_activity', {
                testID: currentTestID,
                studentEmail: studentEmail,
                activityType: type,
                timestamp: new Date().toISOString(),
                details: eventData
            });
        }
    }

    // Helper for instant alerts (doesn't wait for duration like logEvent does)
    function emitInstantViolation(type, msg) {
        if (!isSubmitting) {
            // Log it locally for database
            actionLogs.push({
                type: type,
                message: msg,
                timestamp: new Date().toISOString()
            });
            updateHiddenInput();

            // Broadcast real-time
            if (socket) {
                socket.emit('student_activity', {
                    testID: currentTestID,
                    studentEmail: studentEmail,
                    activityType: type,
                    details: { message: msg },
                    timestamp: new Date().toISOString()
                });
            }
        }
    }

    function updateHiddenInput() {
        let tabInput = document.getElementById('tabSwitchData');
        let fullInput = document.getElementById('fullscreenData');
        let actionInput = document.getElementById('actionLogs');
        
        if(tabInput) {
            tabInput.value = JSON.stringify(tabSwitchLogs);
        }
        if(fullInput) {
            fullInput.value = JSON.stringify(fullscreenLogs);
        }
        if(actionInput) {
            actionInput.value = JSON.stringify(actionLogs);
        }
    }

    // Overlay for Fullscreen Enforcement
    const fullscreenOverlay = document.createElement('div');
    fullscreenOverlay.id = 'fullscreenOverlay';
    fullscreenOverlay.style.cssText = 'position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: #000; z-index: 2000; display: flex; flex-direction: column; align-items: center; justify-content: center; color: white;';
    fullscreenOverlay.innerHTML = `
        <i class="fas fa-expand fa-4x mb-4 text-primary"></i>
        <h2>Fullscreen Mode Required</h2>
        <p class="text-dim mb-4">You must be in fullscreen mode to take this exam.</p>
        <button class="btn-snoop px-5" onclick="enterFullscreen()">Enter Fullscreen & Start</button>
    `;
    document.body.appendChild(fullscreenOverlay);

    function enterFullscreen() {
        const elem = document.documentElement;
        if (elem.requestFullscreen) {
            elem.requestFullscreen().then(() => {
                document.getElementById('fullscreenOverlay').style.display = 'none';
                
                // Show a brief success message
                Swal.fire({
                    icon: 'success',
                    title: 'Environment Locked',
                    text: 'Proctoring is active. Good luck!',
                    timer: 1500,
                    showConfirmButton: false,
                    toast: true,
                    position: 'top-end'
                });

                if (navigator.keyboard && navigator.keyboard.lock) {
                    navigator.keyboard.lock(['Escape']).catch(console.error);
                }
            }).catch(err => {
                console.error("Fullscreen Request Failed:", err);
            });
        }
    }

    // Check Fullscreen on Load
    if (!document.fullscreenElement && !document.webkitFullscreenElement && !document.mozFullScreenElement && !document.msFullscreenElement) {
        document.getElementById('fullscreenOverlay').style.display = 'flex';
    } else {
        document.getElementById('fullscreenOverlay').style.display = 'none';
    }

    // Monitor Fullscreen Changes (Handling all browser prefixes)
    const handleFullscreenChange = () => {
        const isFullscreen = document.fullscreenElement || document.webkitFullscreenElement || document.mozFullScreenElement || document.msFullscreenElement;
        
        if (!isFullscreen && !isSubmitting) {
            // EXITED Fullscreen
            fullscreenExitStartTime = new Date();
            emitInstantViolation('FULLSCREEN_EXIT_INSTANT', 'Exited fullscreen mode');
            
            document.getElementById('fullscreenOverlay').style.display = 'flex';
            Swal.fire({
                icon: 'warning',
                title: 'Fullscreen Exited!',
                text: 'You have left the examination environment. What would you like to do?',
                showDenyButton: true,
                confirmButtonText: 'Return to Test',
                denyButtonText: 'Submit & Finish',
                confirmButtonColor: 'var(--primary)',
                denyButtonColor: '#ef4444',
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then((result) => {
                let fullscreenExitEndTime = new Date();
                
                if (result.isConfirmed) {
                    // Log the exit event before re-entering
                    logEvent('FULLSCREEN_EXIT', fullscreenExitStartTime, fullscreenExitEndTime);
                    enterFullscreen();
                } else if (result.isDenied) {
                    // Log the exit event even if submitting
                    logEvent('FULLSCREEN_EXIT', fullscreenExitStartTime, fullscreenExitEndTime);
                    isSubmitting = true;
                    document.getElementById('testFormID').submit();
                }
            });
        } else {
            // ENTERED Fullscreen
            document.getElementById('fullscreenOverlay').style.display = 'none';
        }
    };

    document.addEventListener('fullscreenchange', handleFullscreenChange);
    document.addEventListener('webkitfullscreenchange', handleFullscreenChange); // Chrome, Safari, Opera
    document.addEventListener('mozfullscreenchange', handleFullscreenChange);    // Firefox
    document.addEventListener('MSFullscreenChange', handleFullscreenChange);     // IE/Edge

    // 1. Disable Right Click
    document.addEventListener('contextmenu', event => {
        event.preventDefault();
        Swal.fire({
            icon: 'error',
            title: 'Action Blocked!',
            text: 'Right-click is restricted during the exam.',
            confirmButtonColor: '#ef4444',
            timer: 2000,
            toast: true,
            position: 'top-end'
        });
    });

    // 2. Disable Copy/Cut/Paste
    document.oncut = document.oncopy = document.onpaste = function(event) {
        event.preventDefault();
        Swal.fire({
            icon: 'error',
            title: 'Action Blocked!',
            text: 'Clipboard operations are restricted.',
            confirmButtonColor: '#ef4444',
            timer: 2000,
            toast: true,
            position: 'top-end'
        });
        return false;
    };

    // 3. Detect Tab Switching (with Type & Duration Tracking)
    document.addEventListener('visibilitychange', function() {
        if (document.hidden && !isSubmitting) {
            // User left the tab
            awayStartTime = new Date();
            emitInstantViolation('TAB_SWITCH_INSTANT', 'Switched tabs or minimized');
            
            Swal.fire({
                icon: 'warning',
                title: 'Tab Switching Detected!',
                text: 'Moving away from the test window is prohibited. This incident has been recorded.',
                confirmButtonColor: '#ef4444',
                confirmButtonText: 'I Understand',
                allowOutsideClick: false,
                allowEscapeKey: false
            });
        } else if (!document.hidden && awayStartTime) {
            // User returned
            let awayEndTime = new Date();
            logEvent('TAB_SWITCH', awayStartTime, awayEndTime);
            awayStartTime = null; // Reset
        }
    });

    // Detect Window Focus Loss (Mini windows or Overlays)
    window.addEventListener('blur', function() {
        if (!isSubmitting) {
            emitInstantViolation('WINDOW_BLUR', 'Lost window focus');
            // We can treat this as a tab switch for DB logging as well
            if (!awayStartTime) {
                awayStartTime = new Date();
            }
        }
    });

    window.addEventListener('focus', function() {
        if (!isSubmitting && awayStartTime && !document.hidden) {
            let awayEndTime = new Date();
            logEvent('TAB_SWITCH', awayStartTime, awayEndTime);
            awayStartTime = null;
        }
    });

    // Detect Mouse Leaving the Window (Moving out of viewport)
    document.addEventListener('mouseleave', function(e) {
        if (!isSubmitting) {
            if (e.clientY <= 0 || e.clientX <= 0 || (e.clientX >= window.innerWidth || e.clientY >= window.innerHeight)) {
                emitInstantViolation('MOUSE_LEAVE', 'Cursor left the test window');
            }
        }
    });

    // Handle Submit Button Click (Ensures warnings are suppressed)
    document.getElementById('endTestId').onclick = function() {
        if (!isSubmitting && socket) {
            socket.emit('student_submitted', { testID: currentTestID, studentEmail: studentEmail });
        }
        isSubmitting = true;
    };

    // Ensure form submit also sets flag (covers creating programmatic submits)
    const originalSubmit = document.getElementById('testFormID').submit;
    document.getElementById('testFormID').submit = function() {
        isSubmitting = true;
        originalSubmit.apply(this);
    };
    
    // Also listen to the actual submit event
    document.getElementById('testFormID').addEventListener('submit', function() {
        if (!isSubmitting && socket) {
            socket.emit('student_submitted', { testID: currentTestID, studentEmail: studentEmail });
        }
        isSubmitting = true;
    });

    // Navigation Lockdown (Back Button Intercept)
    window.onload = function () {
      // 1. Trap Back Button
      history.pushState(null, null, location.href);
      window.onpopstate = function () {
        history.pushState(null, null, location.href); // Immediately re-trap the state
        Swal.fire({
            title: 'Leave Exam?',
            text: "Do you want to submit your test and leave?",
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Yes, Submit & Leave',
            cancelButtonText: 'No, Stay',
            confirmButtonColor: '#ef4444', 
            cancelButtonColor: 'var(--primary)',
            reverseButtons: true
        }).then((result) => {
            if (result.isConfirmed) {
                isSubmitting = true;
                document.getElementById('testFormID').submit();
            }
        });
      };
      
      // 2. Auto-Submit on Reload/Close
      window.onbeforeunload = function () {
        if (!isSubmitting) {
            // User is trying to reload or close
            isSubmitting = true; // Prevent loop
            
            // Collect Form Data
            const form = document.getElementById('testFormID');
            const formData = new FormData(form);
            const searchParams = new URLSearchParams(formData);

            // Use fetch with keepalive to ensure request completes even after unload
            fetch('/student/submitTest', {
                method: 'POST',
                body: searchParams,
                keepalive: true
            }).catch(err => console.error("Auto-submit failed:", err));
            
            // Allow the reload/close to happen (which will hit GET /startExam -> redirect to Home)
            // Returning null suppresses the confirmation dialog
            return null; 
        }
      };
    };

    // Handle Timer Auto-Submit
    // (Note: The timer logic uses click() on endTestId, so it is covered)

    // Aggressive capture phase listeners to completely kill restricted keys before ANY element or popup gets them
    const blockKeys = function(e) {
        let keyChar = e.key ? e.key.toLowerCase() : '';
        
        // Block F11 and F12
        if (e.key === 'F11' || e.keyCode === 122 || e.key === 'F12' || e.keyCode === 123) {
            e.preventDefault();
            e.stopPropagation();
            if (e.type === 'keydown') {
                emitInstantViolation('PROHIBITED_KEY', e.key);
                Swal.fire({
                    icon: 'error',
                    title: 'Function Keys Disabled',
                    text: 'F11 and F12 shortcuts are strictly prohibited.',
                    confirmButtonColor: '#ef4444',
                    timer: 2000,
                    toast: true,
                    position: 'top-end'
                });
            }
            return false;
        }

        // Block Escape
        if (e.key === 'Escape' || e.keyCode === 27) {
            e.preventDefault();
            e.stopPropagation();
            if (e.type === 'keydown' && document.fullscreenElement) {
                emitInstantViolation('PROHIBITED_KEY', 'Escape');
                Swal.fire({
                    icon: 'warning',
                    title: 'Escape Key Restricted',
                    text: 'Please use the Submit button to exit the test.',
                    confirmButtonColor: 'var(--primary)',
                    timer: 3000,
                    toast: true,
                    position: 'top-end'
                });
            }
            return false;
        }

        // Block Alt and Windows(Meta) Keys
        if (e.altKey || e.metaKey || e.key === 'Meta' || e.key === 'OS') {
            e.preventDefault();
            e.stopPropagation();
            if (e.type === 'keydown') {
                let keyName = e.altKey ? 'Alt Key' : 'Windows/System Key';
                emitInstantViolation('PROHIBITED_KEY', keyName);
                Swal.fire({
                    icon: 'error',
                    title: 'Action Blocked!',
                    text: `${keyName} combinations are strictly prohibited.`,
                    confirmButtonColor: '#ef4444',
                    timer: 2000,
                    toast: true,
                    position: 'top-end'
                });
            }
            return false;
        }

        // Block ALL Ctrl combinations and DevTools (Ctrl+Shift+I/J/C)
        if (e.ctrlKey) { 
            e.preventDefault();
            e.stopPropagation();
            if (e.type === 'keydown') {
                emitInstantViolation('PROHIBITED_KEY', 'Ctrl Combination');
                Swal.fire({
                    icon: 'error',
                    title: 'Action Blocked!',
                    text: 'Control key shortcuts are strictly prohibited.',
                    confirmButtonColor: '#ef4444',
                    timer: 2000,
                    toast: true,
                    position: 'top-end'
                });
            }
            return false;
        }
    };

    window.addEventListener('keydown', blockKeys, true); // true = capture phase
    window.addEventListener('keyup', blockKeys, true);
    window.addEventListener('keypress', blockKeys, true);
  </script>