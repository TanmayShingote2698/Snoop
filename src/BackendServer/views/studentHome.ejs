<div class="text-center mb-5">
  <h2 class="font-weight-bold">Student Dashboard</h2>
  <p class="text-dim">Welcome, <%= email %>
  </p>
</div>

<div class="row justify-content-center">
  <div class="col-md-4 mb-4">
    <div class="glass-card h-100 d-flex flex-column align-items-center text-center">
      <i class="fas fa-search fa-3x mb-4" style="color: #f59e0b;"></i>
      <h4>Join Test by ID</h4>
      <p class="text-dim mb-4">Have a specific Test ID? Enter it below to start immediately.</p>
      <form action="/student/takeTest" method="POST" class="mt-auto w-100">
        <input type="hidden" name="email" value="<%= email %>">
        <div class="form-group">
            <input type="text" name="testID" class="form-control text-center" placeholder="Enter Test ID" required style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); color: white;">
        </div>
        <div class="form-group">
            <input type="password" name="accessCode" class="form-control text-center" placeholder="Access Code" required style="background: rgba(255,255,255,0.05); border: 1px solid var(--glass-border); color: white;">
        </div>
        <button type="submit" class="btn-snoop w-100 justify-content-center">
          Start Test <i class="fas fa-arrow-right ml-2"></i>
        </button>
      </form>
    </div>
  </div>

  <div class="col-md-4 mb-4">
    <div class="glass-card h-100 d-flex flex-column align-items-center text-center">
      <i class="fas fa-poll fa-3x mb-4" style="color: #3b82f6;"></i>
      <h4>Quick Results</h4>
      <p class="text-dim mb-4">Instantly view your performance and feedback from previous tests.</p>
      <a href="/student/GetResultByEmail" class="btn-snoop w-100 justify-content-center mt-auto">
        Check Results <i class="fas fa-chart-line"></i>
      </a>
    </div>
  </div>


</div>