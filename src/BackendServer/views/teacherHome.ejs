<div class="text-center mb-5">
  <h2 class="font-weight-bold">Faculty Dashboard</h2>
  <p class="text-dim">Manage examinations and monitor students here.</p>
</div>

<div class="row justify-content-center">
  <div class="col-md-4 mb-4">
    <div class="glass-card h-100 d-flex flex-column align-items-center text-center">
      <i class="fas fa-list-ul fa-3x mb-4" style="color: var(--primary);"></i>
      <h4>View All Tests</h4>
      <p class="text-dim mb-4">Monitor and manage all previously created tests.</p>
      <a href="/teacher/showAllTests" class="btn-snoop w-100 justify-content-center mt-auto">
        Show All Tests <i class="fas fa-search"></i>
      </a>
    </div>
  </div>

  <div class="col-md-4 mb-4">
    <div class="glass-card h-100 d-flex flex-column align-items-center text-center">
      <i class="fas fa-plus-circle fa-3x mb-4" style="color: var(--secondary);"></i>
      <h4>Create Test</h4>
      <p class="text-dim mb-4">Design new assessments and schedule examination sessions.</p>
      <a href="/teacher/enterTestID" class="btn-snoop w-100 justify-content-center mt-auto">
        Create New Test <i class="fas fa-plus"></i>
      </a>
    </div>
  </div>
</div>