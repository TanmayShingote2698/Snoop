<div class="container-fluid px-4" style="margin-top: 5px;">
    <div class="row g-3"> <!-- Removed my-2 -->
        
        <!-- CARD 1: TOTAL / CREATE TEST -->
        <div class="col-md-4 mb-4">
            <a href="/teacher/enterTestID" class="text-decoration-none">
                <div class="p-4 glass-card card-blue d-flex flex-column justify-content-between h-100" style="min-height: 225px;">
                    <div class="d-flex justify-content-between align-items-start w-100">
                        <h3 class="fs-2 fw-bold m-0" style="color: var(--text-main);"><%= stats.total %></h3>
                        <div style="background: rgba(59,130,246,0.1); border-radius: 16px; width: 60px; height: 60px; display: flex; align-items: center; justify-content: center;">
                            <i class="fas fa-plus fs-2" style="color: #3b82f6;"></i>
                        </div>
                    </div>
                    <div class="mt-3">
                        <p class="fs-5 m-0" style="color: var(--text-dim);">Create New Test</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- CARD 2: UPCOMING -->
        <div class="col-md-4 mb-4">
            <a href="/teacher/showAllTests?filter=upcoming" class="text-decoration-none">
                <div class="p-4 glass-card card-green d-flex flex-column justify-content-between h-100" style="min-height: 225px;">
                    <div class="d-flex justify-content-between align-items-start w-100">
                        <h3 class="fs-2 fw-bold m-0" style="color: var(--text-main);"><%= stats.upcoming %></h3>
                        <div style="background: rgba(16,185,129,0.1); border-radius: 16px; width: 60px; height: 60px; display: flex; align-items: center; justify-content: center;">
                            <i class="fas fa-calendar-alt fs-2" style="color: #10b981;"></i>
                        </div>
                    </div>
                    <div class="mt-3">
                        <p class="fs-5 m-0" style="color: var(--text-dim);">Upcoming Tests</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- CARD 3: ONGOING -->
        <div class="col-md-4 mb-4">
            <a href="/teacher/showAllTests?filter=ongoing" class="text-decoration-none">
                <div class="p-4 glass-card card-orange d-flex flex-column justify-content-between h-100" style="min-height: 225px;">
                    <div class="d-flex justify-content-between align-items-start w-100">
                        <h3 class="fs-2 fw-bold m-0" style="color: var(--text-main);"><%= stats.ongoing %></h3>
                        <div style="background: rgba(245,158,11,0.1); border-radius: 16px; width: 60px; height: 60px; display: flex; align-items: center; justify-content: center;">
                            <i class="fas fa-clock fs-2" style="color: #f59e0b;"></i>
                        </div>
                    </div>
                    <div class="mt-3">
                        <p class="fs-5 m-0" style="color: var(--text-dim);">Ongoing Exams</p>
                    </div>
                </div>
            </a>
        </div>
        
        <!-- CARD 4: COMPLETED -->
        <div class="col-md-6 mb-4">
            <a href="/teacher/showAllTests?filter=completed" class="text-decoration-none">
                <div class="p-4 glass-card card-purple d-flex flex-column justify-content-between h-100" style="min-height: 225px;">
                    <div class="d-flex justify-content-between align-items-start w-100">
                        <h3 class="fs-2 fw-bold m-0" style="color: var(--text-main);"><%= stats.completed %></h3>
                        <div style="background: rgba(139,92,246,0.1); border-radius: 16px; width: 60px; height: 60px; display: flex; align-items: center; justify-content: center;">
                            <i class="fas fa-check fs-2" style="color: #8b5cf6;"></i>
                        </div>
                    </div>
                    <div class="mt-3">
                        <p class="fs-5 m-0" style="color: var(--text-dim);">Completed Tests</p>
                    </div>
                </div>
            </a>
        </div>
        
         <!-- CARD 5: RESULTS -->
         <div class="col-md-6 mb-4">
            <a href="/teacher/showAllTests?filter=completed" class="text-decoration-none"> <!-- Link to Results Page -->
                <div class="p-4 glass-card card-pink d-flex flex-column justify-content-between h-100" style="min-height: 225px;">
                    <div class="d-flex justify-content-between align-items-start w-100">
                        <h3 class="fs-2 fw-bold m-0" style="color: var(--text-main);">Results</h3>
                        <div style="background: rgba(212,16,170,0.1); border-radius: 16px; width: 60px; height: 60px; display: flex; align-items: center; justify-content: center;">
                            <i class="fas fa-chart-bar fs-2" style="color: var(--primary);"></i>
                        </div>
                    </div>
                    <div class="mt-3">
                        <p class="fs-5 m-0" style="color: var(--text-dim);">View Analytics</p>
                    </div>
                </div>
            </a>
        </div>

    </div>
    
    <div class="row">
        <div class="col-12 mt-4">
            <h4 class="mb-3" style="color: var(--text-main);">Recent Activity</h4>
            <div>
                <div class="row align-items-center mb-2 px-3 py-2 mx-0 d-none d-md-flex text-uppercase font-weight-bold" style="color: var(--primary); font-size: 0.85rem; letter-spacing: 0.5px;">
                    <div class="col-md-1">#</div>
                    <div class="col-md-3">Test ID</div>
                    <div class="col-md-3">Status</div>
                    <div class="col-md-3">Start Time</div>
                    <div class="col-md-2 text-right">Duration</div>
                </div>

                <% if (recentTests && recentTests.length > 0) { %>
                    <% recentTests.forEach((test, i) => { %>
                        <div class="row align-items-center mb-3 px-3 py-3 mx-0 cursor-pointer snoop-row-card">
                            <div class="col-md-1 font-weight-bold" style="color: var(--text-dim);"><%= i + 1 %></div>
                            <div class="col-md-3 font-weight-bold" style="color: var(--text-main); font-size: 1.05rem;"><%= test.id %></div>
                            <div class="col-md-3">
                                <% if (test.status === 'upcoming') { %>
                                    <span class="badge badge-pill py-1 px-3" style="background: rgba(16,185,129,0.1); color: #10b981; border: 1px solid #10b981; font-size: 0.75rem;">
                                        <i class="fas fa-calendar-alt mr-1"></i> Upcoming
                                    </span>
                                    <small class="d-block mt-1 font-weight-bold text-dim"><%= test.timeInfo %></small>
                                <% } else if (test.status === 'ongoing') { %>
                                    <span class="badge badge-pill py-1 px-3" style="background: rgba(245,158,11,0.1); color: #f59e0b; border: 1px solid #f59e0b; font-size: 0.75rem;">
                                        <i class="fas fa-clock mr-1"></i> Ongoing
                                    </span>
                                    <small class="d-block mt-1 font-weight-bold text-dim"><%= test.timeInfo %></small>
                                <% } else if (test.status === 'completed') { %>
                                    <span class="badge badge-pill py-1 px-3" style="background: rgba(139,92,246,0.1); color: #8b5cf6; border: 1px solid #8b5cf6; font-size: 0.75rem;">
                                        <i class="fas fa-check mr-1"></i> Completed
                                    </span>
                                    <small class="d-block mt-1 font-weight-bold text-dim"><%= test.timeInfo %></small>
                                <% } else { %>
                                    <span class="badge badge-pill badge-secondary py-1 px-3" style="font-size: 0.75rem;">Unknown</span>
                                <% } %>
                            </div>
                            <div class="col-md-3 font-weight-bold" style="color: var(--text-main); font-size: 0.95rem;">
                                <i class="far fa-clock text-dim mr-1"></i> <%= test.startTime %>
                            </div>
                            <div class="col-md-2 text-right font-weight-bold" style="color: var(--text-main); font-size: 0.95rem;">
                                <%= test.duration %> min
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div class="d-flex align-items-center justify-content-center px-4 py-5" style="border: 2px dashed var(--glass-border); border-radius: 10px; background: transparent;">
                        <i class="fas fa-chart-line text-dim mr-3 fa-2x"></i>
                        <span class="text-dim" style="font-size: 1.1rem;">No recent activity to display.</span>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-white-glass {
        background: rgba(255,255,255,0.25);
        backdrop-filter: blur(5px);
        -webkit-backdrop-filter: blur(5px);
        border-radius: 16px; /* Squircle */
        width: 60px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: inset 0 0 10px rgba(255,255,255,0.1);
    }
</style>