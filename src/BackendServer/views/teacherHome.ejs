<div class="container-fluid px-4">
    <div class="row g-3"> <!-- Removed my-2 -->
        
        <!-- CARD 1: TOTAL / CREATE TEST -->
        <div class="col-md-4 mb-4">
            <a href="/teacher/enterTestID" class="text-decoration-none">
                <div class="p-4 glass-card d-flex flex-column justify-content-between shadow-sm h-100" style="min-height: 225px; background: linear-gradient(135deg, rgba(0, 217, 255, 1) 0%, rgb(136, 229, 255) 100%);">
                    <div class="d-flex justify-content-between align-items-start w-100">
                        <h3 class="fs-2 text-white fw-bold m-0"><%= stats.total %></h3>
                        <div class="bg-white-glass">
                            <i class="fas fa-plus fs-2 text-white"></i>
                        </div>
                    </div>
                    <div class="mt-3">
                        <p class="fs-5 text-white-50 m-0">Create New Test</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- CARD 2: UPCOMING -->
        <div class="col-md-4 mb-4">
            <a href="/teacher/showAllTests?filter=upcoming" class="text-decoration-none">
                <div class="p-4 glass-card d-flex flex-column justify-content-between shadow-sm h-100" style="min-height: 225px; background: linear-gradient(135deg, rgba(52, 211, 153, 0.85) 0%, rgba(5, 150, 105, 0.85) 100%);">
                    <div class="d-flex justify-content-between align-items-start w-100">
                        <h3 class="fs-2 text-white fw-bold m-0"><%= stats.upcoming %></h3>
                        <div class="bg-white-glass">
                            <i class="fas fa-calendar-alt fs-2 text-white"></i>
                        </div>
                    </div>
                    <div class="mt-3">
                        <p class="fs-5 text-white-50 m-0">Upcoming Tests</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- CARD 3: ONGOING -->
        <div class="col-md-4 mb-4">
            <a href="/teacher/showAllTests?filter=ongoing" class="text-decoration-none">
                <div class="p-4 glass-card d-flex flex-column justify-content-between shadow-sm h-100" style="min-height: 225px; background: linear-gradient(135deg, rgba(251, 191, 36, 0.85) 0%, rgba(217, 119, 6, 0.85) 100%);">
                    <div class="d-flex justify-content-between align-items-start w-100">
                        <h3 class="fs-2 text-white fw-bold m-0"><%= stats.ongoing %></h3>
                        <div class="bg-white-glass">
                            <i class="fas fa-clock fs-2 text-white"></i>
                        </div>
                    </div>
                    <div class="mt-3">
                        <p class="fs-5 text-white-50 m-0">Ongoing Exams</p>
                    </div>
                </div>
            </a>
        </div>
        
        <!-- CARD 4: COMPLETED -->
        <div class="col-md-6 mb-4">
            <a href="/teacher/showAllTests?filter=completed" class="text-decoration-none">
                <div class="p-4 glass-card d-flex flex-column justify-content-between shadow-sm h-100" style="min-height: 225px; background: linear-gradient(135deg, rgba(139, 92, 246, 0.85) 0%, rgba(99, 102, 241, 0.85) 100%);">
                    <div class="d-flex justify-content-between align-items-start w-100">
                        <h3 class="fs-2 text-white fw-bold m-0"><%= stats.completed %></h3>
                        <div class="bg-white-glass">
                            <i class="fas fa-check fs-2 text-white"></i>
                        </div>
                    </div>
                    <div class="mt-3">
                        <p class="fs-5 text-white-50 m-0">Completed Tests</p>
                    </div>
                </div>
            </a>
        </div>
        
         <!-- CARD 5: RESULTS -->
         <div class="col-md-6 mb-4">
            <a href="#" class="text-decoration-none"> <!-- Link to Results Page -->
                <div class="p-4 glass-card d-flex flex-column justify-content-between shadow-sm h-100" style="min-height: 225px; background: linear-gradient(135deg, rgba(244, 114, 182, 0.85) 0%, rgba(219, 39, 119, 0.85) 100%);">
                    <div class="d-flex justify-content-between align-items-start w-100">
                        <h3 class="fs-2 text-white fw-bold m-0">Results</h3>
                        <div class="bg-white-glass">
                            <i class="fas fa-chart-bar fs-2 text-white"></i>
                        </div>
                    </div>
                    <div class="mt-3">
                        <p class="fs-5 text-white-50 m-0">View Analytics</p>
                    </div>
                </div>
            </a>
        </div>

    </div>
    
    <div class="row">
        <div class="col-12 mt-4">
            <h4 class="mb-3" style="color: var(--text-main);">Recent Activity</h4>
            <div class="table-responsive glass-card p-0">
                <table class="table mb-0 table-hover" style="color: var(--text-main);">
                    <thead>
                        <tr style="background: rgba(255,255,255,0.05);">
                            <th scope="col" width="50">#</th>
                            <th scope="col">Test ID</th>
                            <th scope="col">Status</th>
                            <th scope="col">Start Time</th>
                            <th scope="col">Duration</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (recentTests && recentTests.length > 0) { %>
                            <% recentTests.forEach((test, i) => { %>
                                <tr>
                                    <td><%= i + 1 %></td>
                                    <td><strong><%= test.id %></strong></td>
                                    <td>
                                        <% if (test.status === 'upcoming') { %>
                                            <span class="badge" style="background: rgba(52, 211, 153, 0.2); color: #34d399; padding: 6px 12px; border-radius: 20px; font-size: 0.8rem;">
                                                <i class="fas fa-clock mr-1"></i> Upcoming
                                            </span>
                                            <small class="d-block mt-1" style="color: var(--text-dim);"><%= test.timeInfo %></small>
                                        <% } else if (test.status === 'ongoing') { %>
                                            <span class="badge" style="background: rgba(251, 191, 36, 0.2); color: #fbbf24; padding: 6px 12px; border-radius: 20px; font-size: 0.8rem;">
                                                <i class="fas fa-play mr-1"></i> Ongoing
                                            </span>
                                            <small class="d-block mt-1" style="color: var(--text-dim);"><%= test.timeInfo %></small>
                                        <% } else if (test.status === 'completed') { %>
                                            <span class="badge" style="background: rgba(99, 102, 241, 0.2); color: #818cf8; padding: 6px 12px; border-radius: 20px; font-size: 0.8rem;">
                                                <i class="fas fa-check mr-1"></i> Completed
                                            </span>
                                            <small class="d-block mt-1" style="color: var(--text-dim);"><%= test.timeInfo %></small>
                                        <% } else { %>
                                            <span class="badge badge-secondary" style="padding: 6px 12px; border-radius: 20px; font-size: 0.8rem;">Unknown</span>
                                        <% } %>
                                    </td>
                                    <td><%= test.startTime %></td>
                                    <td><%= test.duration %> min</td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" class="text-center py-4" style="color: var(--text-dim);">
                                    No recent activity to display.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-white-glass {
        background: rgba(255,255,255,0.25);
        backdrop-filter: blur(5px);
        -webkit-backdrop-filter: blur(5px);
        border-radius: 16px; /* Squircle */
        width: 60px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: inset 0 0 10px rgba(255,255,255,0.1);
    }
</style>