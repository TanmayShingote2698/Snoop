  <style>
      :root {
          --header-height: 55px; /* Adjust based on navbar content+padding */
      }
      
      /* Navbar Adjustment */
      .navbar-snoop {
           height: var(--header-height);
           padding: 0.5rem 1.5rem; /* Re-added top/bottom padding */
           background: rgba(255, 255, 255, 0.8); /* Lighter Transparent */
           backdrop-filter: blur(20px); /* Frost Effect */
           -webkit-backdrop-filter: blur(20px);
           border-bottom: 1px solid var(--glass-border);
      }

      /* Sidebar Styles */
      #wrapper {
          overflow-x: hidden;
          min-height: calc(100vh - var(--header-height));
          margin-top: var(--header-height); /* Push content down */
      }
      
      #sidebar-wrapper {
          min-height: calc(100vh - var(--header-height));
          margin-left: -15rem;
          transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
          background: var(--bg-card);
          backdrop-filter: blur(20px);
          border-right: 1px solid var(--glass-border);
          width: 15rem;
          position: fixed; 
          top: var(--header-height); /* Start below header */
          bottom: 0;
          z-index: 999;
          overflow-y: auto;
          overflow-x: hidden;
      }
      
      /* Custom Slim Scrollbar for Entire Website (Chrome/Safari/Edge) */
      ::-webkit-scrollbar {
          width: 5px;
          height: 5px;
      }
      ::-webkit-scrollbar-track {
          background: transparent;
      }
      ::-webkit-scrollbar-thumb {
          background: rgba(212, 16, 170, 0.4); /* Primary pink */
          border-radius: 10px;
      }
      ::-webkit-scrollbar-thumb:hover {
          background: rgba(212, 16, 170, 0.7);
      }
      
      #sidebar-wrapper .list-group {
          width: 100%; /* Fill the sidebar container */
      }
      
      #page-content-wrapper {
          min-width: 100vw;
          transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
          margin-left: 0; 
      }
      
      .sidebar-active#page-content-wrapper {
          min-width: 0;
      }
      
      /* Toggled State: Show Sidebar */
      #wrapper.toggled #sidebar-wrapper {
          margin-left: 0;
      }
      
      /* Desktop: Sidebar Visible by Default */
      @media (min-width: 768px) {
          #sidebar-wrapper {
              margin-left: 0; /* Visible */
              width: 15rem;
          }
      
          .sidebar-active #page-content-wrapper {
              min-width: 0;
              width: 100%;
              margin-left: 15rem; /* Push content to right of sidebar */
          }
      
          /* Collapsed Mode for Desktop (Icons Only) */
          #wrapper.toggled #sidebar-wrapper {
              margin-left: 0; 
              width: 5rem; /* Shrink width */
          }
          
          .sidebar-active#wrapper.toggled #page-content-wrapper {
              margin-left: 5rem; /* Adjust content margin when collapsed */
          }

          /* Hide Text */
          #wrapper.toggled .sidebar-text {
             display: none !important;
          }
          
          /* Adjust List Items for Icon Only */
          #wrapper.toggled .list-group-item {
              text-align: center;
              padding: 1.25rem 0;
              justify-content: center !important; /* Center flex items */
          }
          
          #wrapper.toggled .sidebar-bottom-link {
              padding: 1.25rem 0 !important;
          }
          
          /* Remove Margin from Icon when collapsed */
          #wrapper.toggled .list-group-item i {
              margin-right: 0 !important;
              font-size: 1.2rem;
          }

          /* Handle Top Toggle */
          #wrapper.toggled #sidebar-toggle-container {
              justify-content: center !important;
              padding-left: 0 !important;
              padding-right: 0 !important;
          }

          /* Handle Bottom Profile Picture */
          #wrapper.toggled .sidebar-identity {
              justify-content: center !important;
              padding-left: 0 !important;
              padding-right: 0 !important;
          }
          
          #wrapper.toggled .sidebar-identity img {
              margin-right: 0 !important;
          }
      }

      /* Sidebar Links */
      .list-group-item {
          border: none;
          padding: 16px 25px;
          color: var(--text-dim);
          font-weight: 500;
          transition: all 0.3s;
          display: flex;
          align-items: center;
      }

      .sidebar-bottom-link {
          padding-top: 0.75rem;
          padding-bottom: 0.75rem;
      }
      
      .list-group-item:hover {
          color: var(--primary);
          background: rgba(255, 255, 255, 0.05) !important;
          border-left: 4px solid var(--primary); /* Indicator on left */
      }
      
      .list-group-item.active {
          background-color: transparent;
          color: var(--primary);
          font-weight: bold;
          border-left: 4px solid var(--primary);
          border-right: none;
      }
      
      /* Toggle Button Adjustment in Collapsed Mode */
      @media (min-width: 768px) {
          #wrapper.toggled #sidebar-toggle-container {
              justify-content: center !important;
          }
      }
      
      /* Menu Toggle Button */
      #menu-toggle {
          padding: 8px;
          background: transparent;
          color: var(--text-dim);
          border-radius: 8px;
          transition: all 0.3s ease;
          width: 35px;
          height: 35px;
          display: flex;
          align-items: center;
          justify-content: center;
      }
      #menu-toggle:hover {
          background: rgba(59, 130, 246, 0.1);
          color: var(--primary);
      }
  </style>

  <script>
    // Menu Toggle Script
    document.addEventListener("DOMContentLoaded", function () {
        const el = document.getElementById("wrapper");
        const toggleButton = document.getElementById("menu-toggle");
        const toggleIcon = document.getElementById("toggle-icon");
        
        // Load Saved State
        const savedState = localStorage.getItem('sidebarState');
        if (savedState === 'toggled') {
            el.classList.add("toggled");
            if (toggleIcon) {
                toggleIcon.classList.remove("fa-chevron-left");
                toggleIcon.classList.add("fa-bars");
            }
        }

        if (toggleButton) {
            toggleButton.onclick = function () {
                el.classList.toggle("toggled");
                
                // Icon Logic
                if (el.classList.contains("toggled")) {
                    // Collapsed -> Show Hamburger (to expand)
                    toggleIcon.classList.remove("fa-chevron-left");
                    toggleIcon.classList.add("fa-bars"); 
                    localStorage.setItem('sidebarState', 'toggled');
                } else {
                    // Expanded -> Show Arrow Left (to collapse)
                    toggleIcon.classList.remove("fa-bars");
                    toggleIcon.classList.add("fa-chevron-left");
                    localStorage.setItem('sidebarState', 'expanded');
                }
            };
        }
    });
  </script>

