<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Snoop - Smart Proctoring</title>
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/assets/favicon/favicon.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="64x64" href="/assets/favicon/favicon-64x64.png">
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <!-- Bootstrap 4 -->
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/css/bootstrap.min.css"
    integrity="sha384-Vkoo8x4CGsO3+Hhxv8T/Q5PaXtkKtu6ug5TOeNV6gBiFeWPGFN9MuhOf23Q9Ifjh" crossorigin="anonymous" />

  <style>
    :root {
      --bg-dark: #F5F5F5;
      --bg-card: rgba(255, 255, 255, 0.85);
      --bg-start: #F5F5F5;
      --bg-end: #E5E5E5;
      --bg-input: #FFFFFF;
      --primary: #D410AA;
      --secondary: #b0078a;
      --text-main: #1A1A1A;
      --text-dim: #242424;
      --glass-border: rgba(212, 16, 170, 0.2);
    }

    body {
      font-family: 'Poppins', sans-serif;
      background: linear-gradient(135deg, var(--bg-start) 0%, var(--bg-end) 100%);
      color: var(--text-main);
      min-height: 100vh;
      margin: 0;
      overflow-x: hidden;
      display: flex;
      flex-direction: column;
      scrollbar-width: thin; /* Firefox global scrollbar */
      scrollbar-color: rgba(212, 16, 170, 0.3) transparent; /* Firefox */
    }

    /* ... code omitted ... */

    .form-control {
      background: var(--bg-input) !important;
      border: 1px solid var(--glass-border) !important;
      color: var(--text-main) !important;
      border-radius: 0.75rem !important;
      padding: 0.75rem 1.25rem !important;
      transition: all 0.3s ease !important;
    }

    .form-control:focus {
      border-color: var(--primary) !important;
      box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.25) !important; /* Blue Focus Ring */
      background: var(--bg-input) !important; /* Keep consistent on focus */
      filter: brightness(1.2);
    }

    /* ... code omitted ... */



    .navbar-snoop {
      background: rgba(255, 255, 255, 0.7);
      backdrop-filter: blur(5px) saturate(180%);
      -webkit-backdrop-filter: blur(5px) saturate(180%);
      border-bottom: 1px solid var(--glass-border);
      padding: 0.4rem 1.5rem;
      position: sticky;
      top: 0;
      z-index: 1000;
    }


    .navbar-brand-snoop {
      font-weight: 700;
      font-size: 1.5rem;
      background: linear-gradient(to right, var(--primary), var(--secondary));
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      text-decoration: none;
    }

    .main-container {
      padding: 0 1rem; /* Removed top padding */
      max-width: 1200px;
      margin: auto;
      animation: fadeIn 0.5s ease-out;
      flex: 1; /* Pushes footer down */
      width: 100%;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(10px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .glass-card {
      background: linear-gradient(135deg, rgba(212,16,170,0.05) 0%, rgba(59,130,246,0.05) 100%);
      backdrop-filter: blur(10px);
      border: 2px solid transparent;
      border-radius: 20px;
      padding: 2rem;
      transition: all 0.3s ease;
    }

    .glass-card:hover {
      transform: scale(1.01);
      box-shadow: 0 10px 25px rgba(212, 16, 170, 0.15);
      border-color: var(--primary);
    }

    .form-control {
      background: var(--bg-input) !important;
      border: 1px solid var(--glass-border) !important;
      color: var(--text-main) !important;
      border-radius: 0.75rem !important;
      padding: 0.75rem 1.25rem !important;
      transition: all 0.3s ease !important;
    }

    .form-control:focus {
      border-color: var(--primary) !important;
      box-shadow: 0 0 0 2px rgba(56, 189, 248, 0.2) !important;
      background: var(--bg-input) !important;
      filter: brightness(1.2);
    }

    /* Dashboard Card Variations */
    .card-pink {
      background: linear-gradient(135deg, rgba(212,16,170,0.05) 0%, rgba(212,16,170,0.01) 100%);
    }
    .card-pink:hover {
      border-color: var(--primary) !important;
      box-shadow: 0 10px 25px rgba(212, 16, 170, 0.15) !important;
      transform: scale(1.02) !important;
    }

    .card-blue {
      background: linear-gradient(135deg, rgba(59,130,246,0.05) 0%, rgba(59,130,246,0.01) 100%);
    }
    .card-blue:hover {
      border-color: #3b82f6 !important;
      box-shadow: 0 10px 25px rgba(59, 130, 246, 0.15) !important;
      transform: scale(1.02) !important;
    }

    .card-green {
      background: linear-gradient(135deg, rgba(16,185,129,0.05) 0%, rgba(16,185,129,0.01) 100%);
    }
    .card-green:hover {
      border-color: #10b981 !important;
      box-shadow: 0 10px 25px rgba(16, 185, 129, 0.15) !important;
      transform: scale(1.02) !important;
    }

    .card-orange {
      background: linear-gradient(135deg, rgba(245,158,11,0.05) 0%, rgba(245,158,11,0.01) 100%);
    }
    .card-orange:hover {
      border-color: #f59e0b !important;
      box-shadow: 0 10px 25px rgba(245, 158, 11, 0.15) !important;
      transform: scale(1.02) !important;
    }

    .card-purple {
      background: linear-gradient(135deg, rgba(139,92,246,0.05) 0%, rgba(139,92,246,0.01) 100%);
    }
    .card-purple:hover {
      border-color: #8b5cf6 !important;
      box-shadow: 0 10px 25px rgba(139, 92, 246, 0.15) !important;
      transform: scale(1.02) !important;
    }

    /* List Row Cards (Recent Activity / History) */
    .snoop-row-card {
      border-radius: 12px;
      background: linear-gradient(135deg, rgba(212,16,170,0.03) 0%, rgba(59,130,246,0.03) 100%);
      transition: all 0.3s ease;
      border: 1px solid transparent;
    }

    .snoop-row-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 15px rgba(212,16,170,0.1);
      border-color: rgba(212,16,170,0.2);
    }

    .btn-snoop {
      background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
      border: none;
      color: white !important;
      padding: 0.75rem 1.5rem;
      border-radius: 0.75rem;
      font-weight: 600;
      transition: all 0.3s ease;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      text-decoration: none !important;
    }

    .btn-snoop:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(56, 189, 248, 0.3);
      filter: brightness(1.1);
      color: white !important;
    }

    /* New Glass Button for Secondary Actions (Back/Cancel) */
    .btn-glass {
        background: var(--bg-card) !important;
        border: 1px solid var(--glass-border) !important;
        color: var(--text-main) !important; /* Adapts to Light/Dark Mode */
        backdrop-filter: blur(10px);
    }
    .btn-glass:hover {
        background: var(--bg-input) !important;
        border-color: var(--primary) !important; 
        color: var(--primary) !important;
    }

    label {
      color: var(--text-dim);
      font-weight: 500;
      margin-bottom: 0.5rem;
    }

    /* Floating Background Elements */
    .floating-shape {
      position: fixed;
      border-radius: 50%;
      filter: blur(80px);
      z-index: -1;
      opacity: 0.4;
      animation: floatAnimation 20s infinite alternate ease-in-out;
    }

    .shape-1 {
      top: -10%;
      left: -10%;
      width: 500px;
      height: 500px;
      background: #3b82f6; /* Blue */
      animation-delay: 0s;
    }

    .shape-2 {
      bottom: -10%;
      right: -10%;
      width: 600px;
      height: 600px;
      background: #8b5cf6; /* Purple */
      animation-delay: -5s;
    }

    .shape-3 {
      top: 40%;
      left: 60%;
      width: 300px;
      height: 300px;
      background: #ec4899; /* Pink/Rose Accent */
      animation-delay: -10s;
      opacity: 0.2;
    }

    @keyframes floatAnimation {
      0% {
        transform: translate(0, 0) rotate(0deg) scale(1);
      }
      33% {
        transform: translate(30px, 50px) rotate(10deg) scale(1.1);
      }
      66% {
        transform: translate(-20px, 20px) rotate(-5deg) scale(0.9);
      }
      100% {
        transform: translate(0, 0) rotate(0deg) scale(1);
      }
    }

    /* Education Floating Icons */
    .floating-icon {
      position: fixed;
      z-index: -1;
      opacity: 0.12;
      color: var(--text-main);
      pointer-events: none;
      filter: drop-shadow(0 0 10px rgba(255,255,255,0.05));
      animation: iconFloat 25s infinite ease-in-out alternate;
    }

    /* Set 1 */
    .icon-1 { top: 15%; left: 8%; font-size: 4rem; animation-delay: 0s; transform: rotate(-15deg); }
    .icon-2 { bottom: 20%; left: 12%; font-size: 6rem; animation-delay: -3s; transform: rotate(10deg); }
    .icon-3 { top: 20%; right: 12%; font-size: 5rem; animation-delay: -7s; transform: rotate(5deg); }
    .icon-4 { bottom: 15%; right: 8%; font-size: 4.5rem; animation-delay: -11s; transform: rotate(-10deg); }
    
    /* Set 2 */
    .icon-5 { top: 10%; left: 50%; font-size: 5rem; animation-delay: -2s; transform: rotate(0deg); opacity: 0.08; }
    .icon-6 { top: 50%; right: 5%; font-size: 4rem; animation-delay: -5s; transform: rotate(-20deg); }
    .icon-7 { top: 60%; left: 5%; font-size: 4rem; animation-delay: -9s; transform: rotate(15deg); }
    .icon-8 { bottom: 10%; left: 45%; font-size: 5.5rem; animation-delay: -13s; transform: rotate(30deg); }

    /* Set 3 */
    .icon-9 { top: 80%; right: 30%; font-size: 4rem; animation-delay: -4s; transform: rotate(10deg); }
    .icon-10 { top: 40%; left: 25%; font-size: 5rem; animation-delay: -8s; transform: rotate(-5deg); }
    .icon-11 { top: 30%; left: 80%; font-size: 4.5rem; animation-delay: -1s; transform: rotate(20deg); }
    .icon-12 { bottom: 40%; left: 85%; font-size: 4rem; animation-delay: -6s; transform: rotate(-10deg); }

    /* Set 4 (New) */
    .icon-13 { top: 5%; left: 20%; font-size: 3rem; animation-delay: -5s; opacity: 0.07; }
    .icon-14 { top: 5%; right: 20%; font-size: 3.5rem; animation-delay: -2s; opacity: 0.07; }
    .icon-15 { bottom: 5%; left: 30%; font-size: 3rem; animation-delay: -8s; opacity: 0.07; }
    .icon-16 { bottom: 5%; right: 30%; font-size: 3.5rem; animation-delay: -4s; opacity: 0.07; }
    .icon-17 { top: 45%; left: 15%; font-size: 3rem; animation-delay: -9s; transform: rotate(45deg); }
    .icon-18 { top: 55%; right: 15%; font-size: 3rem; animation-delay: -1s; transform: rotate(-45deg); }
    
    /* Set 5 (Tiny Fillers) */
    .icon-19 { top: 25%; left: 40%; font-size: 2rem; opacity: 0.05; animation-delay: -3s; }
    .icon-20 { top: 75%; left: 60%; font-size: 2.5rem; opacity: 0.05; animation-delay: -6s; }
    .icon-21 { top: 35%; right: 40%; font-size: 2rem; opacity: 0.05; animation-delay: -2s; }
    .icon-22 { bottom: 35%; right: 25%; font-size: 2.5rem; opacity: 0.05; animation-delay: -7s; }
    .icon-23 { top: 15%; left: 5%; font-size: 2rem; opacity: 0.05; animation-delay: -4s; }
    .icon-24 { bottom: 15%; right: 5%; font-size: 2rem; opacity: 0.05; animation-delay: -5s; }

    /* Set 6 (More Variety) */
    .icon-25 { top: 90%; left: 10%; font-size: 4rem; animation-delay: -10s; }
    .icon-26 { top: 90%; right: 10%; font-size: 4rem; animation-delay: -11s; }
    .icon-27 { top: 50%; left: 50%; font-size: 8rem; opacity: 0.03; animation-delay: -15s; } /* Center Giant */

    .icon-29 { bottom: 45%; left: 5%; font-size: 3rem; animation-delay: -8s; }
    .icon-30 { top: 30%; right: 5%; font-size: 3rem; animation-delay: -5s; }

    /* Set 7 (Final Polish) */
    .icon-31 { top: 65%; left: 20%; font-size: 2.5rem; opacity: 0.06; }
    .icon-32 { top: 25%; right: 25%; font-size: 2.5rem; opacity: 0.06; }
    .icon-33 { bottom: 25%; left: 35%; font-size: 2rem; opacity: 0.06; }
    .icon-34 { top: 85%; left: 40%; font-size: 3rem; opacity: 0.06; }
    .icon-35 { bottom: 80%; right: 35%; font-size: 3rem; opacity: 0.06; }


    @keyframes iconFloat {
      0% { transform: translateY(0) rotate(0deg); }
      100% { transform: translateY(-30px) rotate(10deg); }
    }

    /* Mobile Responsiveness for Background */
    @media (max-width: 768px) {
      .floating-icon {
        font-size: 1.5rem !important; /* Force smaller icons */
        opacity: 0.08 !important;     /* Reduce distraction */
      }
      
      .floating-shape {
        filter: blur(40px);           /* Less blur for clarity */
        opacity: 0.3;
      }
      
      .shape-1 { width: 200px; height: 200px; top: -5%; left: -5%; }
      .shape-2 { width: 250px; height: 250px; bottom: -5%; right: -5%; }
      .shape-3 { width: 100px; height: 100px; }            
    }

    /* Light Theme Variables */
    body.light-theme {
      --bg-dark: #f8fafc; /* Light Gray/White */
      --bg-card: rgba(255, 255, 255, 0.7);
      --primary: #16a34a; /* Darker Green for contrast */
      --secondary: #14532d;
      --text-main: #1e293b; /* Dark Slate */
      --text-dim: #64748b;
      --glass-border: rgba(0, 0, 0, 0.1);
    }
    
    body.light-theme .navbar-snoop {
      background: rgba(242, 246, 249, 0.3);
      backdrop-filter: blur(15px);
      -webkit-backdrop-filter: blur(15px);
      border-bottom: 1px solid rgba(0,0,0,0.05);
    }


    /* Footer Styles */
    .snoop-footer {
      text-align: center;
      padding: 0.8rem;
      margin-top: auto; /* Push to bottom using Flexbox */
      border-top: 1px solid var(--glass-border);
      background: rgba(255, 255, 255, 0.5);
      backdrop-filter: blur(10px);
      color: var(--text-dim);
      font-size: 0.8rem;
      width: 100%;
    }

    /* Global SweetAlert2 Glass Styling */
    div:where(.swal2-container) div:where(.swal2-popup) {
      background: linear-gradient(135deg, #fdf4f9 0%, #f4f8fd 100%) !important;
      backdrop-filter: blur(10px) !important;
      -webkit-backdrop-filter: blur(10px) !important;
      border: 1px solid rgba(212, 16, 170, 0.25) !important;
      border-radius: 20px !important;
      color: var(--text-main) !important;
      box-shadow: 0 10px 25px rgba(212, 16, 170, 0.15) !important;
    }
    
    div:where(.swal2-container) .swal2-title,
    div:where(.swal2-container) .swal2-html-container {
      color: var(--text-main) !important;
    }

    div:where(.swal2-container) .swal2-input {
      border-radius: 10px !important;
      border: 1px solid var(--glass-border) !important;
      background: var(--bg-input) !important;
      color: var(--text-main) !important;
      box-shadow: none !important;
      transition: all 0.3s ease !important;
    }

    div:where(.swal2-container) .swal2-input:focus {
      border-color: var(--primary) !important;
      box-shadow: 0 0 0 2px rgba(212, 16, 170, 0.1) !important;
    }

    /* Fix for Success Icon Background */
    div:where(.swal2-icon).swal2-success [class^='swal2-success-circular-line'] {
      background-color: transparent !important;
    }
    div:where(.swal2-icon).swal2-success .swal2-success-fix {
      background-color: transparent !important;
    }
    div:where(.swal2-icon).swal2-success [class^='swal2-success-line'] {
      background-color: var(--primary) !important;
    }

  </style>
</head>

<body>
  <!-- Background Icons -->
  <i class="fas fa-pen-nib floating-icon icon-1"></i>
  <i class="fas fa-laptop-code floating-icon icon-2"></i>
  <i class="fas fa-book-open floating-icon icon-3"></i>
  <i class="fas fa-calculator floating-icon icon-4"></i>
  <i class="fas fa-graduation-cap floating-icon icon-5"></i>
  <i class="fas fa-shield-alt floating-icon icon-6"></i>
  <i class="fas fa-clock floating-icon icon-7"></i>
  <i class="fas fa-atom floating-icon icon-8"></i>
  <i class="fas fa-globe floating-icon icon-9"></i>
  <i class="fas fa-microscope floating-icon icon-10"></i>
  <i class="fas fa-certificate floating-icon icon-11"></i>
  <i class="fas fa-university floating-icon icon-12"></i>
  
  <i class="fas fa-brain floating-icon icon-13"></i>
  <i class="fas fa-lightbulb floating-icon icon-14"></i>
  <i class="fas fa-pencil-alt floating-icon icon-15"></i>
  <i class="fas fa-search floating-icon icon-16"></i>
  <i class="fas fa-code floating-icon icon-17"></i>
  <i class="fas fa-database floating-icon icon-18"></i>
  <i class="fas fa-file-alt floating-icon icon-19"></i>
  <i class="fas fa-chart-pie floating-icon icon-20"></i>
  <i class="fas fa-video floating-icon icon-21"></i>
  <i class="fas fa-id-card floating-icon icon-22"></i>
  <i class="fas fa-keyboard floating-icon icon-23"></i>
  <i class="fas fa-mouse floating-icon icon-24"></i>
  <i class="fas fa-layer-group floating-icon icon-25"></i>
  <i class="fas fa-network-wired floating-icon icon-26"></i>
  <i class="fas fa-fingerprint floating-icon icon-27"></i>

  <i class="fas fa-lock floating-icon icon-29"></i>
  <i class="fas fa-user-graduate floating-icon icon-30"></i>
  <i class="fas fa-server floating-icon icon-31"></i>
  <i class="fas fa-wifi floating-icon icon-32"></i>
  <i class="fas fa-robot floating-icon icon-33"></i>
  <i class="fas fa-medal floating-icon icon-34"></i>
  <i class="fas fa-chalkboard-teacher floating-icon icon-35"></i>

  <!-- Global Top Navbar -->
  <% if (!locals.isolateTest) { %>
  <nav class="navbar-snoop d-flex justify-content-between align-items-center fixed-top">
    <div class="d-flex align-items-center">
        <!-- Menu Toggle Moved to Sidebar -->
        
        <a href="<%= locals.user && locals.user.role === 'teacher' ? '/teacher/home' : (locals.user && locals.user.role === 'student' ? '/student/home' : '/') %>" class="navbar-brand-snoop mr-4">SNOOP</a>
    </div>
    
    <div class="nav-links d-flex align-items-center">

      <% if (locals.user) { %>
         <!-- Profile Photo -->
         <div class="ml-3 d-flex align-items-center" title="<%= locals.user.name %>">
            <img src="<%= locals.user.photo_url || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(locals.user.name) %>" 
                 alt="Profile" 
                 class="rounded-circle border" 
                 style="width: 40px; height: 40px; object-fit: cover; border-color: var(--glass-border) !important;">
         </div>
      <% } %>

      <% if (!locals.user) { %>
        <a href="/" class="text-dim mr-3 small text-decoration-none">Home</a>
      <% } %>
      
      <% if (locals.user) { %>
         <% if (locals.user.role === 'teacher') { %>
            <a href="/teacher/logout" class="btn-snoop text-small py-1 px-3 ml-3" style="font-size: 0.8rem;">Logout</a>
         <% } else { %>
            <a href="/student/logout" class="btn-snoop text-small py-1 px-3 ml-3" style="font-size: 0.8rem;">Logout</a>
         <% } %>
      <% } %>
    </div>
  </nav>
  <% } %>

  <!-- Sidebar & Main Wrapper Layout -->
  <div class="d-flex <%= (locals.user && (locals.user.role === 'teacher' || locals.user.role === 'student') && !locals.isolateTest) ? 'sidebar-active' : '' %>" id="wrapper">
    
    <!-- Sidebar -->
    <% if (locals.user && (locals.user.role === 'teacher' || locals.user.role === 'student') && !locals.isolateTest) { %>
    <div class="snoop-sidebar d-flex flex-column" id="sidebar-wrapper">
      <!-- Toggle Button (Top Right of Sidebar) -->
      <div class="d-flex justify-content-between align-items-center p-3" id="sidebar-toggle-container">
          <div class="font-weight-bold ml-2 sidebar-text">
              <span class="text-dim small d-block" style="line-height:1;">Welcome</span>
              <span class="text-main" style="font-size: 0.95rem;"><%= locals.user.name %></span>
          </div>
          <div id="menu-toggle" style="cursor: pointer;">
            <i class="fas fa-chevron-left fa-lg" id="toggle-icon"></i>
          </div>
      </div>
      
      <% if (locals.user.role === 'teacher') { %>
      <div class="list-group list-group-flush mb-3 d-flex flex-column flex-grow-1">
        <!-- Main Links (Flex-grow prevents bottom items from creeping up) -->
        <div class="flex-grow-1">
            <a href="/teacher/home" class="list-group-item list-group-item-action bg-transparent second-text <%= (locals.currentPage === 'dashboard') ? 'active' : '' %>">
                <i class="fas fa-tachometer-alt mr-4"></i> <span class="sidebar-text">Dashboard</span>
            </a>
            <a href="/teacher/enterTestID" class="list-group-item list-group-item-action bg-transparent second-text fw-bold <%= (locals.currentPage === 'create_test') ? 'active' : '' %>">
                <i class="fas fa-plus-circle mr-4"></i> <span class="sidebar-text">Create Test</span>
            </a>
            <a href="/teacher/showAllTests" class="list-group-item list-group-item-action bg-transparent second-text fw-bold <%= (locals.currentPage === 'view_tests') ? 'active' : '' %>">
                <i class="fas fa-list-ul mr-4"></i> <span class="sidebar-text">View Tests</span>
            </a>
            <a href="/teacher/showAllTests?filter=completed" class="list-group-item list-group-item-action bg-transparent second-text fw-bold <%= (locals.currentPage === 'results') ? 'active' : '' %>">
                <i class="fas fa-chart-line mr-4"></i> <span class="sidebar-text">Results</span>
            </a>
            <a href="/teacher/students" class="list-group-item list-group-item-action bg-transparent second-text fw-bold <%= (locals.currentPage === 'students') ? 'active' : '' %>">
