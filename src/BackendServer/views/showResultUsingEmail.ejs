<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>

<body>
    <div class="text-center mb-5">
        <h2 class="font-weight-bold">Examination Performance</h2>
        <p class="text-dim">Detailed breakdown of your assessment scores.</p>
    </div>

    <div class="row justify-content-center">
        <% for(let i=0 ; i < results.length ; i++){ %>
            <div class="col-md-8 mb-4">
                <div class="glass-card">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="font-weight-bold mb-0">Test ID: <span style="color: var(--primary);">
                                <%= results[i].test_id %>
                            </span></h4>
                        <div class="badge badge-pill p-2 px-3"
                            style="background: rgba(56, 189, 248, 0.1); color: var(--primary);">
                            Result #<%= i + 1 %>
                        </div>
                    </div>

                    <div class="row text-center mt-4">
                        <div class="col-md-4 mb-3">
                            <div class="p-3 rounded" style="background: rgba(255, 255, 255, 0.03);">
                                <p class="small text-dim mb-1">Total Score</p>
                                <h3 class="font-weight-bold" style="color: var(--secondary);">
                                    <%= results[i].final_score %>
                                </h3>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="p-3 rounded" style="background: rgba(255, 255, 255, 0.03);">
                                <p class="small text-dim mb-1">MCQ Points</p>
                                <h3 class="font-weight-bold">
                                    <%= results[i].mcq_score %>
                                </h3>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="p-3 rounded" style="background: rgba(255, 255, 255, 0.03);">
                                <p class="small text-dim mb-1">Subjective Points</p>
                                <h3 class="font-weight-bold">
                                    <%= results[i].subjective_score %>
                                </h3>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <% } %>
    </div>

    <div class="text-center mt-4 mb-5">
        <button onclick="window.history.back()" class="btn-snoop btn-glass">
            <i class="fas fa-arrow-left mr-2"></i> Back to Search
        </button>
        <a href="/student/home" class="btn-snoop ml-3">
             Dashboard <i class="fas fa-home ml-2"></i>
        </a>
    </div>
</body>

</html>