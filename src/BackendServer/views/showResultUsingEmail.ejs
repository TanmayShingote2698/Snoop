    <div class="text-center mb-5" style="margin-top: 5px;">
        <h2 class="font-weight-bold">Examination Performance</h2>
        <p class="text-dim">Detailed breakdown of your assessment scores.</p>
    </div>

    <div class="row justify-content-center">
        <% 
            // Sort results by timestamp/ID descending to show latest on top
            results.sort((a, b) => {
                const dateA = new Date(a.created_at || 0);
                const dateB = new Date(b.created_at || 0);
                return dateB - dateA;
            });
        %>
        <% for(let i=0 ; i < results.length ; i++){ %>
            <div class="col-md-10 mb-4">
                <div class="glass-card">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="font-weight-bold mb-0">Test ID: <span style="color: var(--primary);">
                                <%= results[i].test_id %>
                            </span></h4>
                        <div class="d-flex align-items-center">
                            <button class="btn btn-sm font-weight-bold px-3 py-2 mr-3 view-answers-btn" 
                                    data-testid="<%= results[i].test_id %>"
                                    data-answers="<%= encodeURIComponent(JSON.stringify(results[i].answers)) %>"
                                    style="border: none; border-radius: 8px; color: white; background: linear-gradient(135deg, var(--primary), var(--secondary)); box-shadow: 0 4px 10px rgba(212,16,170,0.3);">
                                <i class="fas fa-tasks mr-2"></i> View Detailed Answers
                            </button>
                            <div class="badge badge-pill p-2 px-3"
                                style="background: rgba(56, 189, 248, 0.1); color: var(--primary);">
                                #<%= results.length - i %>
                            </div>
                        </div>
                    </div>

                    <div class="row text-center mt-4">
                        <div class="col-md-3 mb-3">
                            <div class="p-3 rounded" style="background: rgba(255, 255, 255, 0.03);">
                                <p class="small text-dim mb-1">Score</p>
                                <h3 class="font-weight-bold" style="color: var(--secondary);">
                                    <% if (results[i].total_marks && results[i].total_marks > 0) { %>
                                        <%= results[i].mcq_obtained || results[i].mcq_score %> / <%= results[i].total_marks %>
                                    <% } else { %>
                                        <%= results[i].mcq_score %>
                                    <% } %>
                                </h3>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="p-3 rounded" style="background: rgba(255, 255, 255, 0.03);">
                                <p class="small text-dim mb-1">Percentage</p>
                                <h3 class="font-weight-bold" 
                                    style="color: <%= results[i].percentage >= 75 ? '#10b981' : results[i].percentage >= 40 ? '#fbbf24' : '#ef4444' %>;">
                                    <% if (results[i].percentage != null && results[i].percentage > 0) { %>
                                        <%= results[i].percentage %>%
                                    <% } else { %>
                                        -
                                    <% } %>
                                </h3>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="p-3 rounded" style="background: rgba(255, 255, 255, 0.03);">
                                <p class="small text-dim mb-1">Status</p>
                                <h3 class="font-weight-bold">
                                    <% if (results[i].pass_status && results[i].total_marks > 0) { %>
                                        <span class="badge badge-pill px-3 py-2" style="font-size: 0.9rem; background: <%= results[i].pass_status === 'PASS' ? 'rgba(16, 185, 129, 0.15)' : 'rgba(239, 68, 68, 0.15)' %>; color: <%= results[i].pass_status === 'PASS' ? '#10b981' : '#ef4444' %>; border: 1px solid <%= results[i].pass_status === 'PASS' ? '#10b981' : '#ef4444' %>;">
                                            <i class="fas <%= results[i].pass_status === 'PASS' ? 'fa-check-circle' : 'fa-times-circle' %> mr-1"></i><%= results[i].pass_status %>
                                        </span>
                                    <% } else { %>
                                        <span class="text-dim">-</span>
                                    <% } %>
                                </h3>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="p-3 rounded" style="background: rgba(255, 255, 255, 0.03);">
                                <p class="small text-dim mb-1">Integrity</p>
                                <h3 class="font-weight-bold"
                                    style="color: <%= results[i].integrity < 75 ? '#ef4444' : '#3b82f6' %>;">
                                    <%= results[i].integrity %>%
                                </h3>
                            </div>
                        </div>
                    </div>
                        </div>
                    </div>

                    <% if (results[i].monitoring_enabled && results[i].anomaly_data && results[i].anomaly_data.length > 0) { %>
                    <div class="mt-4 pt-4 border-top" style="border-color: rgba(255,255,255,0.05) !important;">
                        <h5 class="font-weight-bold mb-3 text-danger"><i class="fas fa-exclamation-triangle mr-2"></i> Integrity Anomalies</h5>
                        <div class="row">
                            <% results[i].anomaly_data.slice(0, 4).forEach(function(anom, index) { %>
                                <div class="col-md-6 col-lg-3 mb-3">
                                    <div class="glass-card p-2 h-100 d-flex flex-column" style="border: 1px solid var(--glass-border); border-radius: 6px;">
                                        <div class="mb-2">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <span class="badge badge-warning">Event ${index + 1}</span>
                                            </div>
                                            <small class="text-dim">
                                                <strong class="text-danger"><%= anom.type.replace(/_/g, ' ').toUpperCase() %></strong><br>
                                                Confidence: <%= (anom.confidence * 100).toFixed(0) %>%<br>
                                                Time: <%= new Date(anom.timestamp).toLocaleTimeString() %>
                                            </small>
                                        </div>
                                        <% if (anom.imageUrl) { %>
                                            <div class="mt-auto text-center" style="position: relative;">
                                                <img src="<%= anom.imageUrl %>" alt="Capture" class="img-fluid rounded border border-danger shadow-sm" style="max-height: 100px; object-fit: cover; cursor: pointer; border-width: 2px !important;" onclick="window.open('<%= anom.imageUrl %>', '_blank')">
                                                <div title="Source: <%= anom.source || 'camera' %>" style="position: absolute; bottom: 5px; right: 5px; background: rgba(0,0,0,0.6); color: white; padding: 2px 5px; border-radius: 4px; font-size: 0.6rem;">
                                                    <i class="fas <%= anom.source === 'screen' ? 'fa-desktop' : 'fa-camera' %>"></i>
                                                </div>
                                            </div>
                                        <% } else { %>
                                            <div class="mt-auto text-center py-2 text-dim rounded" style="background: rgba(255,255,255,0.05); font-size: 0.75rem;">
                                                <i class="fas fa-video-slash"></i>
                                            </div>
                                        <% } %>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                        <% if (results[i].anomaly_data.length > 4) { %>
                            <div class="mt-2 text-center">
                                <button class="btn btn-sm btn-outline-danger font-weight-bold view-anomalies-btn" data-anomalies="<%= encodeURIComponent(JSON.stringify(results[i].anomaly_data)) %>">
                                    View All <%= results[i].anomaly_data.length %> Anomalies
                                </button>
                            </div>
                        <% } %>
                    </div>
                    <% } %>
                </div>
            </div>
            <% } %>
    </div>

  <!-- Answer Modal -->
  <div class="modal fade" id="answerModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
      <div class="modal-content" style="background: var(--bg-card); border: 1px solid var(--glass-border); backdrop-filter: blur(20px); border-radius: 15px;">
        <div class="modal-header border-0 pb-0">
          <h5 class="modal-title font-weight-bold" style="color: var(--text-base);">
            <i class="fas fa-tasks mr-2" style="color: var(--secondary);"></i>
            Submission Details: <span id="modalTestID" style="color: var(--primary);"></span>
          </h5>
          <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="color: var(--text-dim);">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <div class="modal-body p-4">
            <div id="modalQuestionsContainer" style="max-height: 60vh; overflow-y: auto; padding-right: 10px;">
                <!-- Questions will be injected here -->
            </div>
        </div>
        <div class="modal-footer border-0 pt-0">
          <button type="button" class="btn-snoop btn-glass px-4" data-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>

  <!-- All Anomalies Modal -->
  <div class="modal fade" id="allAnomaliesModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered" role="document">
      <div class="modal-content" style="background: var(--bg-card); border: 1px solid var(--glass-border); backdrop-filter: blur(20px); border-radius: 15px;">
        <div class="modal-header border-0 pb-2">
          <div class="d-flex align-items-center">
            <h5 class="modal-title font-weight-bold mb-0 text-danger">
              <i class="fas fa-exclamation-triangle mr-2"></i> All Integrity Anomalies
            </h5>
          </div>
          <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="color: var(--text-dim); padding: 1rem 1rem 0 0; margin: -1rem -1rem -1rem auto;">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <div class="modal-body p-4">
            <div id="modalAnomaliesContainer" class="row" style="max-height: 60vh; overflow-y: auto; overflow-x: hidden;">
                <!-- Anomalies will be injected here -->
            </div>
        </div>
        <div class="modal-footer border-0 pt-0">
          <button type="button" class="btn-snoop btn-glass px-4" data-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>

<script>
    const allTests = <%- JSON.stringify(allTests || []) %>;

    function showAllAnomaliesModal(anomalies) {
        const container = document.getElementById('modalAnomaliesContainer');
        container.innerHTML = '';
        
        anomalies.forEach((anom, index) => {
            const anomCard = document.createElement('div');
            anomCard.className = 'col-md-4 col-lg-3 mb-4';
            
            let imgHtml = '';
            if (anom.imageUrl) {
                imgHtml = `
                    <div class="mt-2 text-center" style="position: relative; height: 150px;">
                        <img src="${anom.imageUrl}" alt="Capture" class="img-fluid rounded border border-danger shadow-sm h-100 w-100" style="object-fit: cover; cursor: pointer; border-width: 2px !important;" onclick="window.open('${anom.imageUrl}', '_blank')">
                        <div title="Source: ${anom.source || 'camera'}" style="position: absolute; top: 5px; right: 5px; background: rgba(0,0,0,0.6); color: white; padding: 2px 6px; border-radius: 4px; font-size: 0.65rem;">
                            <i class="fas ${anom.source === 'screen' ? 'fa-desktop' : 'fa-camera'}"></i> ${(anom.source || 'camera').toUpperCase()}
                        </div>
                    </div>
                `;
            } else {
                imgHtml = `
                    <div class="mt-2 text-center py-4 text-dim rounded d-flex flex-column justify-content-center align-items-center" style="background: rgba(255,255,255,0.05); height: 150px;">
                        <i class="fas fa-video-slash fa-2x mb-2"></i><span>No Capture Available</span>
                    </div>
                `;
            }
            
            anomCard.innerHTML = `
                <div class="glass-card p-3 h-100 d-flex flex-column" style="border: 1px solid var(--glass-border); border-radius: 8px;">
                    <div class="mb-2">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="badge ${anom.confidence > 0.8 ? 'badge-danger' : 'badge-warning'}">Event ${index + 1}</span>
                            <small class="text-dim">${new Date(anom.timestamp).toLocaleTimeString()}</small>
                        </div>
                        <h6 class="font-weight-bold text-danger mt-2 mb-1" style="font-size: 0.9em;">
                            ${anom.type.replace(/_/g, ' ').toUpperCase()}
                        </h6>
                        <small class="text-dim d-block mb-2">Confidence: ${(anom.confidence * 100).toFixed(0)}%</small>
                    </div>
                    <div class="mt-auto">
                        ${imgHtml}
                    </div>
                </div>
            `;
            container.appendChild(anomCard);
        });
        
        $('#allAnomaliesModal').modal('show');
    }

    function showAnswerModal(testID, studentAnswers) {
        document.getElementById('modalTestID').innerText = testID;
        const container = document.getElementById('modalQuestionsContainer');
        container.innerHTML = '';

        const test = allTests.find(t => t.id == testID);
        if (!test || !test.questions) {
            container.innerHTML = '<p class="text-center text-dim py-4">Question details not available for this test.</p>';
            $('#answerModal').modal('show');
            return;
        }

        test.questions.forEach((q, index) => {
            const studentAns = studentAnswers[index] || "No Answer";
            
            // Resolve actual answer text same as backend
            let actualValue = q.answer;
            if (q["op" + q.answer]) {
                actualValue = q["op" + q.answer];
            } else if (q[q.answer]) {
                actualValue = q[q.answer];
            } else if (/^\d+$/.test(q.answer)) {
                let key = "op" + q.answer;
                if (q[key]) actualValue = q[key];
            }
            
            const actualAns = actualValue;
            const isCorrect = studentAns.toLowerCase().trim() === actualAns.toLowerCase().trim();

            const qCard = document.createElement('div');
            qCard.className = 'glass-card mb-4 p-3';
            qCard.style.borderLeft = `4px solid ${isCorrect ? '#10b981' : '#ef4444'}`;
            qCard.style.background = 'rgba(255, 255, 255, 0.03)';

            let optionsHtml = '';
            if (q.op1) {
                optionsHtml = `
                    <div class="row small mt-2">
                        <div class="col-6 mb-1 ${actualAns === q.op1 ? 'text-success font-weight-bold' : 'text-dim'}">A) ${q.op1}</div>
                        <div class="col-6 mb-1 ${actualAns === q.op2 ? 'text-success font-weight-bold' : 'text-dim'}">B) ${q.op2}</div>
                        <div class="col-6 mb-1 ${actualAns === q.op3 ? 'text-success font-weight-bold' : 'text-dim'}">C) ${q.op3}</div>
                        <div class="col-6 mb-1 ${actualAns === q.op4 ? 'text-success font-weight-bold' : 'text-dim'}">D) ${q.op4}</div>
                    </div>
                `;
            }

            qCard.innerHTML = `
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <h6 class="font-weight-bold mb-0">Q${index + 1}: ${q.question}</h6>
                    <span class="badge ${isCorrect ? 'badge-success' : 'badge-danger'}">
                        ${isCorrect ? 'CORRECT' : 'INCORRECT'}
                    </span>
                </div>
                ${optionsHtml}
                <div class="mt-3 pt-2 border-top" style="border-color: rgba(255,255,255,0.05) !important;">
                    <div class="small">
                        <span class="text-dim">Your Answer:</span> 
                        <span class="${isCorrect ? 'text-success' : 'text-danger'} font-weight-bold">${studentAns}</span>
                    </div>
                    ${!isCorrect ? `
                    <div class="small mt-1">
                        <span class="text-dim">Correct Answer:</span> 
                        <span class="text-success font-weight-bold">${actualAns}</span>
                    </div>` : ''}
                </div>
            `;
            container.appendChild(qCard);
        });

        $('#answerModal').modal('show');
    }

    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('.view-answers-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const testId = this.getAttribute('data-testid');
                const answers = JSON.parse(decodeURIComponent(this.getAttribute('data-answers')));
                showAnswerModal(testId, answers);
            });
        });

        document.querySelectorAll('.view-anomalies-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const anomalies = JSON.parse(decodeURIComponent(this.getAttribute('data-anomalies')));
                showAllAnomaliesModal(anomalies);
            });
        });
    });
</script>

    <div class="text-center mt-4 mb-5">
        <button onclick="window.history.back()" class="btn-snoop btn-glass">
            <i class="fas fa-arrow-left mr-2"></i> Back to Search
        </button>
        <a href="/student/home" class="btn-snoop ml-3">
            Dashboard <i class="fas fa-home ml-2"></i>
        </a>
    </div>
<% if (typeof hideHome === 'undefined' || !hideHome) { %>
    <%- include('footer') %>
<% } %>