<div class="row justify-content-center" style="margin-top: 5px;">
  <div class="col-md-6">
    <div class="glass-card">
      <div class="text-center mb-4">
        <i class="fas fa-shield-alt fa-3x mb-3" style="color: var(--primary);"></i>
        <h2 class="font-weight-bold">Faculty Registration</h2>
        <p class="text-dim">Set up your authorized faculty account here.</p>
      </div>

      <form action="/teacher/register" method="POST">
        <div class="form-group">
          <label><i class="fas fa-id-badge mr-2"></i>Admin ID / Faculty Code</label>
          <input name="adminID" type="text" class="form-control" placeholder="e.g. DSE23111" required>
        </div>
        <div class="form-group">
          <label><i class="fas fa-user mr-2"></i>Full Name</label>
          <input name="name" type="text" class="form-control" placeholder="Enter Your Name" required>
        </div>
        <div class="form-group">
          <label><i class="fas fa-envelope mr-2"></i>Email Address</label>
          <input name="email" type="email" class="form-control" placeholder="faculty@snoop.com" required>
          <small class="form-text text-muted">Use your institutional email for faculty access.</small>
        </div>
        <div class="form-group mb-4">
          <label><i class="fas fa-lock mr-2"></i>Password</label>
          <div class="position-relative">
            <input name="password" type="password" class="form-control" placeholder="••••••••" required id="passwordTeacherRegister">
            <i class="fas fa-eye position-absolute" 
               style="right: 15px; top: 50%; transform: translateY(-50%); cursor: pointer; color: var(--text-dim);"
               onclick="togglePassword(this, 'passwordTeacherRegister')"></i>
          </div>
        </div>

        <button type="submit" class="btn-snoop w-100 justify-content-center">
          Create Faculty Account <i class="fas fa-check-circle"></i>
        </button>
      </form>

      <div class="text-center mt-4">
        <p class="small text-dim">Already an faculty?
          <a href="/teacher/login" style="color: var(--primary); font-weight: 600;">Sign In Here</a>
        </p>
      </div>
    </div>
  </div>
</div>