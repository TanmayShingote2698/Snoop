<div class="exam-header d-flex justify-content-between align-items-center mb-5 p-4 glass-card"
    style="position: relative; z-index: 1000; border-bottom: 2px solid var(--primary); width: 100%;">
    <div class="d-flex align-items-center">
      <div class="mr-4 text-center" style="border-right: 2px solid var(--glass-border); padding-right: 20px;">
        <h2 class="navbar-brand-snoop mb-0" style="font-size: 2rem;">SNOOP</h2>
        <p class="text-dim mb-0 small font-weight-bold" style="letter-spacing: 1px;">PROCTORING SYSTEM</p>
      </div>
      <div>
        <h4 class="font-weight-bold mb-0 text-main">Instructions: <span style="color: var(--primary);">
            <%= test.id %>
          </span></h4>
        <div class="d-flex align-items-center mt-1">
          <p class="text-dim mb-0 small">Student: <span class="text-main font-weight-bold"><%= email %></span>
          </p>
        </div>
      </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="glass-card p-5">
            <div class="text-center mb-5">
                <div class="display-4 text-primary mb-3"><i class="fas fa-clipboard-list"></i></div>
                <h2 class="font-weight-bold">Examination Instructions</h2>
                <p class="text-dim">Please read the following guidelines carefully before starting.</p>
            </div>

                    <div class="test-details mb-5 p-4 rounded"
                        style="background: rgba(255, 255, 255, 0.03); border: 1px solid var(--glass-border);">
                        <div class="row">
                            <div class="col-6">
                                <p class="small text-dim mb-1">Test ID</p>
                                <h5 class="font-weight-bold">
                                    <%= test.id %>
                                </h5>
                            </div>
                            <div class="col-6">
                                <p class="small text-dim mb-1">Duration</p>
                                <h5 class="font-weight-bold">
                                    <%= test.testDuration %> Minutes
                                </h5>
                            </div>
                        </div>
                    </div>

                    <div class="rules-section mb-5">
                        <h5 class="font-weight-bold mb-4"
                            style="color: var(--secondary); border-left: 4px solid var(--secondary); padding-left: 15px;">
                            Proctoring Rules</h5>
                        <ul class="list-unstyled">
                            <li class="mb-3 d-flex align-items-start">
                                <i class="fas fa-video mr-3 mt-1 text-primary"></i>
                                <span><strong>Webcam Mandatory:</strong> Your webcam is now active. Ensure your face is
                                    clearly visible throughout the exam.</span>
                            </li>
                            <li class="mb-3 d-flex align-items-start">
                                <i class="fas fa-eye mr-3 mt-1 text-primary"></i>
                                <span><strong>Engagement:</strong> Looking away from the screen or using multiple
                                    monitors will flag your session for suspicious activity.</span>
                            </li>
                            <li class="mb-3 d-flex align-items-start">
                                <i class="fas fa-desktop mr-3 mt-1 text-primary"></i>
                                <span><strong>Screen Sharing:</strong> You must share your <strong>Entire Screen</strong>. This allows the AI to verify your environment and detect unauthorized windows.</span>
                            </li>
                            <li class="mb-3 d-flex align-items-start">
                                <i class="fas fa-user-friends mr-3 mt-1 text-primary"></i>
                                <span><strong>Single User:</strong> Only the registered student should be visible.
                                    Detection of extra people will result in a warning.</span>
                            </li>
                            <li class="mb-3 d-flex align-items-start">
                                <i class="fas fa-keyboard mr-3 mt-1 text-primary"></i>
                                <span><strong>Integrity Score:</strong> A real-time integrity score is being calculated.
                                    This score is final and submitted with your results.</span>
                            </li>
                            <li class="mb-3 d-flex align-items-start p-3 rounded" style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.2);">
                                <i class="fas fa-ban mr-3 mt-1 text-danger"></i>
                                <span class="text-danger"><strong>Strict Prohibitions:</strong>
                                    <ul class="pl-3 mt-2 mb-0">
                                        <li>No Tab Switching (Captured with Screen Snapshots)</li>
                                        <li>No Copy/Paste (Ctrl+C, Ctrl+V Disabled)</li>
                                        <li>No Right-Click Context Menu</li>
                                        <li>No Exiting Fullscreen (Captured with Screen Snapshots)</li>
                                        <li>No Mobile Phones allowed</li>
                                        <li>Microphone must remain unmutes</li>
                                    </ul>
                                </span>
                            </li>
                        </ul>
                    </div>

                    <div class="consent-section mb-5 p-4 rounded" style="background: rgba(255,255,255,0.02); border: 1px solid var(--glass-border);">
                        <div class="custom-control custom-checkbox">
                            <input type="checkbox" class="custom-control-input" id="consentCheck" onchange="toggleProceed()">
                            <label class="custom-control-label" for="consentCheck">
                                I have read and understood all the instructions. I agree to share my camera, microphone, and <strong>entire screen</strong> for proctoring purposes and will adhere to the code of conduct.
                            </label>
                        </div>
                    </div>

                    <div class="d-flex justify-content-center mt-5">
                        <a href="/student/home" class="btn-snoop btn-glass mr-3 px-4">
                            <i class="fas fa-arrow-left mr-2"></i> Decline & Exit
                        </a>
                        <form action="/student/systemCheck" method="POST">
                            <input type="hidden" name="email" value="<%= email %>">
                            <input type="hidden" name="testID" value="<%= test.id %>">
                            <button type="submit" class="btn-snoop px-5" id="proceedBtn" disabled style="opacity: 0.5; cursor: not-allowed;">
                                Agree & Proceed <i class="fas fa-arrow-right ml-2"></i>
                            </button>
                        </form>
                    </div>

                    <script>
                        window.onload = function() {
                            // Only persist if we have valid data from the server
                            const email = '<%= email %>';
                            const testId = '<%= test.id %>';
                            
                            if (email && email !== 'undefined') {
                                localStorage.setItem('studentEmail', email);
                            }
                            if (testId && testId !== 'undefined') {
                                localStorage.setItem('testId', testId);
                            }
                        };
                    </script>
                    <script>
                        function toggleProceed() {
                            const checkbox = document.getElementById('consentCheck');
                            const btn = document.getElementById('proceedBtn');
                            if (checkbox.checked) {
                                btn.disabled = false;
                                btn.style.opacity = '1';
                                btn.style.cursor = 'pointer';
                            } else {
                                btn.disabled = true;
                                btn.style.opacity = '0.5';
                                btn.style.cursor = 'not-allowed';
                            }
                        }
                    </script>