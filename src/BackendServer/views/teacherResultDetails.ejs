<div class="row mb-4 align-items-center">
    <div class="col-md-8">
        <h2 class="font-weight-bold p-0 m-0" style="color: var(--text-base);">
            <i class="fas fa-chart-bar mr-2" style="color: var(--secondary);"></i>
            Test Results Analytics
        </h2>
        <p class="text-dim mt-2 mb-0">Test ID: <strong style="color: var(--text-base);"><%= testID %></strong></p>
    </div>
    <div class="col-md-4 text-md-right mt-3 mt-md-0">
        <a href="/teacher/showAllTests?filter=completed" class="btn-snoop btn-glass">
            <i class="fas fa-arrow-left mr-2"></i> Back to Dashboard
        </a>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="glass-card">
            <% if (results && results.length > 0) { %>
                <div class="table-responsive">
                    <table class="table table-hover table-borderless mb-0" style="background: transparent; color: var(--text-base);">
                        <thead style="border-bottom: 2px solid var(--glass-border);">
                            <tr>
                                <th scope="col" class="font-weight-bold text-dim pb-3">Student Email</th>
                                <th scope="col" class="font-weight-bold text-dim pb-3 text-center">Final Score</th>
                                <th scope="col" class="font-weight-bold text-dim pb-3 text-center">MCQ + Subj</th>
                                <th scope="col" class="font-weight-bold text-dim pb-3 text-center">Integrity %</th>
                                <th scope="col" class="font-weight-bold text-dim pb-3 text-center">Tab Switches</th>
                                <th scope="col" class="font-weight-bold text-dim pb-3 text-center">Time Exited (sec)</th>
                                <th scope="col" class="font-weight-bold text-dim pb-3 text-center">FS Exits</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% results.forEach(function(r) { %>
                                <% 
                                    let integrityColor = '#34d399'; // Green
                                    if (r.integrity < 50) integrityColor = '#ef4444'; // Red
                                    else if (r.integrity < 80) integrityColor = '#fbbf24'; // Yellow
                                %>
                                <tr style="border-bottom: 1px solid var(--glass-border); transition: background 0.3s; cursor: default;">
                                    <td class="align-middle py-3">
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-circle mr-3" style="width: 40px; height: 40px; border-radius: 50%; background: var(--primary); color: white; display: flex; align-items: center; justify-content: center; font-weight: bold;">
                                                <%= r.email.substring(0, 1).toUpperCase() %>
                                            </div>
                                            <div>
                                                <h6 class="mb-0" style="color: var(--text-base);"><%= r.email %></h6>
                                                <small class="text-dim">Student ID: <%= r.student_id %></small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="align-middle text-center py-3">
                                        <span class="fs-5 font-weight-bold" style="color: var(--secondary);"><%= r.final_score %></span>
                                    </td>
                                    <td class="align-middle text-center py-3 text-dim">
                                        <%= r.mcq_score %> + <%= r.subjective_score %>
                                    </td>
                                    <td class="align-middle text-center py-3">
                                        <span class="badge badge-pill px-3 py-2" style="background: <%= integrityColor %>33; color: <%= integrityColor %>; font-size: 0.9rem;">
                                            <%= r.integrity %>%
                                        </span>
                                    </td>
                                    <td class="align-middle text-center py-3">
                                        <% if (r.tabSwitchCount > 0) { %>
                                            <span class="text-warning font-weight-bold"><%= r.tabSwitchCount %></span>
                                        <% } else { %>
                                            <span class="text-dim">0</span>
                                        <% } %>
                                    </td>
                                    <td class="align-middle text-center py-3">
                                        <% if (r.totalTimeExited > 0) { %>
                                            <span class="text-danger font-weight-bold"><%= r.totalTimeExited %>s</span>
                                        <% } else { %>
                                            <span class="text-dim">0s</span>
                                        <% } %>
                                    </td>
                                    <td class="align-middle text-center py-3">
                                        <% if (r.fullscreenExits > 0) { %>
                                            <span class="text-warning font-weight-bold"><%= r.fullscreenExits %></span>
                                        <% } else { %>
                                            <span class="text-dim">0</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="text-center py-5">
                    <i class="fas fa-inbox fa-3x mb-3 text-dim"></i>
                    <h5 class="text-dim">No results available yet.</h5>
                    <p class="text-dim mb-0">Students might not have completed this test or scores are still processing.</p>
                </div>
            <% } %>
        </div>
    </div>
</div>

<style>
    .table-hover tbody tr:hover {
        background-color: rgba(255, 255, 255, 0.05) !important;
    }
</style>
