<div class="row mb-4 align-items-center" style="margin-top: 5px;">
    <div class="col-md-7">
        <h2 class="font-weight-bold p-0 m-0" style="color: var(--text-base);">
            <i class="fas fa-chart-bar mr-2" style="color: var(--secondary);"></i>
            Test Results Analytics
        </h2>
        <p class="text-dim mt-2 mb-0">Test ID: <strong style="color: var(--text-base);"><%= testID %></strong></p>
    </div>
    <div class="col-md-5 text-md-right mt-3 mt-md-0 d-flex justify-content-md-end">
        <button onclick="window.location.reload()" class="btn-snoop btn-glass mr-2" style="background: rgba(56, 189, 248, 0.1); border-color: rgba(56, 189, 248, 0.3); color: var(--primary);">
            <i class="fas fa-sync-alt mr-2"></i> Refresh
        </button>
        <a href="/teacher/showAllTests?filter=completed" class="btn-snoop btn-glass">
            <i class="fas fa-arrow-left mr-2"></i> Back to Dashboard
        </a>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="glass-card">
            <% if (results && results.length > 0) { %>
                <div class="table-responsive">
                    <table class="table table-hover table-borderless mb-0" style="background: transparent; color: var(--text-base);">
                        <thead style="border-bottom: 2px solid var(--glass-border);">
                            <tr>
                                <th scope="col" class="font-weight-bold text-dim pb-2" style="font-size: 0.85rem; white-space: nowrap;">Student Email</th>
                                <th scope="col" class="font-weight-bold text-dim pb-2 text-center" style="font-size: 0.85rem; white-space: nowrap;">Score</th>
                                <th scope="col" class="font-weight-bold text-dim pb-2 text-center" style="font-size: 0.85rem; white-space: nowrap;">Percentage</th>
                                <th scope="col" class="font-weight-bold text-dim pb-2 text-center" style="font-size: 0.85rem; white-space: nowrap;">Status</th>
                                <th scope="col" class="font-weight-bold text-dim pb-2 text-center" style="font-size: 0.85rem; white-space: nowrap;">Integrity</th>
                                <th scope="col" class="font-weight-bold text-dim pb-2 text-center" style="font-size: 0.85rem; white-space: nowrap;">AI Score</th>
                                <th scope="col" class="font-weight-bold text-dim pb-2 text-center" style="font-size: 0.85rem; white-space: nowrap;">Risk</th>
                                <th scope="col" class="font-weight-bold text-dim pb-2 text-center" style="font-size: 0.85rem; white-space: nowrap;">Monitor</th>
                                <th scope="col" class="font-weight-bold text-dim pb-2 text-center" style="font-size: 0.85rem; white-space: nowrap;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% results.forEach(function(r, idx) { %>
                                <% 
                                    let integrityColor = '#34d399'; // Green
                                    if (r.integrity < 50) integrityColor = '#ef4444'; // Red
                                    else if (r.integrity < 80) integrityColor = '#fbbf24'; // Yellow
                                    
                                    let riskColor = '#34d399'; // LOW - Green
                                    let riskBg = 'rgba(52, 211, 153, 0.1)';
                                    if (r.risk_level === 'MODERATE') {
                                        riskColor = '#60a5fa'; // Blue
                                        riskBg = 'rgba(96, 165, 250, 0.1)';
                                    } else if (r.risk_level === 'MEDIUM') {
                                        riskColor = '#fbbf24'; // Yellow
                                        riskBg = 'rgba(251, 191, 36, 0.1)';
                                    } else if (r.risk_level === 'HIGH') {
                                        riskColor = '#f97316'; // Orange
                                        riskBg = 'rgba(249, 115, 22, 0.1)';
                                    } else if (r.risk_level === 'CRITICAL') {
                                        riskColor = '#ef4444'; // Red
                                        riskBg = 'rgba(239, 68, 68, 0.1)';
                                    }
                                %>
                                <tr class="snoop-table-row" style="border-bottom: 1px solid var(--glass-border); transition: background 0.3s; cursor: default;" id="row-<%= idx %>">
                                    <td class="align-middle py-1">
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-circle mr-2" style="width: 28px; height: 28px; border-radius: 50%; background: var(--primary); color: white; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 0.75rem; box-shadow: 0 2px 5px rgba(0,0,0,0.2);">
                                                <%= r.email.substring(0, 1).toUpperCase() %>
                                            </div>
                                            <div>
                                                <div class="mb-0 font-weight-bold" style="color: var(--text-base); font-size: 0.85rem;"><%= r.email %></div>
                                                <div class="text-dim" style="font-size: 0.7rem; line-height: 1;">ID: <%= r.student_id %></div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="align-middle text-center py-1">
                                        <% if (r.total_marks && r.total_marks > 0) { %>
                                            <span class="font-weight-bold" style="color: var(--secondary); font-size: 1rem;"><%= r.mcq_obtained || r.mcq_score %> / <%= r.total_marks %></span>
                                        <% } else { %>
                                            <span class="font-weight-bold" style="color: var(--secondary); font-size: 1rem;"><%= r.mcq_score %></span>
                                        <% } %>
                                    </td>
                                    <td class="align-middle text-center py-1">
                                        <% if (r.percentage != null && r.total_marks > 0) { %>
                                            <span class="badge badge-pill px-2 py-1" style="background: <%= r.percentage >= 75 ? '#10b981' : r.percentage >= 40 ? '#fbbf24' : '#ef4444' %>33; color: <%= r.percentage >= 75 ? '#10b981' : r.percentage >= 40 ? '#fbbf24' : '#ef4444' %>; border: 1px solid <%= r.percentage >= 75 ? '#10b981' : r.percentage >= 40 ? '#fbbf24' : '#ef4444' %>44; font-size: 0.75rem;">
                                                <%= r.percentage %>%
                                            </span>
                                        <% } else { %>
                                            <span class="text-dim" style="font-size: 0.75rem;">-</span>
                                        <% } %>
                                    </td>
                                    <td class="align-middle text-center py-1">
                                        <% if (r.pass_status && r.total_marks > 0) { %>
                                            <span class="badge badge-pill px-2 py-1" style="background: <%= r.pass_status === 'PASS' ? 'rgba(16, 185, 129, 0.15)' : 'rgba(239, 68, 68, 0.15)' %>; color: <%= r.pass_status === 'PASS' ? '#10b981' : '#ef4444' %>; border: 1px solid <%= r.pass_status === 'PASS' ? '#10b981' : '#ef4444' %>; font-size: 0.75rem; font-weight: bold;">
                                                <i class="fas <%= r.pass_status === 'PASS' ? 'fa-check-circle' : 'fa-times-circle' %> mr-1"></i><%= r.pass_status %>
                                            </span>
                                        <% } else { %>
                                            <span class="text-dim" style="font-size: 0.75rem;">-</span>
                                        <% } %>
                                    </td>
                                    <td class="align-middle text-center py-1">
                                        <span class="badge badge-pill px-2 py-1" style="background: <%= integrityColor %>33; color: <%= integrityColor %>; border: 1px solid <%= integrityColor %>44; font-size: 0.75rem;">
                                            <%= r.integrity %>%
                                        </span>
                                    </td>
                                    <td class="align-middle text-center py-1">
                                        <% if (r.monitoring_enabled) { %>
                                            <span class="badge badge-pill px-2 py-1" style="background: <%= (r.cheat_score > 60 ? '#ef4444' : r.cheat_score > 40 ? '#fbbf24' : '#34d399') %>33; color: <%= (r.cheat_score > 60 ? '#ef4444' : r.cheat_score > 40 ? '#fbbf24' : '#34d399') %>; border: 1px solid <%= (r.cheat_score > 60 ? '#ef4444' : r.cheat_score > 40 ? '#fbbf24' : '#34d399') %>44; font-size: 0.75rem;">
                                                <%= r.cheat_score.toFixed(1) %>
                                            </span>
                                        <% } else { %>
                                            <span class="text-dim text-center" style="font-size: 0.75rem;">N/A</span>
                                        <% } %>
                                    </td>
                                    <td class="align-middle text-center py-1">
                                        <% if (r.monitoring_enabled) { %>
                                            <span class="badge badge-pill px-2 py-1" style="background: <%= riskBg %>; color: <%= riskColor %>; border: 1px solid <%= riskColor %>44; font-size: 0.75rem; font-weight: bold;">
                                                <%= r.combined_score.toFixed(1) %>
                                            </span>
                                        <% } else { %>
                                            <span class="text-dim text-center" style="font-size: 0.75rem;">N/A</span>
                                        <% } %>
                                    </td>
                                    <td class="align-middle text-center py-1">
                                        <% if (r.monitoring_enabled) { %>
                                            <span class="badge px-2 py-1" style="background: <%= riskBg %>; color: <%= riskColor %>; border: 1px solid <%= riskColor %>44; font-weight: bold; font-size: 0.75rem; white-space: nowrap;">
                                                <% 
                                                    let riskIcon = '🟢';
                                                    if (r.risk_level === 'MODERATE') riskIcon = '🔵';
                                                    else if (r.risk_level === 'MEDIUM') riskIcon = '🟡';
                                                    else if (r.risk_level === 'HIGH') riskIcon = '🟠';
                                                    else if (r.risk_level === 'CRITICAL') riskIcon = '🔴';
                                                %>
                                                <%= riskIcon %> <%= r.risk_level %>
                                            </span>
                                        <% } else { %>
                                            <span class="text-dim text-center" style="font-size: 0.75rem;">N/A</span>
                                        <% } %>
                                    </td>
                                    <td class="align-middle text-center py-1">
                                        <% if (r.monitoring_enabled) { %>
                                            <span class="badge badge-success px-2 py-1" style="font-size: 0.7rem;">
                                                <i class="fas fa-camera mr-1"></i>On
                                            </span>
                                        <% } else { %>
                                            <span class="badge badge-secondary px-2 py-1" style="font-size: 0.7rem;">
                                                <i class="fas fa-ban mr-1"></i>Off
                                            </span>
                                        <% } %>
                                    </td>
                                    <td class="align-middle text-center py-1">
                                        <div class="d-flex flex-column align-items-center">
                                            <% if (r.monitoring_enabled && r.anomaly_data && r.anomaly_data.length > 0) { %>
                                                <button class="btn btn-sm btn-outline-info mb-1" onclick="toggleAnomalyDetails(<%= idx %>)" style="border-color: var(--primary); color: var(--primary); min-width: 130px; padding: 4px 5px; font-size: 0.75rem; border-radius: 6px; font-weight: bold;">
                                                    <i class="fas fa-eye mr-1"></i><%= r.anomaly_data.length %> Alerts
                                                </button>
                                            <% } %>
                                            
                                            <button class="btn btn-sm btn-outline-primary mb-1 send-report-btn" 
                                                    data-email="<%= r.email %>" 
                                                    data-idx="<%= idx %>"
                                                    data-score="<%= r.mcq_score %>"
                                                    data-integrity="<%= r.integrity %>"
                                                    data-cheat="<%= r.cheat_score %>"
                                                    style="border-radius: 6px; min-width: 130px; padding: 5px 5px; font-size: 0.75rem; font-weight: bold; background: rgba(56, 189, 248, 0.05);">
                                                <i class="fas fa-paper-plane mr-1"></i> Send Report
                                            </button>

                                            <button class="btn btn-sm font-weight-bold px-2 view-answers-btn" 
                                                    data-email="<%= r.email %>" 
                                                    data-answers="<%= encodeURIComponent(JSON.stringify(r.answers)) %>"
                                                    style="border: none; border-radius: 6px; color: white; background: linear-gradient(135deg, var(--primary), var(--secondary)); box-shadow: 0 2px 5px rgba(212,16,170,0.3); min-width: 130px; padding-top: 5px; padding-bottom: 5px; font-size: 0.75rem;">
                                                <i class="fas fa-tasks mr-1"></i> Answers
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                <!-- Anomaly Details Row -->
                                <tr id="details-<%= idx %>" style="display: none; background: rgba(255,255,255,0.02); border-bottom: 1px solid var(--glass-border);">
                                    <td colspan="10" class="py-3">
                                        <div class="ml-3">
                                            <h6 class="font-weight-bold mb-3" style="color: var(--primary);">Detected Anomalies (Select for Report)</h6>
                                            <% if (r.anomaly_data && r.anomaly_data.length > 0) { %>
                                                <div class="row">
                                                    <% r.anomaly_data.slice(0, 5).forEach(function(anom, aidx) { %>
                                                        <div class="col-md-6 col-lg-3 mb-3">
                                                            <div class="glass-card p-2 h-100 d-flex flex-column anomaly-card" style="border: 1px solid var(--glass-border); border-radius: 6px; position: relative;">
                                                                <div class="custom-control custom-checkbox" style="position: absolute; top: 10px; left: 10px; z-index: 10;">
                                                                    <input type="checkbox" class="custom-control-input anomaly-checkbox-<%= idx %>" id="anom-<%= idx %>-<%= aidx %>" 
                                                                           data-type="<%= anom.type %>" 
                                                                           data-time="<%= anom.timestamp %>" 
                                                                           data-img="<%= anom.imageUrl %>"
                                                                           data-source="<%= anom.source || 'camera' %>"
                                                                           data-conf="<%= anom.confidence %>">
                                                                    <label class="custom-control-label" for="anom-<%= idx %>-<%= aidx %>" style="cursor: pointer;"></label>
                                                                </div>
                                                                <div class="mb-2 pl-4">
                                                                    <small class="text-dim">
                                                                        <strong class="text-danger"><%= anom.type.replace(/_/g, ' ').toUpperCase() %></strong><br>
                                                                        Confidence: <%= (anom.confidence * 100).toFixed(0) %>%<br>
                                                                        Time: <%= new Date(anom.timestamp).toLocaleTimeString() %>
                                                                    </small>
                                                                </div>
                                                                <% if (anom.imageUrl) { %>
                                                                    <div class="mt-auto text-center" style="position: relative;">
                                                                        <img src="<%= anom.imageUrl %>" alt="Capture" class="img-fluid rounded border border-danger shadow-sm" style="max-height: 120px; object-fit: cover; cursor: pointer; border-width: 2px !important;" onclick="window.open('<%= anom.imageUrl %>', '_blank')">
                                                                        <div title="Source: <%= anom.source || 'camera' %>" style="position: absolute; bottom: 5px; right: 5px; background: rgba(0,0,0,0.6); color: white; padding: 2px 6px; border-radius: 4px; font-size: 0.65rem;">
                                                                            <i class="fas <%= anom.source === 'screen' ? 'fa-desktop' : 'fa-camera' %>"></i> <%= (anom.source || 'camera').toUpperCase() %>
                                                                        </div>
                                                                    </div>
                                                                <% } else { %>
                                                                    <div class="mt-auto text-center py-3 text-dim rounded" style="background: rgba(255,255,255,0.05); font-size: 0.75rem;">
                                                                        <i class="fas fa-video-slash mb-1"></i><br>No Capture
                                                                    </div>
                                                                <% } %>
                                                            </div>
                                                        </div>
                                                    <% }) %>
                                                </div>
                                                <% if (r.anomaly_data.length > 5) { %>
                                                    <div class="mt-3">
                                                        <button class="btn btn-sm btn-outline-danger font-weight-bold" onclick="showAllAnomaliesModal(this)" data-anomalies="<%= encodeURIComponent(JSON.stringify(r.anomaly_data)) %>" data-email="<%= r.email %>" style="border-radius: 6px;">
                                                            <i class="fas fa-exclamation-triangle mr-1"></i> View All <%= r.anomaly_data.length %> Anomalies
                                                        </button>
                                                    </div>
                                                <% } %>
                                            <% } %>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="text-center py-5">
                    <i class="fas fa-inbox fa-3x mb-3 text-dim"></i>
                    <h5 class="text-dim">No results available yet.</h5>
                    <p class="text-dim mb-0">Students might not have completed this test or scores are still processing.</p>
                </div>
            <% } %>
        </div>
    </div>
</div>

<!-- Report Preview Modal -->
<div class="modal fade" id="reportPreviewModal" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
    <div class="modal-content" style="background: #f8fafc; border: none; border-radius: 20px; overflow: hidden; color: #1e293b; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);">
      <div class="modal-header border-0 pb-0" style="background: #1e293b; color: white; border-radius: 0; padding: 20px 25px;">
        <h5 class="modal-title font-weight-bold">
          <i class="fas fa-file-invoice mr-2"></i> Report Preview & Confirmation
        </h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="color: white; opacity: 0.8; outline: none;">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>

      <div class="modal-body p-0" style="background: #f1f5f9;">
          <div class="row no-gutters">
              <!-- Left Sidebar: Comment Input -->
              <div class="col-md-4 p-4 border-right bg-white">
                  <h6 class="font-weight-bold mb-3" style="color: #1e293b; font-size: 0.9rem;">
                      <i class="fas fa-comment-alt mr-2 text-primary"></i> Professional Note
                  </h6>
                  <p class="text-muted small mb-3">Add a custom message to the student below. A default message is provided.</p>
                  
                  <textarea id="modalTeacherComment" class="form-control" rows="12" 
                            style="border-radius: 12px; border: 1.5px solid #e2e8f0; font-size: 0.85rem; padding: 12px; resize: none; background: #fcfdfe; transition: all 0.2s;" 
                            placeholder="Enter your message here..."></textarea>
                  
                  <div class="mt-4 p-3 rounded" style="background: rgba(56, 189, 248, 0.05); border: 1px dashed #cbd5e1;">
                      <small class="text-info d-block mb-1 font-weight-bold"><i class="fas fa-info-circle mr-1"></i> Quick Tip</small>
                      <p class="mb-0 text-muted" style="font-size: 0.75rem; line-height: 1.4;">Selected anomaly proofs will be automatically attached to the bottom of the email.</p>
                  </div>
              </div>

              <!-- Right: Email Preview -->
              <div class="col-md-8 p-0" style="max-height: 75vh; overflow-y: auto; background: #eaeff5;">
                  <div class="p-4 text-center">
                    <span class="badge badge-pill badge-primary px-3 py-2 mb-3" style="background: #1e293b; letter-spacing: 0.5px;">EMAIL PREVIEW MODE</span>
                  </div>
                  <div id="emailPreviewContainer" style="max-width: 500px; margin: 0 auto 30px; background: white; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); overflow: hidden;">
                      <!-- Content will be injected by JS -->
                  </div>
              </div>
          </div>
      </div>

      <div class="modal-footer border-top bg-white px-4 py-3" style="justify-content: flex-end; gap: 15px;">
        <button type="button" class="btn btn-link text-secondary font-weight-bold" data-dismiss="modal" style="text-decoration: none;">Discard</button>
        <button type="button" id="modalConfirmSendBtn" class="btn btn-primary px-5 font-weight-bold hvr-grow" style="border-radius: 10px; background: linear-gradient(135deg, #1e293b, #334155); border: none; padding: 12px 0; min-width: 220px; box-shadow: 0 4px 12px rgba(30, 41, 59, 0.3);">
          <i class="fas fa-paper-plane mr-2"></i> Confirm & Dispatch Report
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Answer Modal -->
<div class="modal fade" id="answerModal" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
    <div class="modal-content" style="background: var(--bg-card); border: 1px solid var(--glass-border); backdrop-filter: blur(20px); border-radius: 15px;">
      <div class="modal-header border-0 pb-2">
        <div class="d-flex align-items-center">
          <img id="modalStudentImage" src="" alt="Student Avatar" style="width: 40px; height: 40px; border-radius: 50%; object-fit: cover; border: 2px solid var(--primary); margin-right: 15px;">
          <h5 class="modal-title font-weight-bold mb-0" style="color: var(--text-base);">
            Submission Details: <span id="modalStudentEmail" style="color: var(--primary); font-size: 0.9em;"></span>
          </h5>
        </div>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="color: var(--text-dim); padding: 1rem 1rem 0 0; margin: -1rem -1rem -1rem auto;">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body p-4">
          <div id="modalQuestionsContainer" style="max-height: 60vh; overflow-y: auto; padding-right: 10px;">
              <!-- Questions will be injected here -->
          </div>
      </div>
      <div class="modal-footer border-0 pt-0">
        <button type="button" class="btn-snoop btn-glass px-4" data-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<!-- All Anomalies Modal -->
<div class="modal fade" id="allAnomaliesModal" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered" role="document">
    <div class="modal-content" style="background: var(--bg-card); border: 1px solid var(--glass-border); backdrop-filter: blur(20px); border-radius: 15px;">
      <div class="modal-header border-0 pb-2">
        <div class="d-flex align-items-center">
          <h5 class="modal-title font-weight-bold mb-0 text-danger">
            <i class="fas fa-exclamation-triangle mr-2"></i> All Anomalies: <span id="modalAnomaliesEmail" style="color: var(--text-base); font-size: 0.9em;"></span>
          </h5>
        </div>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="color: var(--text-dim); padding: 1rem 1rem 0 0; margin: -1rem -1rem -1rem auto;">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body p-4">
          <div id="modalAnomaliesContainer" class="row" style="max-height: 60vh; overflow-y: auto; overflow-x: hidden;">
              <!-- Anomalies will be injected here -->
          </div>
      </div>
      <div class="modal-footer border-0 pt-0">
        <button type="button" class="btn-snoop btn-glass px-4" data-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<script>
    const testQuestions = <%- JSON.stringify(testQuestions || []) %>;
    const DEFAULT_NOTE = "Hello, please find your proctoring performance report for the recently concluded examination. We maintain high standards of academic integrity, and these metrics help ensure a fair evaluation for everyone. Should you have any questions regarding your score or the proctoring flags, please reach out via the official channels.";

    function toggleAnomalyDetails(idx) {
        const detailsRow = document.getElementById('details-' + idx);
        if (detailsRow) {
            if (detailsRow.style.display === 'none') {
                detailsRow.style.display = 'table-row';
            } else {
                detailsRow.style.display = 'none';
            }
        }
    }

    function showAllAnomaliesModal(button) {
        const email = button.getAttribute('data-email');
        const anomalies = JSON.parse(decodeURIComponent(button.getAttribute('data-anomalies')));
        const studentIdx = button.closest('tr').id.split('-')[1]; // Get index from row ID
        
        document.getElementById('modalAnomaliesEmail').innerText = email;
        const container = document.getElementById('modalAnomaliesContainer');
        container.innerHTML = '';
        
        anomalies.forEach((anom, index) => {
            const anomCard = document.createElement('div');
            anomCard.className = 'col-md-4 col-lg-3 mb-4';
            
            let imgHtml = '';
            if (anom.imageUrl) {
                imgHtml = `
                    <div class="mt-2 text-center" style="position: relative; height: 150px;">
                        <img src="${anom.imageUrl}" alt="Capture" class="img-fluid rounded border border-danger shadow-sm h-100 w-100" style="object-fit: cover; cursor: pointer; border-width: 2px !important;" onclick="window.open('${anom.imageUrl}', '_blank')">
                        <div title="Source: ${anom.source || 'camera'}" style="position: absolute; top: 5px; right: 5px; background: rgba(0,0,0,0.6); color: white; padding: 2px 6px; border-radius: 4px; font-size: 0.65rem;">
                            <i class="fas ${anom.source === 'screen' ? 'fa-desktop' : 'fa-camera'}"></i> ${(anom.source || 'camera').toUpperCase()}
                        </div>
                    </div>
                `;
            } else {
                imgHtml = `
                    <div class="mt-2 text-center py-4 text-dim rounded d-flex flex-column justify-content-center align-items-center" style="background: rgba(255,255,255,0.05); height: 150px;">
                        <i class="fas fa-video-slash fa-2x mb-2"></i><span>No Capture Available</span>
                    </div>
                `;
            }
            
            anomCard.innerHTML = `
                <div class="glass-card p-3 h-100 d-flex flex-column" style="border: 1px solid var(--glass-border); border-radius: 8px; position: relative;">
                    <div class="custom-control custom-checkbox" style="position: absolute; top: 10px; left: 10px; z-index: 10;">
                        <input type="checkbox" class="custom-control-input anomaly-checkbox-${studentIdx}" id="modal-anom-${studentIdx}-${index}" 
                               data-type="${anom.type}" 
                               data-time="${anom.timestamp}" 
                               data-img="${anom.imageUrl}"
                               data-source="${anom.source || 'camera'}"
                               data-conf="${anom.confidence}">
                        <label class="custom-control-label" for="modal-anom-${studentIdx}-${index}" style="cursor: pointer;"></label>
                    </div>
                    <div class="mb-2 pl-4">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="badge ${anom.confidence > 0.8 ? 'badge-danger' : 'badge-warning'}">Event ${index + 1}</span>
                            <small class="text-dim">${new Date(anom.timestamp).toLocaleTimeString()}</small>
                        </div>
                        <h6 class="font-weight-bold text-danger mt-2 mb-1" style="font-size: 0.9em;">
                            ${anom.type.replace(/_/g, ' ').toUpperCase()}
                        </h6>
                        <small class="text-dim d-block mb-2">Confidence: ${(anom.confidence * 100).toFixed(0)}%</small>
                    </div>
                    <div class="mt-auto">
                        ${imgHtml}
                    </div>
                </div>
            `;
            container.appendChild(anomCard);
        });
        
        $('#allAnomaliesModal').modal('show');
    }

    function showAnswerModal(email, studentAnswers) {
        document.getElementById('modalStudentEmail').innerText = email;
        const namePart = email.split('@')[0];
        document.getElementById('modalStudentImage').src = `https://ui-avatars.com/api/?name=${encodeURIComponent(namePart)}&background=random&color=fff&size=128`;
        
        const container = document.getElementById('modalQuestionsContainer');
        container.innerHTML = '';

        testQuestions.forEach((q, index) => {
            const studentAns = studentAnswers[index] || "No Answer";
            
            // Resolve actual answer text same as backend
            let actualValue = q.answer;
            if (q["op" + q.answer]) {
                actualValue = q["op" + q.answer];
            } else if (q[q.answer]) {
                actualValue = q[q.answer];
            } else if (/^\d+$/.test(q.answer)) {
                let key = "op" + q.answer;
                if (q[key]) actualValue = q[key];
            }
            
            const actualAns = actualValue;
            const isCorrect = studentAns.toLowerCase().trim() === actualAns.toLowerCase().trim();

            const qCard = document.createElement('div');
            qCard.className = 'glass-card mb-2 p-2';
            qCard.style.borderLeft = `3px solid ${isCorrect ? '#10b981' : '#ef4444'}`;
            qCard.style.background = 'rgba(255, 255, 255, 0.02)';

            let optionsHtml = '';
            if (q.op1) {
                optionsHtml = `
                    <div class="row small mt-1" style="font-size: 0.8em; line-height: 1.2;">
                        <div class="col-6 mb-1 ${actualAns === q.op1 ? 'text-success font-weight-bold' : 'text-dim'}">A) ${q.op1}</div>
                        <div class="col-6 mb-1 ${actualAns === q.op2 ? 'text-success font-weight-bold' : 'text-dim'}">B) ${q.op2}</div>
                        <div class="col-6 mb-1 ${actualAns === q.op3 ? 'text-success font-weight-bold' : 'text-dim'}">C) ${q.op3}</div>
                        <div class="col-6 mb-1 ${actualAns === q.op4 ? 'text-success font-weight-bold' : 'text-dim'}">D) ${q.op4}</div>
                    </div>
                `;
            }

            qCard.innerHTML = `
                <div class="d-flex justify-content-between align-items-start mb-1">
                    <h6 class="font-weight-bold mb-0" style="font-size: 0.85em; max-width: 85%;">Q${index + 1}: ${q.question}</h6>
                    <span class="badge ${isCorrect ? 'badge-success' : 'badge-danger'}" style="font-size: 0.65em; padding: 3px 6px;">
                        ${isCorrect ? 'CORRECT' : 'INCORRECT'}
                    </span>
                </div>
                ${optionsHtml}
                <div class="mt-1 pt-1 border-top" style="border-color: rgba(255,255,255,0.05) !important;">
                    <div class="d-flex justify-content-between align-items-center" style="font-size: 0.8em;">
                        <div>
                            <span class="text-dim">Student:</span> 
                            <span class="${isCorrect ? 'text-success' : 'text-danger'} font-weight-bold">${studentAns}</span>
                        </div>
                        ${!isCorrect ? `
                        <div>
                            <span class="text-dim">Correct:</span> 
                            <span class="text-success font-weight-bold">${actualAns}</span>
                        </div>` : ''}
                    </div>
                </div>
            `;
            container.appendChild(qCard);
        });

        $('#answerModal').modal('show');
    }

    async function showReportPreview(btn) {
        const studentIdx = btn.getAttribute('data-idx');
        const email = btn.getAttribute('data-email');
        const score = btn.getAttribute('data-score');
        const integrity = btn.getAttribute('data-integrity');
        const cheat = parseFloat(btn.getAttribute('data-cheat'));
        
        // Populate custom note textarea with default
        const commentArea = document.getElementById('modalTeacherComment');
        commentArea.value = DEFAULT_NOTE;

        const updatePreview = () => {
             // Find checked anomalies for this student
            const checkboxes = document.querySelectorAll(`.anomaly-checkbox-${studentIdx}:checked`);
            const selectedAnomalies = Array.from(checkboxes).map(cb => ({
                type: cb.getAttribute('data-type'),
                timestamp: cb.getAttribute('data-time'),
                imageUrl: cb.getAttribute('data-img'),
                source: cb.getAttribute('data-source'),
                confidence: parseFloat(cb.getAttribute('data-conf'))
            }));

            const riskColor = cheat > 40 ? '#ef4444' : cheat > 20 ? '#f59e0b' : '#10b981';
            const teacherNote = commentArea.value;

            let proofHtml = '';
            selectedAnomalies.forEach(anom => {
                proofHtml += `
                <div style="background: #fffafa; border: 1px solid #fee2e2; border-radius: 10px; padding: 12px; margin-bottom: 12px; font-family: sans-serif;">
                    <div style="display: flex; justify-content: space-between; font-size: 11px;">
                        <strong style="color: #b91c1c;">${anom.type.toUpperCase()}</strong>
                        <span style="color: #64748b;">${new Date(anom.timestamp).toLocaleTimeString()}</span>
                    </div>
                    ${anom.imageUrl ? `<img src="${anom.imageUrl}" style="width: 100%; border-radius: 6px; margin: 8px 0; border: 1px solid #ddd;">` : ''}
                    <div style="font-size: 11px; color: #64748b;">Source: ${anom.source.toUpperCase()}</div>
                </div>`;
            });

            const previewContent = `
                <div style="background: #1e293b; padding: 25px; text-align: center; color: white; font-family: sans-serif;">
                    <h4 style="margin: 0;">Examination Report</h4>
                    <p style="margin: 5px 0 0; font-size: 12px; opacity: 0.7;">Test ID: <%= testID %></p>
                </div>
                <div style="padding: 25px; font-family: sans-serif;">
                    <p style="font-size: 15px; margin-bottom: 20px;">Hello <strong>${email.split('@')[0]}</strong>,</p>
                    <div style="display: flex; gap: 15px; margin-bottom: 20px;">
                        <div style="flex: 1; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; padding: 15px; text-align: center;">
                            <span style="font-size: 10px; color: #94a3b8; text-transform: uppercase;">Score</span>
                            <div style="font-size: 20px; font-weight: bold;">${score} <span style="font-size: 12px; color: #94a3b8;">/ ${testQuestions.length}</span></div>
                        </div>
                        <div style="flex: 1; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; padding: 15px; text-align: center;">
                            <span style="font-size: 10px; color: #94a3b8; text-transform: uppercase;">Integrity</span>
                            <div style="font-size: 20px; font-weight: bold; color: ${riskColor};">${integrity}%</div>
                        </div>
                    </div>
                    ${teacherNote ? `<div style="background: #f1f5f9; padding: 12px; border-radius: 8px; border-left: 3px solid #1e293b; margin-bottom: 20px; font-style: italic; font-size: 13px; color: #334155;">"${teacherNote}"</div>` : ''}
                    ${proofHtml ? `<h6 style="font-size: 13px; font-weight: bold; color: #1e293b; margin-bottom: 10px;">Evidence Provided:</h6> ${proofHtml}` : ''}
                </div>
            `;

            document.getElementById('emailPreviewContainer').innerHTML = previewContent;
        };

        // Live update preview when typing comment
        commentArea.oninput = updatePreview;
        updatePreview();
        
        // Setup Modal Send Button
        const modalBtn = document.getElementById('modalConfirmSendBtn');
        modalBtn.onclick = () => {
             const finalComment = commentArea.value;
             const checkboxes = document.querySelectorAll(`.anomaly-checkbox-${studentIdx}:checked`);
             const finalAnomalies = Array.from(checkboxes).map(cb => ({
                type: cb.getAttribute('data-type'),
                timestamp: cb.getAttribute('data-time'),
                imageUrl: cb.getAttribute('data-img'),
                source: cb.getAttribute('data-source'),
                confidence: parseFloat(cb.getAttribute('data-conf'))
             }));

             $('#reportPreviewModal').modal('hide');
             sendStudentReport(btn, finalComment, finalAnomalies);
        };

        $('#reportPreviewModal').modal('show');
    }

    async function sendStudentReport(btn, comment, anomalies) {
        const email = btn.getAttribute('data-email');
        const score = btn.getAttribute('data-score');
        const integrity = btn.getAttribute('data-integrity');
        const cheat = btn.getAttribute('data-cheat');
        
        btn.disabled = true;
        const originalText = btn.innerHTML;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Dispatching...';

        try {
            const response = await fetch('/teacher/sendStudentReport', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    email,
                    testID: '<%= testID %>',
                    mcqScore: score,
                    totalQuestions: testQuestions.length,
                    integrity,
                    cheatScore: cheat,
                    anomalies: anomalies,
                    teacherComment: comment
                })
            });

            const result = await response.json();
            if (result.success) {
                // Showing success toast or design would be better, using simple alert for now as per system
                alert(`✅ Report successfully dispatched to ${email}!`);
            } else {
                alert(`❌ Dispatch Failed: ${result.message}`);
            }
        } catch (error) {
            console.error("Report Sending Error:", error);
            alert("❌ Network Connectivity Error. Please try again.");
        } finally {
            btn.disabled = false;
            btn.innerHTML = originalText;
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('.view-answers-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const email = this.getAttribute('data-email');
                const answers = JSON.parse(decodeURIComponent(this.getAttribute('data-answers')));
                showAnswerModal(email, answers);
            });
        });

        document.querySelectorAll('.send-report-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                showReportPreview(this);
            });
        });
        
        // Focus effect for custom textarea
        const ta = document.getElementById('modalTeacherComment');
        if(ta) {
            ta.addEventListener('focus', function() {
                this.style.borderColor = '#1e293b';
                this.style.boxShadow = '0 0 0 3px rgba(30, 41, 59, 0.1)';
            });
            ta.addEventListener('blur', function() {
                this.style.borderColor = '#e2e8f0';
                this.style.boxShadow = 'none';
            });
        }
    });
</script>

